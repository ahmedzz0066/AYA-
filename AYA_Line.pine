//@version=6
// =============================================================================
// AYA LINE — #MoModel INSTITUTIONAL ENGINE
// =============================================================================
// "Statistical Expansion + Institutional Participation
//  + Auction Acceptance + Liquidity Targeting"
//
// Foundation: BigBeluga Volumatic z-score (MPL-2.0, © BigBeluga)
// Architecture: #MoModel (© AYA)
//
// MATHEMATICAL PIPELINE
//   Step 1 — Statistical Expansion   zDiff × zVol  (BigBeluga z-score only)
//   Step 2 — Structure Shift (BOS)   close > prior swing H (bull) / L (bear)
//   Step 3 — Acceptance Test         price holds above/below origin ≤ N bars
//   Step 4 — Momentum Quality Score  expansion rank + volume rank + range rank
//   Step 5 — Liquidity Targets       BSL/SSL equal H/L · PDH/PDL · FVG voids
//   Step 6 — Invalidation            close back through origin (full-body gate)
//
// WHAT THIS IS NOT
//   ✗ EMA crossovers    ✗ RSI   ✗ ATR bands   ✗ Fibonacci
//   ✗ Random S/R lines  ✗ Lagging oscillators
//
// WHAT THE EDGE IS
//   Where inventory was acquired (Bus Origin)
//   Whether the auction accepted that price (Acceptance)
//   Where liquidity likely exists next (BSL/SSL/FVG/PDH/PDL)
// =============================================================================

indicator("AYA Line — #MoModel Engine", shorttitle="AYA #MoModel",
     overlay=true, max_lines_count=500, max_boxes_count=500, max_labels_count=500)

// ─────────────────────────────────────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────────────────────────────────────
gZ     = "1 ▸ Statistical Expansion  (BigBeluga z-score)"
gBOS   = "2 ▸ Structure Shift  — Gate 1"
gAcc   = "3 ▸ Acceptance       — Gate 2"
gQ     = "4 ▸ Momentum Quality"
gTgt   = "5 ▸ Liquidity Targets"
gInv   = "6 ▸ Invalidation"
gStyle = "7 ▸ Style"
gDash  = "8 ▸ Dashboard"

// — z-score (BigBeluga parameters) —
zLen   = input.int  (200,   "Z-score window",              minval=50,          group=gZ)
zLevel = input.float(2.4,   "Expansion threshold |z|",     step=0.1,           group=gZ)
zMax   = input.int  (10,    "Max stored Bus Origins",       maxval=20,          group=gZ)

// — Structure —
pivLen = input.int  (5,     "Swing pivot length",           minval=2,           group=gBOS)

// — Acceptance —
accWin = input.int  (5,     "Acceptance window (bars)",     minval=1,           group=gAcc)

// — Quality —
qualMin = input.int (40,    "Min quality to store origin",
     minval=0, maxval=100,                                                      group=gQ)

// — Liquidity targets —
eqTolPct = input.float(0.10,"Equal H/L tolerance (%)",     step=0.01,          group=gTgt)
showEQ   = input.bool (true, "Show BSL / SSL (equal H/L)",                     group=gTgt)
showFVG  = input.bool (true, "Show Fair Value Gaps",                            group=gTgt)
showPD   = input.bool (true, "Show Prior Day H/L",                              group=gTgt)
fvgMax   = input.int  (3,   "Max FVG zones",                maxval=8,           group=gTgt)

// — Invalidation —
invBody = input.float(0.5,  "Full-body min ratio",
     minval=0.3, maxval=0.95, step=0.05,                                        group=gInv)

// — Style —
colBull  = input.color(color.new(#00e677, 0),  "Bull expansion",  group=gStyle)
colBear  = input.color(color.new(#f18a45, 0),  "Bear expansion",  group=gStyle)
colMOL   = input.color(color.new(#008cff, 0),  "MOLiNE",          group=gStyle)
colBSL   = input.color(color.new(#38bdf8, 0),  "BSL",             group=gStyle)
colSSL   = input.color(color.new(#fb7185, 0),  "SSL",             group=gStyle)
colFVG   = input.color(color.new(#a78bfa, 80), "FVG",             group=gStyle)
colPDH   = input.color(color.new(#fbbf24, 0),  "PDH",             group=gStyle)
colPDL   = input.color(color.new(#fbbf24, 0),  "PDL",             group=gStyle)
colInv   = input.color(color.new(#f43f5e, 0),  "Invalidation",    group=gStyle)
colNeu   = input.color(color.new(color.gray,0), "Neutral",         group=gStyle)

// — Dashboard —
showDash = input.bool  (true,        "Show dashboard",              group=gDash)
dashPos  = input.string("top_right", "Position",
     options=["top_right","top_left","bottom_right","bottom_left"],  group=gDash)

// ─────────────────────────────────────────────────────────────────────────────
// STEP 1 — STATISTICAL EXPANSION  (BigBeluga Volumatic z-score, ported to v6)
// ─────────────────────────────────────────────────────────────────────────────
// Direct port of BigBeluga's norm() method:
//   z = (src − SMA(src, window)) / STDEV(src, window)
zNorm(float src) =>
    m = ta.sma(src, zLen)
    s = ta.stdev(src, zLen)
    s > 0 ? (src - m) / s : 0.0

diffPx    = close - open
volSigned = close > open ? volume : -volume

zDiff = zNorm(diffPx)
zVol  = zNorm(volSigned)

// Adaptive line width — BigBeluga's original ATR-scaled visual parameter
lineW = math.max(1, int(math.round(math.abs(zVol) * (ta.atr(200) * 0.1))))

bullExpand = zDiff >  zLevel and zVol >  zLevel
bearExpand = zDiff < -zLevel and zVol < -zLevel

// ─────────────────────────────────────────────────────────────────────────────
// STEP 2 — STRUCTURE SHIFT  (BOS)
// Bullish BOS: close crosses above most recent pivot high
// Bearish BOS: close crosses below most recent pivot low
// ─────────────────────────────────────────────────────────────────────────────
phigh = ta.pivothigh(high, pivLen, pivLen)
plow  = ta.pivotlow (low,  pivLen, pivLen)

var float lastPH = na
var float lastPL = na
if not na(phigh)
    lastPH := phigh
if not na(plow)
    lastPL := plow

bosUp = not na(lastPH) and ta.crossover (close, lastPH)
bosDn = not na(lastPL) and ta.crossunder(close, lastPL)

// ─────────────────────────────────────────────────────────────────────────────
// STEP 3 + 4 — ORIGIN STATE MACHINE  +  QUALITY SCORE
// ─────────────────────────────────────────────────────────────────────────────
// States
//   0  = IDLE          (no active candidate)
//   1  = EXPANSION     (waiting for BOS)
//   2  = BOS CONFIRMED (waiting for acceptance)
//   3  = VALID         (all gates passed, MOLiNE active)
//  -1  = INVALIDATED   (close back through origin on full body)
// ─────────────────────────────────────────────────────────────────────────────
var int   originState = 0
var float originPx    = na      // Bus Origin level (midpoint of expansion bar)
var int   originDir   = 0       //  1 = bull, -1 = bear
var int   originBarN  = 0       // bar_index when expansion fired
var float originHi    = na
var float originLo    = na
var float originVol   = 0.0     // volume of the expansion bar
var float originQual  = 0.0     // quality score (computed at expansion)

// Quality score — rank the expansion bar (0–100)
f_quality() =>
    vr = ta.sma(volume, 200) > 0 ? volume / ta.sma(volume, 200) : 1.0
    rr = ta.atr(200) > 0 ? (high - low) / ta.atr(200) : 1.0
    q1 = math.abs(zDiff) >= zLevel * 1.5 ? 25 : 15
    q2 = math.abs(zVol)  >= zLevel * 1.5 ? 25 : 15
    q3 = (vr >= 3.0 ? 25 : vr >= 2.0 ? 15 : vr >= 1.5 ? 10 : 5)
    q4 = (rr >= 2.5 ? 25 : rr >= 1.5 ? 15 : rr >= 1.2 ? 10 : 5)
    float(math.min(100, q1 + q2 + q3 + q4))

// Validated origin storage (permanent — drawn until shifted off by zMax)
var array<float> molPx    = array.new<float>(0)
var array<int>   molDir   = array.new<int>(0)
var array<float> molQual  = array.new<float>(0)
var array<bool>  molInv   = array.new<bool>(0)
var array<int>   molBarN  = array.new<int>(0)
var array<float> molVol   = array.new<float>(0)

f_pushOrigin() =>
    array.push(molPx,   originPx)
    array.push(molDir,  originDir)
    array.push(molQual, originQual)
    array.push(molInv,  false)
    array.push(molBarN, originBarN)
    array.push(molVol,  originVol)
    if array.size(molPx) > zMax
        array.shift(molPx)
        array.shift(molDir)
        array.shift(molQual)
        array.shift(molInv)
        array.shift(molBarN)
        array.shift(molVol)

// ── State transitions ──────────────────────────────────────────────────────
// New expansion always resets the active candidate (keeps stored origins)
if bullExpand or bearExpand
    originState := 1
    originPx    := (open + close) / 2.0
    originDir   := bullExpand ? 1 : -1
    originBarN  := bar_index
    originHi    := high
    originLo    := low
    originVol   := volume
    originQual  := f_quality()

// Gate 1: Structure Shift
if originState == 1
    if (originDir == 1 and bosUp) or (originDir == -1 and bosDn)
        originState := 2

// Gate 2: Acceptance
if originState == 2
    elapsed = bar_index - originBarN
    if elapsed <= accWin
        accepted = (originDir == 1 and close > originPx) or
                   (originDir == -1 and close < originPx)
        if accepted
            originState := 3
            if originQual >= qualMin
                f_pushOrigin()
    else if elapsed > accWin
        originState := 0   // window expired without acceptance

// ─────────────────────────────────────────────────────────────────────────────
// STEP 6 — INVALIDATION  (close back through origin on a full-body bar)
// ─────────────────────────────────────────────────────────────────────────────
hBody    = math.abs(close - open)
hRange   = high - low
fullBody = hRange > 0 and (hBody / hRange) >= invBody

// Invalidate active origin
if originState == 3 and fullBody
    if (originDir == 1 and close < originPx) or
       (originDir == -1 and close > originPx)
        originState := -1

// Invalidate stored origins
if fullBody and array.size(molPx) > 0
    for i = 0 to array.size(molPx) - 1
        if not array.get(molInv, i)
            px = array.get(molPx,  i)
            dr = array.get(molDir, i)
            if (dr == 1 and close < px) or (dr == -1 and close > px)
                array.set(molInv, i, true)

// ─────────────────────────────────────────────────────────────────────────────
// STEP 5 — LIQUIDITY TARGETS
// ─────────────────────────────────────────────────────────────────────────────

// ── BSL / SSL (Equal Highs / Equal Lows) ──────────────────────────────────
eqTolPx = close * eqTolPct / 100.0

var array<float> swingHs = array.new<float>(0)
var array<float> swingLs = array.new<float>(0)

if not na(phigh)
    array.push(swingHs, phigh)
    if array.size(swingHs) > 30
        array.shift(swingHs)
if not na(plow)
    array.push(swingLs, plow)
    if array.size(swingLs) > 30
        array.shift(swingLs)

float bslLevel = na
float sslLevel = na

// Scan newest-first for closest equal-high pair
if array.size(swingHs) >= 2
    for i = array.size(swingHs) - 1 to 1 by -1
        h1 = array.get(swingHs, i)
        h2 = array.get(swingHs, i - 1)
        if math.abs(h1 - h2) <= eqTolPx
            bslLevel := (h1 + h2) / 2.0
            break

if array.size(swingLs) >= 2
    for i = array.size(swingLs) - 1 to 1 by -1
        l1 = array.get(swingLs, i)
        l2 = array.get(swingLs, i - 1)
        if math.abs(l1 - l2) <= eqTolPx
            sslLevel := (l1 + l2) / 2.0
            break

// ── Prior Day H/L ──────────────────────────────────────────────────────────
[pdH, pdL] = request.security(syminfo.tickerid, "D",
     [high[1], low[1]], lookahead=barmerge.lookahead_off)

// ── Fair Value Gaps ─────────────────────────────────────────────────────────
// Bull FVG: high[2] < low  → gap between high[2] and current low
// Bear FVG: low[2]  > high → gap between current high and low[2]
bullFVG = high[2] < low
bearFVG = low[2]  > high

var array<float> fvgTop = array.new<float>(0)
var array<float> fvgBot = array.new<float>(0)
var array<int>   fvgDir = array.new<int>(0)

if bullFVG
    array.push(fvgTop, low)
    array.push(fvgBot, high[2])
    array.push(fvgDir, 1)
    if array.size(fvgTop) > fvgMax
        array.shift(fvgTop)
        array.shift(fvgBot)
        array.shift(fvgDir)
if bearFVG
    array.push(fvgTop, low[2])
    array.push(fvgBot, high)
    array.push(fvgDir, -1)
    if array.size(fvgTop) > fvgMax
        array.shift(fvgTop)
        array.shift(fvgBot)
        array.shift(fvgDir)

// ─────────────────────────────────────────────────────────────────────────────
// DRAWING LAYER
// Rebuild all objects on barstate.islast to reflect current state.
// ─────────────────────────────────────────────────────────────────────────────
var array<line>  molLines  = array.new<line>(0)
var array<box>   molBoxes  = array.new<box>(0)
var array<label> allLabels = array.new<label>(0)
var array<box>   fvgBoxes  = array.new<box>(0)
var line lnPDH  = na
var line lnPDL  = na
var line lnBSL  = na
var line lnSSL  = na

f_delLine(line l) =>
    if not na(l)
        line.delete(l)
f_clearLA(array<line> a) =>
    while array.size(a) > 0
        line.delete(array.shift(a))
f_clearBA(array<box> a) =>
    while array.size(a) > 0
        box.delete(array.shift(a))
f_clearLbA(array<label> a) =>
    while array.size(a) > 0
        label.delete(array.shift(a))

if barstate.islast
    // ── clear previous pass ────────────────────────────────────────────────
    f_clearLA(molLines)
    f_clearBA(molBoxes)
    f_clearLbA(allLabels)
    f_clearBA(fvgBoxes)
    f_delLine(lnPDH)
    f_delLine(lnPDL)
    f_delLine(lnBSL)
    f_delLine(lnSSL)

    n     = bar_index + 30
    lftX  = bar_index - math.min(bar_index, 300)

    // ── MOLiNE levels ───────────────────────────────────────────────────────
    if array.size(molPx) > 0
        for i = 0 to array.size(molPx) - 1
            px    = array.get(molPx,   i)
            dr    = array.get(molDir,  i)
            ql    = array.get(molQual, i)
            inv   = array.get(molInv,  i)
            bN    = array.get(molBarN, i)
            vol_  = array.get(molVol,  i)

            lineCol = (inv        ? color.new(colInv, 60) :
                      dr == 1    ? (close >= px ? colBull : color.new(colBull, 60)) :
                      (close <= px ? colBear : color.new(colBear, 60)))
            lStyle  = inv ? line.style_dotted : line.style_solid

            molLines.push(line.new(bN, px, n, px,
                 color=lineCol, width=inv ? 1 : 2,
                 style=lStyle, extend=extend.right))

            // Volume box at origin candle (BigBeluga visual)
            molBoxes.push(box.new(bN, px + lineW, bN + 8, px - lineW,
                 border_color=color.new(colNeu, 80), border_width=1,
                 bgcolor=color.new(colNeu, 90),
                 text=str.tostring(vol_, format.volume),
                 text_size=size.small, text_color=lineCol,
                 text_halign=text.align_right, text_valign=text.align_center))

            // Quality badge
            allLabels.push(label.new(n, px,
                 (inv ? "✗ " : "✓ ") + str.tostring(int(ql)) + "  MOL",
                 style=label.style_label_left,
                 color=color.new(lineCol, 45),
                 textcolor=color.white, size=size.small))

    // ── BSL / SSL ───────────────────────────────────────────────────────────
    if showEQ
        if not na(bslLevel)
            lnBSL := line.new(lftX, bslLevel, n, bslLevel,
                 color=colBSL, style=line.style_dotted, width=2,
                 extend=extend.right)
            allLabels.push(label.new(n, bslLevel, "BSL",
                 style=label.style_label_left,
                 color=color.new(colBSL, 65), textcolor=color.white,
                 size=size.tiny))
        if not na(sslLevel)
            lnSSL := line.new(lftX, sslLevel, n, sslLevel,
                 color=colSSL, style=line.style_dotted, width=2,
                 extend=extend.right)
            allLabels.push(label.new(n, sslLevel, "SSL",
                 style=label.style_label_left,
                 color=color.new(colSSL, 65), textcolor=color.white,
                 size=size.tiny))

    // ── Prior Day H/L ───────────────────────────────────────────────────────
    if showPD
        if not na(pdH)
            lnPDH := line.new(lftX, pdH, n, pdH,
                 color=colPDH, style=line.style_dashed, extend=extend.right)
            allLabels.push(label.new(n, pdH, "PDH",
                 style=label.style_label_left,
                 color=color.new(colPDH, 65), textcolor=color.white,
                 size=size.tiny))
        if not na(pdL)
            lnPDL := line.new(lftX, pdL, n, pdL,
                 color=colPDL, style=line.style_dashed, extend=extend.right)
            allLabels.push(label.new(n, pdL, "PDL",
                 style=label.style_label_left,
                 color=color.new(colPDL, 65), textcolor=color.white,
                 size=size.tiny))

    // ── FVG boxes ───────────────────────────────────────────────────────────
    if showFVG and array.size(fvgTop) > 0
        for i = 0 to array.size(fvgTop) - 1
            t   = array.get(fvgTop, i)
            b   = array.get(fvgBot, i)
            fvgBoxes.push(box.new(lftX, t, n, b,
                 border_color=color.new(colFVG, 40), bgcolor=colFVG))

// ─────────────────────────────────────────────────────────────────────────────
// BAR MARKERS
// ─────────────────────────────────────────────────────────────────────────────
// BigBeluga: color expansion bars
barcolor((bullExpand ? colBull : bearExpand ? colBear : na), title="Expansion bar")

// BOS markers (every structural break)
plotshape(bosUp, title="BOS Up",
     style=shape.triangleup, location=location.belowbar,
     color=colBull, size=size.small)
plotshape(bosDn, title="BOS Down",
     style=shape.triangledown, location=location.abovebar,
     color=colBear, size=size.small)

// Origin validated
originJustValid = originState == 3 and originState[1] != 3
plotshape(originJustValid and originDir ==  1, title="Origin Accepted Bull",
     style=shape.flag, location=location.belowbar,
     color=colBull, size=size.small)
plotshape(originJustValid and originDir == -1, title="Origin Accepted Bear",
     style=shape.flag, location=location.abovebar,
     color=colBear, size=size.small)

// Invalidation flash
originJustInv = originState == -1 and originState[1] != -1
bgcolor(originJustInv ? color.new(colInv, 75) : na, title="Invalidation flash")

// ─────────────────────────────────────────────────────────────────────────────
// DASHBOARD
// ─────────────────────────────────────────────────────────────────────────────
posMap_(s) =>
    (s == "top_left"     ? position.top_left :
    s == "bottom_right" ? position.bottom_right :
    s == "bottom_left"  ? position.bottom_left : position.top_right)

var table dash = table.new(posMap_(dashPos), 2, 10,
     border_width=1, frame_color=color.new(color.gray, 50),
     border_color=color.new(color.gray, 70))

stateTxt = (originState ==  3 ? "VALID — " + (originDir == 1 ? "BULL ▲" : "BEAR ▼") :
           originState ==  2 ? "AWAITING ACCEPTANCE" :
           originState ==  1 ? "AWAITING BOS" :
           originState == -1 ? "INVALIDATED" : "IDLE — NO ORIGIN")
stateBg  = (originState ==  3 ? color.new(originDir == 1 ? colBull : colBear, 55) :
           originState ==  2 ? color.new(color.orange, 50) :
           originState ==  1 ? color.new(color.yellow, 65) :
           originState == -1 ? color.new(colInv, 55) :
                                color.new(color.gray, 65))

qualTxt = (originQual >= 75 ? "HIGH  " :
          originQual >= 50  ? "MED   " :
          originQual >= qualMin ? "LOW   " : "SKIP  ") +
          "(" + str.tostring(int(originQual)) + " / 100)"
qualBg  = (originQual >= 75 ? color.new(colBull, 60) :
          originQual >= 50  ? color.new(color.orange, 55) :
                               color.new(colBear, 65))

dntTxt = (originState == -1 ? "origin invalidated — stand down" :
         originState ==  0  ? "no expansion fired — idle" :
         originState ==  1  ? "waiting structure shift — no trade" :
         originState ==  2  ? "waiting acceptance confirmation" :
         originQual < qualMin ? "quality below threshold — skip" : "—")

f_cell_(int r, int c, string txt, color bg, color tc) =>
    table.cell(dash, c, r, txt, bgcolor=bg, text_color=tc, text_size=size.small)

if showDash and barstate.islast
    table.clear(dash, 0, 0, 1, 9)

    f_cell_(0, 0, "ORIGIN STATE",   color.new(color.black, 30), color.white)
    f_cell_(0, 1, stateTxt,         stateBg,                    color.white)

    f_cell_(1, 0, "BUS ORIGIN",     color.new(color.black, 30), color.white)
    f_cell_(1, 1, (na(originPx) ? "—" : str.tostring(originPx, format.mintick)),
         color.new(colMOL, 55), color.white)

    f_cell_(2, 0, "QUALITY SCORE",  color.new(color.black, 30), color.white)
    f_cell_(2, 1, qualTxt, qualBg,  color.white)

    f_cell_(3, 0, "zDiff / zVol",   color.new(color.black, 30), color.white)
    f_cell_(3, 1, str.tostring(zDiff, "#.##") + "  /  " + str.tostring(zVol, "#.##"),
         color.new(color.gray, 55), color.white)

    f_cell_(4, 0, "BSL / SSL",      color.new(color.black, 30), color.white)
    f_cell_(4, 1, (na(bslLevel) ? "—" : str.tostring(bslLevel, format.mintick)) +
                  "  /  " + (na(sslLevel) ? "—" : str.tostring(sslLevel, format.mintick)),
         color.new(color.gray, 55), color.white)

    f_cell_(5, 0, "PRIOR DAY H/L",  color.new(color.black, 30), color.white)
    f_cell_(5, 1, (na(pdH) ? "—" : str.tostring(pdH, format.mintick)) +
                  "  /  " + (na(pdL) ? "—" : str.tostring(pdL, format.mintick)),
         color.new(color.gray, 55), color.white)

    f_cell_(6, 0, "FVG ZONES",      color.new(color.black, 30), color.white)
    f_cell_(6, 1, str.tostring(array.size(fvgTop)) + " active",
         color.new(colFVG, 55), color.white)

    f_cell_(7, 0, "ORIGINS STORED", color.new(color.black, 30), color.white)
    f_cell_(7, 1, str.tostring(array.size(molPx)) + " / " + str.tostring(zMax),
         color.new(colMOL, 55), color.white)

    f_cell_(8, 0, "DO-NOT-TRADE",   color.new(color.black, 30), color.white)
    f_cell_(8, 1, dntTxt,
         dntTxt == "—" ? color.new(colBull, 65) : color.new(color.orange, 50),
         color.white)

    f_cell_(9, 0, "FRAMEWORK",      color.new(color.black, 30), color.white)
    f_cell_(9, 1, "z-score + BOS + Acceptance + Liquidity",
         color.new(color.black, 55), color.silver)

// ─────────────────────────────────────────────────────────────────────────────
// ALERTS
// ─────────────────────────────────────────────────────────────────────────────
alertcondition(bullExpand or bearExpand,
     title="MoModel: Statistical Expansion",
     message="Abnormal z-score event — potential Bus Origin forming.")
alertcondition(bosUp, title="MoModel: BOS Up",
     message="Bullish break of structure confirmed.")
alertcondition(bosDn, title="MoModel: BOS Down",
     message="Bearish break of structure confirmed.")
alertcondition(originJustValid,
     title="MoModel: Origin VALID ✓",
     message="Bus Origin accepted. MOLiNE active. Evaluate trade quality.")
alertcondition(originJustInv,
     title="MoModel: Origin INVALIDATED ✗",
     message="Close back through origin on full body. Thesis dead. Stand down.")
alertcondition(bullFVG or bearFVG,
     title="MoModel: FVG Created",
     message="Fair Value Gap detected — liquidity void mapped.")
alertcondition(not na(bslLevel) and ta.crossover(close, bslLevel),
     title="MoModel: BSL Swept",
     message="Price has swept buy-side liquidity (equal highs). Watch for reaction.")
alertcondition(not na(sslLevel) and ta.crossunder(close, sslLevel),
     title="MoModel: SSL Swept",
     message="Price has swept sell-side liquidity (equal lows). Watch for reaction.")
