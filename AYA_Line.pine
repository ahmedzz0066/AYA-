//@version=6
// =============================================================================
// AYA LINE — Institutional Intraday Decision-Support Indicator
// -----------------------------------------------------------------------------
// "Less is better. Precision over frequency. Protect capital first."
//
// Implements the full AYA Line framework documented in ROADMAP.md:
//   1. Daily directional bias (AYA Arrow)        — 1H + Daily pivot + EMAs
//   2. Core AYA Line                              — pivot / aVWAP / mid / manual
//   3. Invalidation level                         — 1H FULL-BODY close only
//   4. Model targets TP1 / TP2 / TP3 / Extended   — R-multiples + ATR(D)
//   5. Pullback / OTE entry zone                  — 50–79% premium / discount
//   6. Liquidity pools + sweep detector           — equal H/L + sweep reclaim
//   7. MSS / BOS + reclaim engine                 — gates reversal trades
//   8. Market state classifier                    — trending / rotational / weak
//   9. Risk-reward geometry box (≥1:4 enforced)
//  10. Dashboard table mirroring the system prompt schema
// =============================================================================

indicator("AYA Line — Institutional Intraday Model", shorttitle="AYA Line",
     overlay=true,
     max_lines_count=500, max_boxes_count=500, max_labels_count=500)

// ─────────────────────────────────────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────────────────────────────────────
gBias  = "1 ▸ Bias Engine"
gLine  = "2 ▸ Core AYA Line"
gInv   = "3 ▸ Invalidation"
gTgt   = "4 ▸ Model Targets"
gPb    = "5 ▸ Pullback / OTE"
gLiq   = "6 ▸ Liquidity & Structure"
gState = "7 ▸ Market State"
gStyle = "8 ▸ Style"
gDash  = "9 ▸ Dashboard"

// Bias
emaFastLen = input.int(20, "1H EMA fast", minval=2,                group=gBias)
emaSlowLen = input.int(50, "1H EMA slow", minval=3,                group=gBias)

// AYA Line
ayaMode    = input.string("Daily Pivot",  "AYA Line source",
     options=["Daily Pivot","Anchored VWAP (session)","Prior Day Mid","Manual"],
     group=gLine)
ayaManual  = input.price(0.0, "Manual AYA Line price",             group=gLine,
     confirm=false)

// Invalidation
invLookback = input.int(12, "1H lookback for invalidation swing",
     minval=3, maxval=72,                                          group=gInv)
bodyPct     = input.float(0.6, "Full-body min ratio (body/range)",
     minval=0.3, maxval=0.95, step=0.05,                           group=gInv)

// Targets
rrTP1   = input.float(1.0, "TP1 (× R)",      minval=0.25, step=0.25, group=gTgt)
rrTP2   = input.float(2.0, "TP2 (× R)",      minval=0.5,  step=0.25, group=gTgt)
rrTP3   = input.float(4.0, "TP3 (× R) min1:4",minval=1.0, step=0.25, group=gTgt)
rrExt   = input.float(6.0, "Extended (× R)", minval=2.0,  step=0.5,  group=gTgt)
useATRd = input.bool(true, "Cap Extended at max(R×mult, 1×ATR-D)",
     group=gTgt)

// Pullback
pivLen     = input.int(5, "Swing pivot length (15m)", minval=2,    group=gPb)
fibStart   = input.float(0.50, "Discount/Premium start", step=0.01, group=gPb)
fibEnd     = input.float(0.79, "Discount/Premium end",   step=0.01, group=gPb)
fibSweet   = input.float(0.705, "OTE sweet-spot",        step=0.005,group=gPb)

// Liquidity / structure
liqLen     = input.int(20, "Pivot length for liquidity pools", minval=3, group=gLiq)
sweepTolPx = input.float(0.05, "Equal H/L tolerance (% of ATR)",
     minval=0.0, maxval=1.0, step=0.05,                            group=gLiq)
mssLen     = input.int(5, "MSS swing length (chart TF)", minval=2, group=gLiq)

// State
atrFast = input.int(14, "ATR fast",                                group=gState)
atrSlow = input.int(50, "ATR slow",                                group=gState)
trendK  = input.float(1.2, "Trend ATR ratio threshold",            group=gState)
weakK   = input.float(0.8, "Weak ATR ratio threshold",             group=gState)

// Style
colBull   = input.color(color.new(#22c55e, 0),  "Bull color",      group=gStyle)
colBear   = input.color(color.new(#ef4444, 0),  "Bear color",      group=gStyle)
colNeut   = input.color(color.new(#9ca3af, 0),  "Neutral color",   group=gStyle)
colAya    = input.color(color.new(#fbbf24, 0),  "AYA Line color",  group=gStyle)
colInv    = input.color(color.new(#f43f5e, 0),  "Invalidation",    group=gStyle)
colTP     = input.color(color.new(#38bdf8, 0),  "Targets",         group=gStyle)
colZone   = input.color(color.new(#a78bfa, 80), "Pullback zone",   group=gStyle)
colRisk   = input.color(color.new(#ef4444, 80), "Risk box",        group=gStyle)
colReward = input.color(color.new(#22c55e, 80), "Reward box",      group=gStyle)

// Dashboard
showDash  = input.bool(true,  "Show dashboard",                    group=gDash)
dashPos   = input.string("top_right", "Dashboard position",
     options=["top_right","top_left","bottom_right","bottom_left","middle_right"],
     group=gDash)

// ─────────────────────────────────────────────────────────────────────────────
// HTF DATA
// ─────────────────────────────────────────────────────────────────────────────
// Daily — prior day OHLC + ATR
[pdH, pdL, pdC, pdO, atrD] = request.security(syminfo.tickerid, "D",
     [high[1], low[1], close[1], open[1], ta.atr(14)],
     lookahead=barmerge.lookahead_off)

dailyPivot = (pdH + pdL + pdC) / 3.0
priorMid   = (pdH + pdL) / 2.0

// 1H — close, EMAs, swings, body geometry
[h1Close, h1Open, h1High, h1Low,
 emaFast1H, emaSlow1H,
 swingHi1H, swingLo1H] = request.security(syminfo.tickerid, "60",
     [close, open, high, low,
      ta.ema(close, emaFastLen), ta.ema(close, emaSlowLen),
      ta.highest(high, invLookback), ta.lowest(low, invLookback)],
     lookahead=barmerge.lookahead_off)

// 15m — used for impulse leg detection
[h15Close, h15High, h15Low] = request.security(syminfo.tickerid, "15",
     [close, high, low], lookahead=barmerge.lookahead_off)

// ─────────────────────────────────────────────────────────────────────────────
// 1. BIAS ENGINE  (AYA Arrow)
// ─────────────────────────────────────────────────────────────────────────────
emaUp   = emaFast1H > emaSlow1H
emaDn   = emaFast1H < emaSlow1H
abovePv = h1Close > dailyPivot
belowPv = h1Close < dailyPivot
reclaimUp = h1Close > pdH
reclaimDn = h1Close < pdL

// confidence scoring (0..100)
confBull = (abovePv ? 35 : 0) + (emaUp ? 30 : 0) + (reclaimUp ? 25 : 0) +
           (h1Close > h1Open ? 10 : 0)
confBear = (belowPv ? 35 : 0) + (emaDn ? 30 : 0) + (reclaimDn ? 25 : 0) +
           (h1Close < h1Open ? 10 : 0)

var int   biasState = 0       //  1 bull, -1 bear, 0 neutral
var int   confScore = 0
var bool  invalidated = false

rawBias = abovePv and emaUp ? 1 : belowPv and emaDn ? -1 : 0
rawConf = rawBias ==  1 ? confBull :
          rawBias == -1 ? confBear : 0

// recompute on a new 1H bar
new1H = ta.change(time("60")) != 0
if new1H
    biasState := rawBias
    confScore := rawConf
    invalidated := false

// ─────────────────────────────────────────────────────────────────────────────
// 2. CORE AYA LINE
// ─────────────────────────────────────────────────────────────────────────────
// Anchored VWAP from session start
var float aVwapNum = 0.0
var float aVwapDen = 0.0
isNewSession = ta.change(time("D")) != 0
if isNewSession
    aVwapNum := 0.0
    aVwapDen := 0.0
typPrice = (high + low + close) / 3.0
volProxy = nz(volume, 1.0)
aVwapNum += typPrice * volProxy
aVwapDen += volProxy
aVwap = aVwapDen > 0 ? aVwapNum / aVwapDen : close

ayaLine = ayaMode == "Daily Pivot"            ? dailyPivot :
          ayaMode == "Anchored VWAP (session)" ? aVwap :
          ayaMode == "Prior Day Mid"           ? priorMid :
          ayaManual > 0                        ? ayaManual : dailyPivot

// ─────────────────────────────────────────────────────────────────────────────
// 3. INVALIDATION  (1H full-body close only)
// ─────────────────────────────────────────────────────────────────────────────
invLevel = biasState ==  1 ? swingLo1H :
           biasState == -1 ? swingHi1H : na

h1Range = h1High - h1Low
h1Body  = math.abs(h1Close - h1Open)
fullBody = h1Range > 0 and (h1Body / h1Range) >= bodyPct

invFires = false
if new1H and not na(invLevel) and fullBody
    if biasState ==  1 and h1Close < invLevel
        invFires := true
    if biasState == -1 and h1Close > invLevel
        invFires := true

if invFires
    invalidated := true
    biasState   := 0
    confScore   := 0

// ─────────────────────────────────────────────────────────────────────────────
// 4. MODEL TARGETS
// ─────────────────────────────────────────────────────────────────────────────
R = na(invLevel) ? na : math.abs(ayaLine - invLevel)
dir = biasState   //  1 / -1 / 0

tp1 = na(R) or dir == 0 ? na : ayaLine + dir * rrTP1 * R
tp2 = na(R) or dir == 0 ? na : ayaLine + dir * rrTP2 * R
tp3 = na(R) or dir == 0 ? na : ayaLine + dir * rrTP3 * R
extDist = na(R) ? na :
     useATRd ? math.max(rrExt * R, atrD) : rrExt * R
tpExt = na(extDist) or dir == 0 ? na : ayaLine + dir * extDist

// ─────────────────────────────────────────────────────────────────────────────
// 5. PULLBACK / OTE ZONE  (built from last 15m impulse leg)
// ─────────────────────────────────────────────────────────────────────────────
ph15 = ta.pivothigh(h15High, pivLen, pivLen)
pl15 = ta.pivotlow (h15Low , pivLen, pivLen)

var float legHi = na
var float legLo = na
var int   legBar = na
if not na(ph15)
    legHi := ph15
    legBar := bar_index
if not na(pl15)
    legLo := pl15
    legBar := bar_index

zoneTop = na
zoneBot = na
zoneSweet = na
if not na(legHi) and not na(legLo)
    leg = legHi - legLo
    if dir == 1
        zoneTop   := legHi - fibStart * leg     // 50% retrace
        zoneBot   := legHi - fibEnd   * leg     // 79% retrace
        zoneSweet := legHi - fibSweet * leg     // 70.5% OTE
    if dir == -1
        zoneBot   := legLo + fibStart * leg
        zoneTop   := legLo + fibEnd   * leg
        zoneSweet := legLo + fibSweet * leg

// ─────────────────────────────────────────────────────────────────────────────
// 6. LIQUIDITY POOLS + SWEEPS
// ─────────────────────────────────────────────────────────────────────────────
phC = ta.pivothigh(high, liqLen, liqLen)
plC = ta.pivotlow (low , liqLen, liqLen)

atrCur = ta.atr(atrFast)
tol    = atrCur * sweepTolPx

var float lastBSL = na
var float lastSSL = na
if not na(phC)
    lastBSL := phC
if not na(plC)
    lastSSL := plC

sweepBSL = not na(lastBSL) and high > lastBSL + tol and close < lastBSL
sweepSSL = not na(lastSSL) and low  < lastSSL - tol and close > lastSSL

// ─────────────────────────────────────────────────────────────────────────────
// 7. MSS / BOS + RECLAIM
// ─────────────────────────────────────────────────────────────────────────────
phMSS = ta.pivothigh(high, mssLen, mssLen)
plMSS = ta.pivotlow (low , mssLen, mssLen)

var float lastSwingHi = na
var float lastSwingLo = na
if not na(phMSS)
    lastSwingHi := phMSS
if not na(plMSS)
    lastSwingLo := plMSS

mssUp = not na(lastSwingHi) and ta.crossover (close, lastSwingHi)
mssDn = not na(lastSwingLo) and ta.crossunder(close, lastSwingLo)

// reclaim of AYA Line in bias direction
reclaimAyaUp = ta.crossover (close, ayaLine)
reclaimAyaDn = ta.crossunder(close, ayaLine)

// 4-step reversal sequencer (sweep → MSS → reclaim → momentum)
var int  revStep = 0
var int  revDir  = 0
momentumOK = math.abs(close - open) >= bodyPct * (high - low)

if invalidated
    if revStep == 0 and (sweepBSL or sweepSSL)
        revStep := 1
        revDir  := sweepSSL ? 1 : -1
    else if revStep == 1 and ((revDir == 1 and mssUp) or (revDir == -1 and mssDn))
        revStep := 2
    else if revStep == 2 and ((revDir == 1 and reclaimAyaUp) or (revDir == -1 and reclaimAyaDn))
        revStep := 3
    else if revStep == 3 and momentumOK
        revStep := 4
        biasState   := revDir
        confScore   := 60   // reversal confidence baseline
        invalidated := false
        revStep     := 0
        revDir      := 0

// ─────────────────────────────────────────────────────────────────────────────
// 8. MARKET STATE
// ─────────────────────────────────────────────────────────────────────────────
atrFastV = ta.atr(atrFast)
atrSlowV = ta.atr(atrSlow)
atrRatio = atrSlowV > 0 ? atrFastV / atrSlowV : 1.0

inPriorRange = close <= pdH and close >= pdL
mState = atrRatio >= trendK ? "TRENDING" :
         atrRatio <= weakK  ? "WEAK MOMENTUM" :
         inPriorRange       ? "ROTATIONAL" : "MIXED"

// ─────────────────────────────────────────────────────────────────────────────
// 9. DRAWING LAYER
// ─────────────────────────────────────────────────────────────────────────────
biasColor = biasState ==  1 ? colBull :
            biasState == -1 ? colBear : colNeut

// Persistent objects — rebuilt each bar (kept light: a handful of lines/boxes)
var line  lnAya  = na
var line  lnInv  = na
var line  lnTP1  = na
var line  lnTP2  = na
var line  lnTP3  = na
var line  lnExt  = na
var box   bxZone = na
var line  lnSweet= na
var box   bxRisk = na
var box   bxRew  = na

f_killLine(l) =>
    if not na(l)
        line.delete(l)
f_killBox(b) =>
    if not na(b)
        box.delete(b)

if barstate.islast
    f_killLine(lnAya)
    f_killLine(lnInv)
    f_killLine(lnTP1)
    f_killLine(lnTP2)
    f_killLine(lnTP3)
    f_killLine(lnExt)
    f_killLine(lnSweet)
    f_killBox(bxZone)
    f_killBox(bxRisk)
    f_killBox(bxRew)

    rightX = bar_index + 30
    leftX  = bar_index - 250

    // AYA Line
    lnAya := line.new(leftX, ayaLine, rightX, ayaLine, color=colAya, width=3,
         extend=extend.right)
    label.new(rightX, ayaLine, "AYA " + str.tostring(ayaLine, format.mintick),
         style=label.style_label_left, color=color.new(colAya, 70),
         textcolor=color.white, size=size.small)

    // Invalidation
    if not na(invLevel) and dir != 0
        lnInv := line.new(leftX, invLevel, rightX, invLevel,
             color=colInv, width=2, style=line.style_dashed,
             extend=extend.right)
        label.new(rightX, invLevel,
             "INV " + str.tostring(invLevel, format.mintick),
             style=label.style_label_left, color=color.new(colInv, 70),
             textcolor=color.white, size=size.small)

    // Targets
    if not na(tp1)
        lnTP1 := line.new(leftX, tp1, rightX, tp1, color=colTP, width=1,
             extend=extend.right)
        label.new(rightX, tp1, "TP1", style=label.style_label_left,
             color=color.new(colTP, 60), textcolor=color.white, size=size.tiny)
    if not na(tp2)
        lnTP2 := line.new(leftX, tp2, rightX, tp2, color=colTP, width=1,
             extend=extend.right)
        label.new(rightX, tp2, "TP2", style=label.style_label_left,
             color=color.new(colTP, 60), textcolor=color.white, size=size.tiny)
    if not na(tp3)
        lnTP3 := line.new(leftX, tp3, rightX, tp3, color=colTP, width=2,
             extend=extend.right)
        label.new(rightX, tp3, "TP3 (1:4)",
             style=label.style_label_left, color=color.new(colTP, 40),
             textcolor=color.white, size=size.small)
    if not na(tpExt)
        lnExt := line.new(leftX, tpExt, rightX, tpExt, color=colTP,
             style=line.style_dotted, width=1, extend=extend.right)
        label.new(rightX, tpExt, "EXT", style=label.style_label_left,
             color=color.new(colTP, 60), textcolor=color.white, size=size.tiny)

    // Pullback zone
    if not na(zoneTop) and not na(zoneBot) and dir != 0
        bxZone := box.new(bar_index - 30, zoneTop, rightX, zoneBot,
             border_color=color.new(colZone, 40), bgcolor=colZone)
        if not na(zoneSweet)
            lnSweet := line.new(bar_index - 30, zoneSweet, rightX, zoneSweet,
                 color=color.new(colZone, 0), style=line.style_dotted,
                 extend=extend.right)
            label.new(rightX, zoneSweet, "OTE 70.5%",
                 style=label.style_label_left,
                 color=color.new(colZone, 30), textcolor=color.white,
                 size=size.tiny)

    // Risk / Reward boxes (entry assumed = sweet-spot)
    if not na(zoneSweet) and not na(invLevel) and not na(tp3) and dir != 0
        rDist = math.abs(zoneSweet - invLevel)
        wDist = math.abs(tp3 - zoneSweet)
        rrOK  = wDist >= 4.0 * rDist
        bxRisk := box.new(bar_index, zoneSweet, rightX, invLevel,
             border_color=color.new(colInv, 40), bgcolor=colRisk)
        bxRew  := box.new(bar_index, zoneSweet, rightX, tp3,
             border_color=color.new(colTP, 40),
             bgcolor=rrOK ? colReward : color.new(color.orange, 80))
        label.new(rightX, (zoneSweet + tp3) / 2.0,
             rrOK ? "RR ≥ 1:4 ✓" : "RR < 1:4 — SKIP",
             style=label.style_label_left,
             color=rrOK ? color.new(colBull, 40) : color.new(color.orange, 30),
             textcolor=color.white, size=size.small)

// Mark invalidation candle
bgcolor(invFires ? color.new(colInv, 70) : na, title="Invalidation flash")

// Sweep markers
plotshape(sweepBSL, title="BSL sweep",  style=shape.triangledown,
     location=location.abovebar, color=colBear, size=size.tiny)
plotshape(sweepSSL, title="SSL sweep",  style=shape.triangleup,
     location=location.belowbar, color=colBull, size=size.tiny)

// MSS markers
plotshape(mssUp, title="MSS up",   style=shape.labelup,
     location=location.belowbar, color=color.new(colBull, 60),
     text="MSS", textcolor=color.white, size=size.tiny)
plotshape(mssDn, title="MSS down", style=shape.labeldown,
     location=location.abovebar, color=color.new(colBear, 60),
     text="MSS", textcolor=color.white, size=size.tiny)

// ─────────────────────────────────────────────────────────────────────────────
// 10. DASHBOARD
// ─────────────────────────────────────────────────────────────────────────────
posMap(s) =>
    s == "top_left"     ? position.top_left :
    s == "bottom_right" ? position.bottom_right :
    s == "bottom_left"  ? position.bottom_left :
    s == "middle_right" ? position.middle_right : position.top_right

var table dash = table.new(posMap(dashPos), 2, 9,
     border_width=1, frame_color=color.new(color.gray, 50),
     border_color=color.new(color.gray, 70))

biasTxt = invalidated ? "DEFENSIVE — STAND DOWN" :
          biasState ==  1 ? "BULLISH ▲" :
          biasState == -1 ? "BEARISH ▼" : "NEUTRAL ◇"
biasBg  = invalidated ? color.new(color.orange, 50) :
          biasState ==  1 ? color.new(colBull, 60) :
          biasState == -1 ? color.new(colBear, 60) :
                            color.new(colNeut, 60)

trigTxt = revStep == 0 ? "—" :
          revStep == 1 ? "1/4 sweep ✓" :
          revStep == 2 ? "2/4 sweep + MSS ✓" :
          revStep == 3 ? "3/4 sweep + MSS + reclaim ✓" : "ARMED"

dntTxt = mState == "WEAK MOMENTUM" ? "weak ATR — stand down" :
         invalidated                ? "wait reclaim sequence" :
         dir == 0                   ? "no bias — observe" : "—"

f_cell(int r, int c, string txt, color bg, color tc) =>
    table.cell(dash, c, r, txt, bgcolor=bg, text_color=tc, text_size=size.small)

if showDash and barstate.islast
    table.clear(dash, 0, 0, 1, 8)
    f_cell(0, 0, "DAILY BIAS",   color.new(color.black, 30), color.white)
    f_cell(0, 1, biasTxt + "  (" + str.tostring(confScore) + ")",
         biasBg, color.white)

    f_cell(1, 0, "AYA LINE",     color.new(color.black, 30), color.white)
    f_cell(1, 1, str.tostring(ayaLine, format.mintick),
         color.new(colAya, 60), color.white)

    f_cell(2, 0, "INVALIDATION", color.new(color.black, 30), color.white)
    f_cell(2, 1, na(invLevel) ? "—" : str.tostring(invLevel, format.mintick),
         color.new(colInv, 60), color.white)

    f_cell(3, 0, "TP1 / TP2",    color.new(color.black, 30), color.white)
    f_cell(3, 1,
         (na(tp1) ? "—" : str.tostring(tp1, format.mintick)) + "  /  " +
         (na(tp2) ? "—" : str.tostring(tp2, format.mintick)),
         color.new(colTP, 70), color.white)

    f_cell(4, 0, "TP3 / EXT",    color.new(color.black, 30), color.white)
    f_cell(4, 1,
         (na(tp3)  ? "—" : str.tostring(tp3,  format.mintick)) + "  /  " +
         (na(tpExt)? "—" : str.tostring(tpExt,format.mintick)),
         color.new(colTP, 60), color.white)

    f_cell(5, 0, "STATE",        color.new(color.black, 30), color.white)
    stateBg = mState == "TRENDING"      ? color.new(colBull,  70) :
              mState == "WEAK MOMENTUM" ? color.new(color.orange, 60) :
              mState == "ROTATIONAL"    ? color.new(colNeut,  70) :
                                          color.new(color.gray, 60)
    f_cell(5, 1, mState + "  (ATR×" + str.tostring(atrRatio, "#.##") + ")",
         stateBg, color.white)

    f_cell(6, 0, "TRIGGER",      color.new(color.black, 30), color.white)
    f_cell(6, 1, trigTxt, color.new(color.purple, 60), color.white)

    f_cell(7, 0, "DO-NOT-TRADE", color.new(color.black, 30), color.white)
    f_cell(7, 1, dntTxt,
         dntTxt == "—" ? color.new(colBull, 70) : color.new(color.orange, 50),
         color.white)

    f_cell(8, 0, "PHILOSOPHY",   color.new(color.black, 30), color.white)
    f_cell(8, 1, "Capital first · ≥1:4 RR · 1H invalidation",
         color.new(color.black, 60), color.silver)

// ─────────────────────────────────────────────────────────────────────────────
// 11. ALERTS
// ─────────────────────────────────────────────────────────────────────────────
biasFlipped = ta.change(biasState) != 0
alertcondition(biasFlipped,        title="AYA: Bias flip",
     message="AYA Line bias flipped — re-evaluate plan.")
alertcondition(invFires,           title="AYA: Invalidation",
     message="AYA Line INVALIDATED on 1H full-body close.")
alertcondition(sweepBSL or sweepSSL,title="AYA: Liquidity sweep",
     message="Liquidity sweep detected — watch for reclaim.")
alertcondition(mssUp or mssDn,     title="AYA: Market structure shift",
     message="MSS detected on chart timeframe.")
alertcondition(not na(zoneSweet) and ta.cross(close, zoneSweet),
     title="AYA: Pullback tag (OTE)",
     message="Price tagged the AYA OTE sweet-spot.")
alertcondition(not na(tp1) and ta.cross(close, tp1),
     title="AYA: TP1 hit", message="AYA TP1 reached.")
alertcondition(not na(tp2) and ta.cross(close, tp2),
     title="AYA: TP2 hit", message="AYA TP2 reached.")
alertcondition(not na(tp3) and ta.cross(close, tp3),
     title="AYA: TP3 hit (1:4)", message="AYA TP3 reached — minimum asymmetric objective.")
alertcondition(not na(tpExt) and ta.cross(close, tpExt),
     title="AYA: Extended target hit", message="AYA Extended target reached.")
