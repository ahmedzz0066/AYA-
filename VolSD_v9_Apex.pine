//@version=6
// =====================================================================================
//  VOLUMETRIC SUPPLY & DEMAND ZONES — v9 "APEX"
//  First-principles rebuild of the v8 self-learning engine. Every change below fixes a
//  measured flaw in v8, not a cosmetic wish:
//
//   1) SHADOW LEARNING (kills selection bias): v8 only created zones above the display
//      threshold, so the model never saw the zones it rejected — a feedback loop that
//      can never discover its own false negatives. v9 tracks EVERY candidate zone
//      internally (invisible "shadow" zones) and learns from all of them; the display
//      threshold only controls what you SEE, never what the model LEARNS.
//
//   2) SOFT LABELS (magnitude matters): v8 labeled bounce=1 / break=0. v9 tracks each
//      tested zone's Maximum Favorable Excursion; a zone that ran 90% of target before
//      breaking is labeled ~0.45, not 0. Information is no longer thrown away.
//
//   3) DUAL EXPERTS (regime mixture): trending and ranging markets are different
//      physical systems. v9 trains two independent weight vectors, gated by ADX at
//      zone creation; each zone trains the expert that was active when it formed.
//
//   4) EXPERIENCE REPLAY + L2: each resolution triggers one fresh SGD step plus k
//      deterministic replay steps over a circular buffer of past examples (faster,
//      more stable convergence; deterministic indexing so reloads reproduce exactly).
//      L2 weight decay stops runaway weights.
//
//   5) EXPECTED VALUE, NOT JUST PROBABILITY: every zone shows EV in R-multiples
//      (P·target − (1−P)·risk)/risk with risk = zone height + buffer, target = the
//      same reactMult·ATR the model is trained on. The dashboard derives the
//      break-even P from realized geometry and tells you the empirically justified
//      trade threshold from the calibration buckets.
//
//   6) ENTRY-QUALITY GRADING: a retest only fires a signal if the APPROACH is right:
//      exhaustion into the zone (contracting true range), rejection wick, rejection
//      close, and a volume spike — at least 3 of 4. Zone quality and entry quality
//      are different questions; v9 answers both.
//
//   7) OVERLAP DEDUP: a new candidate overlapping an active same-side zone by >=50%
//      is skipped — no double-counted, double-drawn stacks.
//
//  Carried over from v8: absorption-graded touch decay, true LTF delta (CLV fallback),
//  time-of-day relative volume, volatility shock filter, rolling volume profile,
//  non-repainting guarantees (confirmed bars, frozen per-zone P, lookahead_off,
//  walk-forward-only learning).
// =====================================================================================
indicator("Volumetric S/D Zones v9 — Apex", "VolSD v9", overlay = true,
     max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500,
     max_bars_back = 5000, dynamic_requests = true)

// -------------------------------------------------------------------------------------
// INPUTS
// -------------------------------------------------------------------------------------
gD  = "1 · Base → Impulse Detection"
lenBase    = input.int(3,    "Base length (consolidation bars)", minval = 1, maxval = 20, group = gD)
baseMaxATR = input.float(2.0, "Max base range (×ATR)", minval = 0.2, step = 0.1, group = gD)
impATRmult = input.float(1.6, "Impulse range (×ATR)", minval = 0.5, step = 0.1, group = gD)
volZmin    = input.float(0.8, "Impulse volume z-score", minval = -2, step = 0.1, group = gD)
bodyRatio  = input.float(0.55, "Impulse body/range ratio", minval = 0.1, maxval = 1.0, step = 0.05, group = gD)

gL  = "2 · Learning Engine"
lrRate     = input.float(0.05,  "Learning rate", minval = 0.001, maxval = 0.5, step = 0.005, group = gL)
l2Reg      = input.float(0.001, "L2 weight decay", minval = 0.0, maxval = 0.05, step = 0.0005, group = gL)
replayK    = input.int(4, "Replay steps per resolution", minval = 0, maxval = 16, group = gL,
     tooltip = "Extra deterministic SGD steps over the replay buffer each time a zone resolves. More = faster convergence.")
reactMult  = input.float(1.5, "Bounce target (×ATR from zone edge)", minval = 0.3, step = 0.1, group = gL)
minProb    = input.float(0.55, "Min P(bounce) to DISPLAY", minval = 0.0, maxval = 0.95, step = 0.05, group = gL,
     tooltip = "Display filter only. The model learns from ALL candidate zones regardless (shadow learning) — no selection bias.")
alertProb  = input.float(0.65, "Min P(bounce) for entry signals", minval = 0.0, maxval = 0.95, step = 0.05, group = gL)
minEV      = input.float(0.3, "Min EV (R) for entry signals", minval = -1.0, maxval = 3.0, step = 0.1, group = gL)

gA2 = "3 · Absorption Touch Decay"
touchDecay = input.float(0.80, "Base per-touch decay", minval = 0.1, maxval = 1.0, step = 0.05, group = gA2)
penDeep    = input.float(0.80, "Deep-penetration threshold", minval = 0.3, maxval = 1.0, step = 0.05, group = gA2)
freshHL    = input.int(200, "Freshness half-life (bars)", minval = 5, group = gA2)

gDl = "4 · True Delta & Session Volume"
useLTF     = input.bool(true, "True intrabar delta (fallback: close-location)", group = gDl)
ltfRes     = input.timeframe("1", "Lower timeframe for delta", group = gDl)
sessN      = input.int(20, "Time-of-day volume smoothing", minval = 2, group = gDl)
shockOn    = input.bool(true, "Suspend creation after volatility shocks", group = gDl)
shockZ     = input.float(4.0, "Shock threshold (TR z-score)", minval = 2, step = 0.5, group = gDl)
shockBars  = input.int(3, "Suspension length (bars)", minval = 1, maxval = 20, group = gDl)

gV  = "5 · Volume Profile"
vpEnable   = input.bool(true, "Enable rolling profile", group = gV)
vpLookback = input.int(200, "Profile lookback (bars)", minval = 20, maxval = 1000, group = gV)
vpBins     = input.int(24, "Profile resolution (bins)", minval = 8, maxval = 100, group = gV)
vaPct      = input.float(70, "Value Area %", minval = 50, maxval = 95, step = 1, group = gV)
vpHist     = input.bool(true, "Draw profile histogram", group = gV)

gM  = "6 · Mitigation & Lifecycle"
mitigType  = input.string("Close through", "Mitigation trigger", options = ["Close through", "Wick through"], group = gM)
removeMit  = input.bool(true, "Remove mitigated zones", group = gM)
maxZones   = input.int(20, "Max tracked zones per side (incl. shadow)", minval = 4, maxval = 60, group = gM)

gH  = "7 · Regime & HTF"
adxLen     = input.int(14, "ADX length", minval = 2, group = gH)
adxTrend   = input.float(20, "ADX trend threshold", minval = 5, step = 1, group = gH)
htfEnable  = input.bool(true, "Enable HTF trend feature", group = gH)
htfRes     = input.timeframe("240", "HTF resolution", group = gH)
htfEmaLen  = input.int(50, "HTF trend EMA length", minval = 2, group = gH)

gZ  = "8 · Visuals"
colDem     = input.color(color.new(#26a69a, 0), "Demand color", group = gZ)
colSup     = input.color(color.new(#ef5350, 0), "Supply color", group = gZ)
showPOC    = input.bool(true, "Show zone POC line", group = gZ)
showLabel  = input.bool(true, "Show probability label", group = gZ)
extendRt   = input.int(15, "Extend boxes (bars right)", minval = 0, group = gZ)
maxTransp  = input.int(90, "Transparency (weak)", minval = 50, maxval = 99, group = gZ)
minTransp  = input.int(58, "Transparency (strong)", minval = 0, maxval = 90, group = gZ)

gAl = "9 · Alerts"
alertOn    = input.bool(true, "Alert on graded entry signals", group = gAl)
alertSpike = input.float(1.5, "Volume spike (×avg)", minval = 1.0, step = 0.1, group = gAl)

// -------------------------------------------------------------------------------------
// CORE SERIES (all ta.* hoisted)
// -------------------------------------------------------------------------------------
atr     = ta.atr(14)
avgVol  = ta.sma(volume, 50)
volSd   = ta.stdev(volume, 50)
gVolZ   = volSd > 0 ? (volume - avgVol) / volSd : 0.0
gVolPct = ta.percentrank(volume, 100) / 100.0
gTrSma  = ta.sma(ta.tr, 5)
[diP, diM, adx] = ta.dmi(adxLen, adxLen)
trending = adx >= adxTrend

trMean = ta.sma(ta.tr, 100)
trSd   = ta.stdev(ta.tr, 100)
trZ    = trSd > 0 ? (ta.tr - trMean) / trSd : 0.0
var int shockUntil = -1
if shockOn and trZ >= shockZ
    shockUntil := bar_index + shockBars
blockNew = shockOn and bar_index <= shockUntil

htfClose = htfEnable ? request.security(syminfo.tickerid, htfRes, close[1], lookahead = barmerge.lookahead_off) : close
htfEma   = htfEnable ? request.security(syminfo.tickerid, htfRes, ta.ema(close, htfEmaLen)[1], lookahead = barmerge.lookahead_off) : close
htfUp    = htfClose > htfEma
htfDn    = htfClose < htfEma

// True intrabar delta ratio in [-1, 1]; CLV fallback
clvRatio = high == low ? 0.0 : (2.0 * close - high - low) / (high - low)
bool ltfOK = useLTF and timeframe.in_seconds(ltfRes) < timeframe.in_seconds(timeframe.period)
float gDeltaRatio = clvRatio
if ltfOK
    [sArr, vArr] = request.security_lower_tf(syminfo.tickerid, ltfRes,
         [volume * (close >= open ? 1.0 : -1.0), volume])
    if array.size(vArr) > 0
        float vSum = array.sum(vArr)
        if vSum > 0
            gDeltaRatio := array.sum(sArr) / vSum

// Session-relative volume (per hour-of-day baseline)
var array<float> hodVol = array.new_float(24, na)
float gRelVol = 1.0
if timeframe.isintraday
    int hIdx = hour
    float hAvg = array.get(hodVol, hIdx)
    gRelVol := na(hAvg) or hAvg <= 0 ? 1.0 : volume / hAvg
    array.set(hodVol, hIdx, na(hAvg) ? volume : hAvg + (volume - hAvg) / sessN)
else
    gRelVol := avgVol > 0 ? volume / avgVol : 1.0

// -------------------------------------------------------------------------------------
// LEARNING STATE — dual experts + replay buffer (globals mutated only via array.set)
// -------------------------------------------------------------------------------------
int NF = 7          // 0 volPct, 1 impulse, 2 delta, 3 width, 4 htf, 5 hvn, 6 relVol
int REPLAY_CAP = 128

var array<float> Wr = array.new_float(NF, 1.0)     // expert 0: RANGING
var array<float> Wt = array.new_float(NF, 1.0)     // expert 1: TRENDING
var array<float> Bb = array.new_float(2, -2.5)     // per-expert bias
var array<float> bucketN = array.new_float(5, 0.0)
var array<float> bucketY = array.new_float(5, 0.0)
var array<float> mstats  = array.new_float(4, 0.0) // [0] n resolved, [1] sum y, [2] n created, [3] sum RR
// circular replay buffer (flattened features + label + weight + expert)
var array<float> bufX = array.new_float(REPLAY_CAP * 7, 0.0)
var array<float> bufY = array.new_float(REPLAY_CAP, 0.0)
var array<float> bufE = array.new_float(REPLAY_CAP, 0.0)
var array<float> bufMeta = array.new_float(2, 0.0)  // [0] write pos, [1] count

f_clamp(float v, float lo, float hi) => math.max(lo, math.min(hi, v))

f_sigmoid(float z) => 1.0 / (1.0 + math.exp(-f_clamp(z, -30, 30)))

f_predict(int e, array<float> x) =>
    array<float> ww = Wr
    if e == 1
        ww := Wt
    float z = array.get(Bb, e)
    for i = 0 to NF - 1
        z := z + array.get(ww, i) * array.get(x, i)
    f_sigmoid(z)

// One SGD step (with L2) on expert e
f_step(int e, array<float> x, float y) =>
    array<float> ww = Wr
    if e == 1
        ww := Wt
    float p   = f_predict(e, x)
    float err = y - p
    for i = 0 to NF - 1
        float wNew = array.get(ww, i) + lrRate * err * array.get(x, i) - l2Reg * array.get(ww, i)
        array.set(ww, i, f_clamp(wNew, -4.0, 4.0))
    array.set(Bb, e, f_clamp(array.get(Bb, e) + lrRate * err, -6.0, 6.0))

// Full learn: fresh step + calibration bookkeeping + deterministic replay
f_learn(int e, array<float> x, float y) =>
    float p = f_predict(e, x)
    f_step(e, x, y)
    int b = int(math.min(4, math.floor(p * 5)))
    array.set(bucketN, b, array.get(bucketN, b) + 1.0)
    array.set(bucketY, b, array.get(bucketY, b) + y)
    array.set(mstats, 0, array.get(mstats, 0) + 1.0)
    array.set(mstats, 1, array.get(mstats, 1) + y)
    // push into circular buffer
    int pos = int(array.get(bufMeta, 0))
    for i = 0 to NF - 1
        array.set(bufX, pos * NF + i, array.get(x, i))
    array.set(bufY, pos, y)
    array.set(bufE, pos, e)
    array.set(bufMeta, 0, (pos + 1) % REPLAY_CAP)
    array.set(bufMeta, 1, math.min(REPLAY_CAP, array.get(bufMeta, 1) + 1))
    // deterministic replay (reproducible across reloads: no randomness)
    int cnt = int(array.get(bufMeta, 1))
    if replayK > 0 and cnt > 4
        int seed = int(array.get(mstats, 0))
        for j = 1 to replayK
            int ridx = (seed * 13 + j * 29) % cnt
            array<float> rx = array.new_float(NF, 0.0)
            for i = 0 to NF - 1
                array.set(rx, i, array.get(bufX, ridx * NF + i))
            f_step(int(array.get(bufE, ridx)), rx, array.get(bufY, ridx))

f_bucketTxt(float p) =>
    int b = int(math.min(4, math.floor(p * 5)))
    float n = array.get(bucketN, b)
    float y = array.get(bucketY, b)
    n > 0 ? str.tostring(100.0 * y / n, "#") + "% (n=" + str.tostring(int(n)) + ")" : "n/a"

// Empirically justified trade threshold: lowest bucket whose realized rate clears
// the break-even probability implied by average zone geometry (with margin, n>=10)
f_tradeThreshold() =>
    float nC  = array.get(mstats, 2)
    float rr  = nC > 0 ? array.get(mstats, 3) / nC : reactMult
    float pBE = 1.0 / (1.0 + rr)
    string txt = "gathering data"
    for b = 0 to 4
        float n = array.get(bucketN, b)
        if n >= 10 and array.get(bucketY, b) / n >= pBE + 0.05
            txt := "trade P >= " + str.tostring(b * 20) + "% (BE " + str.tostring(pBE * 100, "#") + "%)"
            break
    txt

// -------------------------------------------------------------------------------------
// VOLUME PROFILE (state-free)
// -------------------------------------------------------------------------------------
f_profile(int lb, int nb, float vapct) =>
    float hi = high
    float lo = low
    for i = 0 to lb - 1
        hi := math.max(hi, high[i])
        lo := math.min(lo, low[i])
    float stp = (hi - lo) / nb
    array<float> bv = array.new_float(nb, 0.0)
    if stp > 0
        for i = 0 to lb - 1
            int loB = math.max(0, math.min(nb - 1, int((low[i]  - lo) / stp)))
            int hiB = math.max(0, math.min(nb - 1, int((high[i] - lo) / stp)))
            float per = volume[i] / (hiB - loB + 1)
            for b = loB to hiB
                array.set(bv, b, array.get(bv, b) + per)
    int pocIdx = 0
    float pocV = -1.0
    for i = 0 to nb - 1
        if array.get(bv, i) > pocV
            pocV := array.get(bv, i)
            pocIdx := i
    float tot = array.sum(bv)
    float tgt = tot * vapct / 100.0
    float acc = array.get(bv, pocIdx)
    int up = pocIdx + 1
    int dn = pocIdx - 1
    int vahI = pocIdx
    int valI = pocIdx
    while acc < tgt and (up < nb or dn >= 0)
        float vU = up < nb ? array.get(bv, up) : -1.0
        float vD = dn >= 0 ? array.get(bv, dn) : -1.0
        if vU >= vD
            acc := acc + vU
            vahI := up
            up := up + 1
        else
            acc := acc + vD
            valI := dn
            dn := dn - 1
    [lo + (pocIdx + 0.5) * stp, lo + (vahI + 1) * stp, lo + valI * stp, bv, lo, stp, pocV]

// -------------------------------------------------------------------------------------
// ZONE TYPE & STORAGE
// -------------------------------------------------------------------------------------
type Zone
    float top
    float bot
    float poc
    float prob          // frozen at creation — never repaints
    float evR           // expected value in R-multiples at creation
    bool  isDemand
    bool  vis           // false = shadow zone (learning only, no drawings)
    int   expert        // 0 ranging / 1 trending at creation
    array<float> feat
    int   createdBar
    float atr0
    float mfe           // max favorable excursion beyond proximal edge (after test)
    float decayMult
    int   touches
    bool  inside
    bool  touched
    bool  resolved
    bool  mitigated
    box   bx
    line  pocLn
    label lbl

var array<Zone> demZones = array.new<Zone>()
var array<Zone> supZones = array.new<Zone>()

f_live(Zone z) =>
    float age   = math.max(0, bar_index - z.createdBar)
    float fresh = math.pow(0.5, age / freshHL)
    z.prob * fresh * z.decayMult

f_transp(float liveP) =>
    float k = f_clamp(liveP, 0.0, 1.0)
    int(maxTransp - (maxTransp - minTransp) * k)

f_tagText(Zone z) =>
    string t = (z.isDemand ? "DEMAND " : "SUPPLY ") + "P:" + str.tostring(z.prob * 100, "#") + "%"
    t := t + " | hist " + f_bucketTxt(z.prob)
    t := t + " | EV " + (z.evR >= 0 ? "+" : "") + str.tostring(z.evR, "#.0#") + "R"
    t := t + (z.touches > 0 ? " | " + str.tostring(z.touches) + "T" : "")
    t := t + (z.resolved and not z.mitigated ? " | HELD" : "")
    t

f_baseVwap(int startOff, int n) =>
    float pv = 0.0
    float vv = 0.0
    for i = startOff to startOff + n - 1
        pv += hlc3[i] * volume[i]
        vv += volume[i]
    vv > 0 ? pv / vv : hlc3[startOff]

// >=50% overlap with an active same-side zone? (dedup)
f_overlaps(array<Zone> arr, float top, float bot) =>
    bool dup = false
    float h = math.max(top - bot, syminfo.mintick)
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            Zone z = array.get(arr, i)
            if not z.mitigated
                float ov = math.min(top, z.top) - math.max(bot, z.bot)
                if ov / h >= 0.5
                    dup := true
                    break
    dup

// -------------------------------------------------------------------------------------
// DETECTION (confirmed bars; impulse = last closed bar)
// -------------------------------------------------------------------------------------
impOff  = 1
baseOff = impOff + 1

rng1   = high[impOff] - low[impOff]
body1  = math.abs(close[impOff] - open[impOff])
direc  = body1 / math.max(rng1, syminfo.mintick)

isImp  = rng1 > impATRmult * atr and gVolZ[1] >= volZmin and direc >= bodyRatio
impUp  = isImp and close[impOff] > open[impOff]
impDn  = isImp and close[impOff] < open[impOff]

baseHi = ta.highest(high, lenBase)[baseOff]
baseLo = ta.lowest(low,  lenBase)[baseOff]
baseTight = (baseHi - baseLo) < baseMaxATR * atr

f_addZone(bool dem) =>
    float top = baseHi
    float bot = baseLo
    array<Zone> arr = dem ? demZones : supZones
    if not f_overlaps(arr, top, bot)
        // ---- features ----
        float xVol   = gVolPct[1]
        float xImp   = math.min(1.0, (rng1 / atr) / (impATRmult * 1.5))
        float dRatio = gDeltaRatio[1]
        float xDelta = dem ? (dRatio + 1.0) / 2.0 : (1.0 - dRatio) / 2.0
        float xWidth = math.max(0.0, 1.0 - (top - bot) / (atr * 3.0))
        float xHtf   = not htfEnable ? 0.5 : (dem ? (htfUp ? 1.0 : 0.0) : (htfDn ? 1.0 : 0.0))
        float xHvn   = 0.5
        if vpEnable
            [_p, vHi, vLo, _b, _l, _s, _m] = f_profile(vpLookback, vpBins, vaPct)
            xHvn := (top >= vLo and bot <= vHi) ? 1.0 : 0.0
        float xRvol  = math.min(1.0, gRelVol[1] / 3.0)
        array<float> x = array.from(xVol, xImp, xDelta, xWidth, xHtf, xHvn, xRvol)
        int  expert = trending ? 1 : 0
        float prob  = f_predict(expert, x)
        // ---- economics ----
        float target  = reactMult * atr
        float riskAmt = (top - bot) + 0.1 * atr
        float evR     = riskAmt > 0 ? (prob * target - (1.0 - prob) * riskAmt) / riskAmt : 0.0
        array.set(mstats, 2, array.get(mstats, 2) + 1.0)
        array.set(mstats, 3, array.get(mstats, 3) + (riskAmt > 0 ? target / riskAmt : reactMult))
        // ---- shadow learning: ALWAYS track; draw only above threshold ----
        bool vis = prob >= minProb
        float pocZ = f_baseVwap(baseOff, lenBase)
        color c    = dem ? colDem : colSup
        box bx   = vis ? box.new(bar_index[baseOff + lenBase - 1], top, bar_index + extendRt, bot,
             border_color = color.new(c, 30), bgcolor = color.new(c, f_transp(prob)), border_width = 1) : na
        line ln  = vis and showPOC ? line.new(bar_index[baseOff], pocZ, bar_index + extendRt, pocZ,
             color = color.new(c, 10), style = line.style_dotted) : na
        label lb = vis and showLabel ? label.new(bar_index + extendRt, dem ? bot : top, "",
             style = dem ? label.style_label_up : label.style_label_down,
             color = color.new(c, 20), textcolor = color.white, size = size.small) : na
        Zone z = Zone.new(top, bot, pocZ, prob, evR, dem, vis, expert, x, bar_index, atr,
             0.0, 1.0, 0, false, false, false, false, bx, ln, lb)
        if not na(lb)
            label.set_text(lb, f_tagText(z))
        array.push(arr, z)
        if array.size(arr) > maxZones
            Zone old = array.shift(arr)
            box.delete(old.bx)
            line.delete(old.pocLn)
            label.delete(old.lbl)

if barstate.isconfirmed and isImp and baseTight and not blockNew
    if impUp
        f_addZone(true)
    if impDn
        f_addZone(false)

// -------------------------------------------------------------------------------------
// LIFECYCLE: MFE tracking, soft-label learning, absorption decay, graded entries
// -------------------------------------------------------------------------------------
f_update(array<Zone> arr) =>
    bool fired = false
    if array.size(arr) > 0
        for i = array.size(arr) - 1 to 0
            Zone z = array.get(arr, i)
            if not z.mitigated
                float height = math.max(z.top - z.bot, syminfo.mintick)
                float target = reactMult * z.atr0
                bool touchingNow = low <= z.top and high >= z.bot
                // ---- new touch: absorption grade + entry-quality grade ----
                if touchingNow and not z.inside
                    z.touches += 1
                    z.touched := true
                    float pen = z.isDemand ? f_clamp((z.top - low) / height, 0.0, 1.0)
                                           : f_clamp((high - z.bot) / height, 0.0, 1.0)
                    bool rejected = z.isDemand ? close > z.top - 0.25 * height
                                               : close < z.bot + 0.25 * height
                    bool volHigh  = gVolZ >= 1.0
                    float m = rejected and volHigh and pen < 0.5 ? 1.0 :
                         rejected ? math.pow(touchDecay, 0.5) :
                         pen >= penDeep ? touchDecay * touchDecay : touchDecay
                    z.decayMult := z.decayMult * m
                    // graded entry: exhaustion + wick + rejection close + volume (>=3 of 4)
                    bool exhaust = ta.tr < gTrSma[1]
                    float rngNow = math.max(high - low, syminfo.mintick)
                    bool wick = z.isDemand ? (math.min(open, close) - low) / rngNow >= 0.5
                                           : (high - math.max(open, close)) / rngNow >= 0.5
                    bool rejC  = z.isDemand ? close > open : close < open
                    bool spike = volume > alertSpike * avgVol
                    int q = (exhaust ? 1 : 0) + (wick ? 1 : 0) + (rejC ? 1 : 0) + (spike ? 1 : 0)
                    if alertOn and z.vis and q >= 3 and z.prob >= alertProb and z.evR >= minEV
                        fired := true
                z.inside := touchingNow
                // ---- MFE tracking (after first test) ----
                if z.touched
                    float exc = z.isDemand ? high - z.top : z.bot - low
                    z.mfe := math.max(z.mfe, exc)
                // ---- resolution: full target -> y = 1 ----
                if not z.resolved and z.touched and z.mfe >= target
                    f_learn(z.expert, z.feat, 1.0)
                    z.resolved := true
                // ---- mitigation: soft label from partial excursion ----
                bool through = mitigType == "Close through"
                     ? (z.isDemand ? close < z.bot : close > z.top)
                     : (z.isDemand ? low   < z.bot : high  > z.top)
                if through
                    if not z.resolved and z.touched
                        // partial credit: broke, but ran mfe/target first (scaled to [0, 0.5])
                        float ySoft = 0.5 * f_clamp(z.mfe / target, 0.0, 1.0)
                        f_learn(z.expert, z.feat, ySoft)
                    z.resolved  := true
                    z.mitigated := true
                    if removeMit or not z.vis
                        box.delete(z.bx)
                        line.delete(z.pocLn)
                        label.delete(z.lbl)
                        array.remove(arr, i)
                        continue
                    else
                        box.set_bgcolor(z.bx, color.new(color.gray, 92))
                        box.set_border_color(z.bx, color.new(color.gray, 60))
                else if z.vis
                    float live = f_live(z)
                    if not na(z.bx)
                        box.set_right(z.bx, bar_index + extendRt)
                        box.set_bgcolor(z.bx, color.new(z.isDemand ? colDem : colSup, f_transp(live)))
                    if not na(z.pocLn)
                        line.set_x2(z.pocLn, bar_index + extendRt)
                    if not na(z.lbl)
                        label.set_x(z.lbl, bar_index + extendRt)
                        label.set_text(z.lbl, f_tagText(z))
    fired

bool demEntry = false
bool supEntry = false
if barstate.isconfirmed
    demEntry := f_update(demZones)
    supEntry := f_update(supZones)

plotshape(demEntry, "Demand entry", shape.triangleup,   location.belowbar, color.new(#26a69a, 0), size = size.small, text = "ENTRY")
plotshape(supEntry, "Supply entry", shape.triangledown, location.abovebar, color.new(#ef5350, 0), size = size.small, text = "ENTRY")

// -------------------------------------------------------------------------------------
// ROLLING VOLUME PROFILE DRAWING (last bar)
// -------------------------------------------------------------------------------------
var line pocLine = na
var line vahLine = na
var line valLine = na
var array<box> histBoxes = array.new<box>()

if vpEnable and barstate.islast
    [vpPoc, vpVah, vpVal, bv, vpLo, vpStp, vpMaxV] = f_profile(vpLookback, vpBins, vaPct)
    int xr = bar_index + extendRt
    int xl = bar_index - vpLookback
    line.delete(pocLine)
    line.delete(vahLine)
    line.delete(valLine)
    pocLine := line.new(xl, vpPoc, xr, vpPoc, color = color.new(color.orange, 0), width = 2)
    vahLine := line.new(xl, vpVah, xr, vpVah, color = color.new(color.blue, 0), style = line.style_dashed)
    valLine := line.new(xl, vpVal, xr, vpVal, color = color.new(color.blue, 0), style = line.style_dashed)
    if vpHist
        if array.size(histBoxes) > 0
            for i = 0 to array.size(histBoxes) - 1
                box.delete(array.get(histBoxes, i))
            array.clear(histBoxes)
        float maxLen = vpLookback * 0.4
        for b = 0 to vpBins - 1
            float v = array.get(bv, b)
            if v > 0 and vpMaxV > 0
                int len = int(maxLen * v / vpMaxV)
                float yTop = vpLo + (b + 1) * vpStp
                float yBot = vpLo + b * vpStp
                bool inVA = yBot >= vpVal and yTop <= vpVah
                box hb = box.new(bar_index - len, yTop, bar_index, yBot,
                     border_color = na, bgcolor = color.new(inVA ? color.blue : color.gray, 78))
                array.push(histBoxes, hb)

// -------------------------------------------------------------------------------------
// ALERTS
// -------------------------------------------------------------------------------------
anyEntry = demEntry or supEntry
alertcondition(anyEntry, "Graded entry signal", "VolSD v9: graded entry at high-P, positive-EV zone")
if anyEntry
    alert("VolSD v9 ENTRY: " + (demEntry ? "DEMAND" : "SUPPLY") + " retest with exhaustion/wick/rejection/volume (>=3 of 4) on " + syminfo.ticker, alert.freq_once_per_bar_close)

newDem = barstate.isconfirmed and isImp and impUp and baseTight and not blockNew
newSup = barstate.isconfirmed and isImp and impDn and baseTight and not blockNew
alertcondition(newDem, "New demand candidate", "VolSD v9: new demand zone candidate")
alertcondition(newSup, "New supply candidate", "VolSD v9: new supply zone candidate")

// -------------------------------------------------------------------------------------
// DASHBOARD
// -------------------------------------------------------------------------------------
var table info = table.new(position.top_right, 1, 7, frame_color = color.gray, frame_width = 1)
if barstate.islast
    float nRes = array.get(mstats, 0)
    float nBnc = array.get(mstats, 1)
    string modelTxt = nRes > 0
         ? "Learned: n=" + str.tostring(int(nRes)) + " | avg y " + str.tostring(100.0 * nBnc / nRes, "#") + "%"
         : "Learning: warm-up"
    array<float> wAct = Wr
    if trending
        wAct := Wt
    string wTxt = (trending ? "TREND w " : "RANGE w ")
         + "vol " + str.tostring(array.get(wAct, 0), "#.0")
         + " imp " + str.tostring(array.get(wAct, 1), "#.0")
         + " dlt " + str.tostring(array.get(wAct, 2), "#.0")
         + " wid " + str.tostring(array.get(wAct, 3), "#.0")
    string wTxt2 = "        htf " + str.tostring(array.get(wAct, 4), "#.0")
         + " hvn " + str.tostring(array.get(wAct, 5), "#.0")
         + " rvol " + str.tostring(array.get(wAct, 6), "#.0")
    table.cell(info, 0, 0, "VolSD v9 - Apex", text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
    table.cell(info, 0, 1, (trending ? "TRENDING" : "RANGING") + "  ADX " + str.tostring(adx, "#.0") + (blockNew ? " | SHOCK PAUSE" : ""),
         text_color = color.white, bgcolor = color.new(trending ? color.teal : color.maroon, 20), text_size = size.small)
    table.cell(info, 0, 2, "Dem " + str.tostring(array.size(demZones)) + " | Sup " + str.tostring(array.size(supZones))
         + " | delta: " + (ltfOK ? "true (" + ltfRes + ")" : "CLV"),
         text_color = color.white, bgcolor = color.new(color.black, 20), text_size = size.small)
    table.cell(info, 0, 3, modelTxt, text_color = color.white, bgcolor = color.new(color.navy, 20), text_size = size.small)
    table.cell(info, 0, 4, "Threshold: " + f_tradeThreshold(), text_color = color.yellow, bgcolor = color.new(color.black, 20), text_size = size.small)
    table.cell(info, 0, 5, wTxt,  text_color = color.silver, bgcolor = color.new(color.black, 20), text_size = size.tiny)
    table.cell(info, 0, 6, wTxt2, text_color = color.silver, bgcolor = color.new(color.black, 20), text_size = size.tiny)
