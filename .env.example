# Microsoft Azure AD App Registration
# Create an app at https://portal.azure.com → Azure Active Directory → App registrations
MS_CLIENT_ID=your-client-id-here
MS_CLIENT_SECRET=your-client-secret-here
MS_TENANT_ID=your-tenant-id-here
MS_REDIRECT_URI=http://localhost:5000/callback

# OpenAI API Key (for summarization)
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Flask
FLASK_SECRET_KEY=change-this-to-a-random-string
FLASK_PORT=5000
