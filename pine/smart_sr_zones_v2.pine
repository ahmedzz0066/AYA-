// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
//
// Smart SR Zones v2 — tracker-based rewrite
// Derived from "Smart SR Zones [JOAT]" © officialjackofalltrades (MPL-2.0).
// Original: https://www.tradingview.com/script/NXuV5E1i-Smart-SR-Zones-JOAT/
//
// v2 replaces the clear-and-rebuild clustering engine with a persistent
// multi-object tracker modelled on an autonomy perception stack:
//
//   PERCEPTION   pivots -> feature vectors (volume, wick, post-pivot impulse),
//                measured in the volatility units of their OWN bar
//   ASSOCIATION  gated nearest-neighbour match of each detection to an
//                existing track; recursive weighted-mean state update
//   FUSION       feature prior + Laplace-smoothed outcome evidence, combined
//                in log-odds space -> a calibrated P(hold)
//   DECISION     hysteresis break logic (buffer + N-bar confirmation),
//                polarity flip instead of blacklist, IoU non-max suppression
//   VALIDATION   on-chart reliability diagram: predicted vs realised hold rate
//
//@version=6
indicator(title       = "Smart SR Zones v2",
          shorttitle  = "SSR v2",
          overlay     = true,
          max_lines_count  = 500,
          max_boxes_count  = 500,
          max_labels_count = 500,
          max_bars_back    = 5000)


// =====================================================================
//  SECTION 1 - INPUTS
// =====================================================================
grpEngine  = "1 · Engine"
grpPivot   = "2 · Detector (Custom preset)"
grpTrack   = "3 · Tracker"
grpBreak   = "4 · Break / test logic"
grpScore   = "5 · Scoring weights"
grpVol     = "6 · Volumetric prior field"
grpCtx     = "7 · Context (HTF / round numbers)"
grpZOI     = "8 · Zone of Interest (pre-touch)"
grpStyle   = "9 · Style"
grpDash    = "10 · Dashboard & validation"

// --- Engine ---------------------------------------------------------
preset = input.string("Auto", "Strength preset",
     options = ["Auto", "Scalp", "Local", "Swing", "Major", "Custom"], group = grpEngine,
     tooltip = "Auto scales the detector to the chart timeframe.\nScalp/Local/Swing/Major are fixed profiles.\nCustom exposes the detector parameters below.")

noRepaint = input.bool(true, "Honest mode (draw zones from confirmation bar)", group = grpEngine,
     tooltip = "ON  : a zone's box starts at the bar the pivot was CONFIRMED, which is what you could actually have traded.\nOFF : the box starts at the pivot bar itself, which looks better in hindsight but back-dates information you did not have.")

confirmBarsOnly = input.bool(true, "Evaluate signals on closed bars only", group = grpEngine,
     tooltip = "ON prevents intrabar flicker: tests, breaks and alerts only resolve on bar close.")

zonesPerSide = input.int(5, "Zones drawn per side", minval = 1, maxval = 8, group = grpEngine,
     tooltip = "Display limit only. The tracker keeps every level alive internally, so a zone falling off the list is no longer treated as 'dropped'.")

alertProb = input.float(0.62, "High-probability alert threshold", minval = 0.3, maxval = 0.95, step = 0.02, group = grpEngine,
     tooltip = "P(hold) at which the 'high-probability zone approached' alert arms.")

minProb = input.float(0.0, "Hide zones below P(hold)", minval = 0.0, maxval = 0.9, step = 0.05, group = grpEngine,
     tooltip = "Absolute quality gate. 0 shows everything the tracker holds; 0.6 shows only zones the model rates above a 60% hold probability.")

hideFarAtr = input.float(14.0, "Hide zones farther than (x ATR)", minval = 0.0, maxval = 60.0, step = 1.0, group = grpEngine,
     tooltip = "Distance gate in volatility units instead of percent, so it behaves the same on a $4 stock and on BTC. 0 disables.")

// --- Detector (Custom) ----------------------------------------------
pivLeftIn    = input.int(15,  "Left bars",  minval = 2, maxval = 100, group = grpPivot)
pivRightIn   = input.int(8,   "Right bars", minval = 2, maxval = 50,  group = grpPivot)
clusterTolIn = input.float(0.9, "Association gate (x ATR)", minval = 0.2, maxval = 3.0, step = 0.1, group = grpPivot,
     tooltip = "Maximum distance, in ATR at the pivot's own bar, for a new pivot to be matched to an existing zone.")
minSpacingIn = input.int(20,  "Minimum bars between touches", minval = 0, maxval = 200, group = grpPivot,
     tooltip = "Pivots closer together than this are folded into ONE touch event. Unlike v1 they are still absorbed by the zone, so a level is never split in two by rapid re-tests.")

// --- Tracker --------------------------------------------------------
maxTracks   = input.int(36, "Track pool size", minval = 8, maxval = 60, group = grpTrack,
     tooltip = "Total levels held in memory across both sides. When full, the weakest dead track is recycled first.")
minPivots   = input.int(2,  "Minimum pivots to publish a zone", minval = 1, maxval = 8, group = grpTrack)
staleBars   = input.int(400, "Retire after (bars with no evidence)", minval = 50, maxval = 3000, group = grpTrack,
     tooltip = "A track with no new pivot and no test for this many bars is retired.")
kSigma      = input.float(2.0, "Zone width (x sigma of members)", minval = 0.5, maxval = 4.0, step = 0.25, group = grpTrack,
     tooltip = "Zone thickness is derived from how tightly its own pivots agree, not from a fixed ATR pad. Tight clusters draw thin zones; smeared clusters draw wide ones.")
minPadAtr   = input.float(0.12, "Minimum half-width (x ATR)", minval = 0.02, maxval = 1.0, step = 0.02, group = grpTrack)
maxPadAtr   = input.float(0.60, "Maximum half-width (x ATR)", minval = 0.10, maxval = 3.0, step = 0.05, group = grpTrack)
mergeIoU    = input.float(0.55, "Merge zones above IoU", minval = 0.1, maxval = 0.95, step = 0.05, group = grpTrack,
     tooltip = "Non-max suppression. Two same-side zones overlapping by more than this fraction are fused into one, summing their evidence.")

// --- Break / test logic ---------------------------------------------
breakAtr      = input.float(0.25, "Break buffer (x ATR)", minval = 0.0, maxval = 2.0, step = 0.05, group = grpBreak,
     tooltip = "Close must clear the far edge by this much before a break is even considered. Kills the single-tick stop-run kill that v1 suffered from.")
breakConfirm  = input.int(2, "Break confirmation bars", minval = 1, maxval = 10, group = grpBreak,
     tooltip = "Consecutive closes beyond the buffered edge required to confirm a break.")
breakVolMult  = input.float(1.0, "Break volume requirement (x average)", minval = 0.0, maxval = 4.0, step = 0.1, group = grpBreak,
     tooltip = "Relative volume required on at least one bar of the break. 0 disables the volume filter.")
holdAtr       = input.float(0.35, "Hold confirmation (x ATR away)", minval = 0.05, maxval = 3.0, step = 0.05, group = grpBreak,
     tooltip = "After touching a zone, price must retreat this far from it to score the test as HELD.")
resolveBars   = input.int(20, "Test resolution window (bars)", minval = 3, maxval = 200, group = grpBreak,
     tooltip = "A test that neither holds nor breaks inside this window is scored as UNRESOLVED and contributes no evidence.")
testCooldown  = input.int(5, "Bars between separate tests", minval = 0, maxval = 100, group = grpBreak)
maxFlips      = input.int(2, "Retire after N polarity flips", minval = 1, maxval = 6, group = grpBreak,
     tooltip = "A broken zone flips role (resistance <-> support) instead of being blacklisted. After this many flips the level is considered noise and retired.")
flipDecay     = input.float(0.55, "Evidence kept through a flip", minval = 0.1, maxval = 1.0, step = 0.05, group = grpBreak)

// --- Scoring weights ------------------------------------------------
wCount   = input.float(1.0, "Weight · pivot count",       minval = 0, maxval = 3, step = 0.1, group = grpScore)
wVol     = input.float(1.2, "Weight · relative volume",   minval = 0, maxval = 3, step = 0.1, group = grpScore)
wWick    = input.float(0.8, "Weight · rejection wick",    minval = 0, maxval = 3, step = 0.1, group = grpScore)
wImp     = input.float(1.0, "Weight · post-pivot impulse",minval = 0, maxval = 3, step = 0.1, group = grpScore,
     tooltip = "How violently price left the level after it printed. The single most predictive pivot feature and the one v1 had no notion of.")
wTight   = input.float(0.7, "Weight · cluster tightness",  minval = 0, maxval = 3, step = 0.1, group = grpScore)
wRecent  = input.float(0.8, "Weight · recency",            minval = 0, maxval = 3, step = 0.1, group = grpScore)
wHVN     = input.float(1.0, "Weight · volume-profile node",minval = 0, maxval = 3, step = 0.1, group = grpScore)
wHTF     = input.float(0.9, "Weight · higher-TF confluence",minval = 0, maxval = 3, step = 0.1, group = grpScore)
wRound   = input.float(0.3, "Weight · round number",       minval = 0, maxval = 3, step = 0.1, group = grpScore)
wPrior   = input.float(1.5, "Weight · volumetric prior",   minval = 0, maxval = 4, step = 0.1, group = grpScore,
     tooltip = "The a-priori field score. This is the only feature that can carry a zone on its own, before any pivot or any touch exists.")

logitK   = input.float(4.2, "Prior sharpness", minval = 0.5, maxval = 12.0, step = 0.2, group = grpScore,
     tooltip = "How strongly the feature score is converted into log-odds. Higher = more opinionated priors.")
logitMid = input.float(0.42, "Prior neutral point", minval = 0.1, maxval = 0.9, step = 0.02, group = grpScore,
     tooltip = "Feature score that maps to a 50/50 prior.")
evW      = input.float(0.9, "Evidence weight", minval = 0.0, maxval = 3.0, step = 0.1, group = grpScore,
     tooltip = "How much realised held/broke outcomes on THIS level move the probability. 0 = pure feature model.")
evAlpha  = input.float(1.0, "Evidence smoothing (Laplace alpha)", minval = 0.25, maxval = 5.0, step = 0.25, group = grpScore)

// --- Volumetric occupancy grid --------------------------------------
volEnable = input.bool(true, "Use volumetric prior field", group = grpVol,
     tooltip = "Maintains an ego-shifting occupancy grid of volume, signed delta, time-at-price and unconsumed inventory. This is what lets a zone be found BEFORE price ever touches it.")
gridBins  = input.int(120, "Grid bins", minval = 40, maxval = 200, group = grpVol,
     tooltip = "Resolution of the price grid. The grid follows price and shifts by whole bins, so state is never lost to a rebuild.")
binAtr    = input.float(0.22, "Bin height (x ATR)", minval = 0.05, maxval = 1.0, step = 0.01, group = grpVol)
fieldEvery= input.int(5, "Field refresh (bars)", minval = 1, maxval = 50, group = grpVol)
fieldHalf = input.int(900, "Field half-life (bars)", minval = 100, maxval = 20000, group = grpVol,
     tooltip = "Old structure fades. Set long on daily charts, short on intraday.")
revisitGap= input.int(6, "Bars away before a return counts as a revisit", minval = 1, maxval = 100, group = grpVol)
fuelBurn  = input.float(1.0, "Inventory burn rate", minval = 0.1, maxval = 4.0, step = 0.1, group = grpVol,
     tooltip = "How fast a revisit consumes the inventory stored at a price. A revisit trading as much volume as was originally stored burns about 63% of it at 1.0.")
trapK     = input.float(1.5, "Trapped-pain scale (x ATR)", minval = 0.2, maxval = 6.0, step = 0.1, group = grpVol,
     tooltip = "How far underwater a cohort must be before it counts as fully trapped.")
voidSpan  = input.int(3, "Void adjacency span (bins)", minval = 1, maxval = 12, group = grpVol,
     tooltip = "A shelf sitting next to a volume vacuum reacts harder than one buried inside balanced trade.")

wShelf    = input.float(1.0, "Field weight - shelf (volume node)", minval = 0, maxval = 3, step = 0.1, group = grpVol)
wVelW     = input.float(1.2, "Field weight - velocity (volume per bar)", minval = 0, maxval = 3, step = 0.1, group = grpVol,
     tooltip = "Size traded FAST at a price is an aggressive footprint. The same volume accumulated slowly is drift. Plain volume profiles cannot tell them apart.")
wTrapW    = input.float(1.6, "Field weight - trapped inventory", minval = 0, maxval = 3, step = 0.1, group = grpVol,
     tooltip = "Signed volume left underwater. The core a-priori term: a known cohort with a known pain price that has not yet had its chance to get out.")
wVoidW    = input.float(0.8, "Field weight - void adjacency", minval = 0, maxval = 3, step = 0.1, group = grpVol)

// --- Context --------------------------------------------------------

htfEnable = input.bool(true, "Use higher-timeframe confluence", group = grpCtx)
htfInput  = input.timeframe("", "Higher timeframe (blank = auto)", group = grpCtx)
htfL      = input.int(8, "HTF left bars",  minval = 2, maxval = 30, group = grpCtx)
htfR      = input.int(4, "HTF right bars", minval = 2, maxval = 30, group = grpCtx)
htfTolAtr = input.float(0.8, "HTF match tolerance (x ATR)", minval = 0.1, maxval = 3.0, step = 0.1, group = grpCtx)

roundEnable = input.bool(true, "Use round-number magnetism", group = grpCtx)

// --- Zone of Interest -----------------------------------------------
zoiEnable = input.bool(true, "Enable Zone of Interest highlight", group = grpZOI)
zoiPriorMin = input.float(0.55, "Minimum volumetric prior", minval = 0.1, maxval = 0.98, step = 0.01, group = grpZOI,
     tooltip = "The pre-touch gate. Computed entirely from the occupancy grid, so it needs no pivot, no touch and no outcome history.")
zoiFuelMin  = input.float(0.60, "Minimum unconsumed inventory (fuel)", minval = 0.1, maxval = 1.0, step = 0.05, group = grpZOI,
     tooltip = "A level's charge. Every revisit burns some; once spent, the zone is retired even though it was never formally 'tested'.")
zoiMinDist  = input.float(1.0, "Minimum distance from price (x ATR)", minval = 0.0, maxval = 10.0, step = 0.25, group = grpZOI,
     tooltip = "A zone is only a forward-looking target if price is not already in it.")
zoiSeed     = input.bool(true, "Seed zones from the field with no pivot", group = grpZOI,
     tooltip = "The whole point. A level can be published purely because volume structure says inventory is stranded there, with zero swing highs or lows to support it.")
zoiMaxTests = input.int(1, "Maximum resolved tests", minval = 0, maxval = 6, group = grpZOI)
zoiQuiet  = input.int(20, "Minimum bars since last touch", minval = 0, maxval = 400, group = grpZOI)
approachAtr = input.float(1.5, "Approach warning distance (x ATR)", minval = 0.25, maxval = 8.0, step = 0.25, group = grpZOI,
     tooltip = "Fires the pre-touch alert while price is still this far away and closing.")
reactAtr    = input.float(0.8, "Reaction required to score a prior HIT (x ATR)", minval = 0.2, maxval = 4.0, step = 0.1, group = grpZOI)
reactBars   = input.int(15, "Bars allowed for the reaction", minval = 3, maxval = 120, group = grpZOI)
zoiGlowCol= input.color(#DEB887, "Glow color", group = grpZOI)
zoiBorderW= input.int(2, "Glow border width", minval = 1, maxval = 4, group = grpZOI)
zoiLabel  = input.bool(true, "Show 'ZOI' tag", group = grpZOI)

// --- Style ----------------------------------------------------------
useThemeColors = input.bool(true, "Use theme colors", group = grpStyle)
resColorIn = input.color(color.rgb(244, 67, 79),  "Resistance color (manual)", group = grpStyle)
supColorIn = input.color(color.rgb(38, 166, 154), "Support color (manual)",    group = grpStyle)
showLabels = input.bool(true,  "Show zone label", group = grpStyle)
showProb   = input.bool(true,  "Show P(hold) in label", group = grpStyle)
showVolText= input.bool(true,  "Show volume in label", group = grpStyle)
singleLine = input.bool(false, "Single line label", group = grpStyle)
zoneOpacity= input.int(84, "Base zone opacity", minval = 55, maxval = 96, group = grpStyle,
     tooltip = "Opacity of the weakest drawn zone. Stronger zones become progressively more solid, driven by calibrated probability rather than raw volume.")
showHistory= input.bool(false, "Show retired zones", group = grpStyle)
showFlips  = input.bool(true,  "Mark polarity flips", group = grpStyle)
showTests  = input.bool(false, "Mark resolved tests", group = grpStyle)
brokenBull = input.color(color.rgb(105, 140, 125), "Retired support color", group = grpStyle)
brokenBear = input.color(color.rgb(165, 105, 110), "Retired resistance color", group = grpStyle)
brokenOp   = input.int(88, "Retired zone opacity", minval = 30, maxval = 95, group = grpStyle)

// --- Dashboard ------------------------------------------------------
showDash   = input.bool(true, "Show dashboard", group = grpDash)
dashPosStr = input.string("Top Right", "Dashboard position",
     options = ["Top Right","Top Left","Top Center","Middle Right","Middle Left","Middle Center","Bottom Right","Bottom Left","Bottom Center"], group = grpDash)
dashSizeStr= input.string("Small", "Dashboard text size",
     options = ["Tiny","Small","Normal","Large","Huge"], group = grpDash)
showCalib  = input.bool(true, "Show reliability (predicted vs realised)", group = grpDash,
     tooltip = "Shadow-mode validation. Every resolved test is logged into the probability bucket it was predicted from, and the panel reports how often those predictions actually held. If predicted and realised drift apart, the model is miscalibrated on this symbol and you should trust the stars less.")


// =====================================================================
//  SECTION 2 - PALETTE
// =====================================================================
const color C_BULL   = #8FBC8F
const color C_BEAR   = #A0522D
const color C_ACCENT = #DEB887
const color C_BG     = #2E8B57
const color C_FRAME  = #1F4A38

color resColor = useThemeColors ? C_BEAR : resColorIn
color supColor = useThemeColors ? C_BULL : supColorIn


// =====================================================================
//  SECTION 3 - PURE HELPERS
// =====================================================================
f_clampF(float x, float lo, float hi) => math.max(lo, math.min(hi, x))
f_clampI(int   x, int   lo, int   hi) => math.max(lo, math.min(hi, x))

// Saturating 0..1 transfer. k is the value at which the feature reaches ~63%.
f_sat(float x, float k) =>
    v = na(x) or x <= 0 ? 0.0 : x
    kk = k <= 0 ? 1.0 : k
    1.0 - math.exp(-v / kk)

f_sigmoid(float z) =>
    zz = f_clampF(z, -30.0, 30.0)
    1.0 / (1.0 + math.exp(-zz))

// Interval intersection-over-union in price space (the NMS metric).
f_iou(float aLo, float aHi, float bLo, float bHi) =>
    inter = math.max(0.0, math.min(aHi, bHi) - math.max(aLo, bLo))
    uni   = math.max(aHi, bHi) - math.min(aLo, bLo)
    uni <= 0 ? 0.0 : inter / uni

strToPos(string s) =>
    switch s
        "Top Right"     => position.top_right
        "Top Left"      => position.top_left
        "Top Center"    => position.top_center
        "Bottom Right"  => position.bottom_right
        "Bottom Left"   => position.bottom_left
        "Bottom Center" => position.bottom_center
        "Middle Right"  => position.middle_right
        "Middle Left"   => position.middle_left
        "Middle Center" => position.middle_center
        =>                 position.top_right

strToSize(string s) =>
    switch s
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        "Huge"   => size.huge
        =>          size.small

formatVolume(float v) =>
    string o = ""
    if na(v)
        o := "-"
    else if v >= 1e9
        o := str.tostring(v / 1e9, "#.##") + "B"
    else if v >= 1e6
        o := str.tostring(v / 1e6, "#.##") + "M"
    else if v >= 1e3
        o := str.tostring(v / 1e3, "#.##") + "K"
    else
        o := str.tostring(v, "#.##")
    o

// Absolute star bands. v1 rated relative to the strongest zone on screen,
// so a chart of nothing but junk still showed three stars.
probStars(float p) =>
    na(p) ? "-" : p >= 0.70 ? "★★★" : p >= 0.55 ? "★★" : "★"

safeStartBar(int b) =>
    minSafe = bar_index - 4800
    na(b) ? bar_index : (b < minSafe ? minSafe : b)

distancePct(float centerPx, float refPx) =>
    refPx == 0.0 or na(refPx) or na(centerPx) ? na : math.abs(centerPx - refPx) / refPx * 100.0


// =====================================================================
//  SECTION 4 - CONTEXT: volatility regime, volume availability, presets
// =====================================================================
int tfSec = timeframe.in_seconds()

atrSlow = ta.atr(50)
atrFast = ta.atr(14)
volSma  = ta.sma(volume, 50)

// Does this instrument actually report volume? Forex/CFD/index feeds often
// do not, and v1 silently degraded to "every pivot weighs 1.0" while still
// advertising a volume-based score.
bool volFeedOk = not na(volSma) and volSma > 0

// Fallback participation proxy when there is no volume: normalised true range.
float partNow  = volFeedOk ? volume : (high - low)
float partBase = volFeedOk ? volSma : ta.sma(high - low, 50)

// Volatility regime, used to widen/tighten the tracker in fast markets.
float atrPct    = close > 0 and not na(atrSlow) ? atrSlow / close * 100.0 : na
float regimeRat = not na(atrFast) and not na(atrSlow) and atrSlow > 0 ? atrFast / atrSlow : 1.0
string regimeTxt = na(regimeRat) ? "-" : regimeRat > 1.25 ? "Expanding" : regimeRat < 0.8 ? "Compressing" : "Neutral"

// --- Auto preset: scale the detector to the chart's bar rate ---------
int   autoLeft  = tfSec <= 300 ? 6   : tfSec <= 3600 ? 10  : tfSec <= 14400 ? 14 : 20
int   autoRight = tfSec <= 300 ? 3   : tfSec <= 3600 ? 5   : tfSec <= 14400 ? 7  : 10
float autoTol   = tfSec <= 300 ? 0.45: tfSec <= 3600 ? 0.65: tfSec <= 14400 ? 0.85: 1.1
int   autoSpace = tfSec <= 300 ? 6   : tfSec <= 3600 ? 12  : tfSec <= 14400 ? 18 : 30

int pivLeft    = preset == "Auto" ? autoLeft  : preset == "Scalp" ? 4   : preset == "Local" ? 6   : preset == "Swing" ? 15  : preset == "Major" ? 35  : pivLeftIn
int pivRight   = preset == "Auto" ? autoRight : preset == "Scalp" ? 2   : preset == "Local" ? 4   : preset == "Swing" ? 8   : preset == "Major" ? 15  : pivRightIn
float clusterTol = preset == "Auto" ? autoTol : preset == "Scalp" ? 0.4 : preset == "Local" ? 0.5 : preset == "Swing" ? 0.9 : preset == "Major" ? 1.4 : clusterTolIn
int minSpacing = preset == "Auto" ? autoSpace : preset == "Scalp" ? 4   : preset == "Local" ? 8   : preset == "Swing" ? 20  : preset == "Major" ? 50  : minSpacingIn

// Recency half-life scaled to the detector, not a hardcoded 200 bars.
float decayBars = math.max(60.0, pivLeft * 18.0)

bool dataReady = not na(atrSlow) and atrSlow > 0
bool barOk     = confirmBarsOnly ? barstate.isconfirmed : true
float atrRef   = nz(atrSlow, 0.0)


// =====================================================================
//  SECTION 5 - VOLUMETRIC PRIOR FIELD  (ego-shifting occupancy grid)
// ---------------------------------------------------------------------
//  This is the a-priori engine. It answers "where will price react?"
//  without waiting for price to go there, so a Zone of Interest can be
//  published BEFORE its first touch.
//
//  The insight it is built on: an untested level is not interesting
//  because of its geometry. It is interesting because a known cohort of
//  participants is stranded there. Volume tells you they exist, signed
//  delta tells you which side they are on, and the distance price has
//  since travelled tells you how much pain they are in. None of that
//  requires a retest - it is all already in the tape.
//
//  Structure: a fixed-resolution price grid that FOLLOWS price. When
//  price approaches an edge the grid shifts by whole bins and the state
//  slides with it, so nothing is lost to a rebuild. (A rolling volume
//  profile throws its accumulated state away every refresh; that is why
//  it can only ever describe the past, never carry a charge forward.)
//
//  Per bin the grid carries:
//    vol   total volume traded at that price
//    dlt   signed volume (Chaikin close-location proxy for delta)
//    bars  time spent at that price
//    fuel  fraction of stored inventory NOT yet worked off
//    last  bar index of the most recent visit
// =====================================================================
var array<float> gVol   = array.new<float>(gridBins, 0.0)
var array<float> gDlt   = array.new<float>(gridBins, 0.0)
var array<float> gBars  = array.new<float>(gridBins, 0.0)
var array<float> gFuel  = array.new<float>(gridBins, 1.0)
var array<float> gLast  = array.new<float>(gridBins, 0.0)
var array<float> gPrior = array.new<float>(gridBins, 0.0)
var array<float> gTrapD = array.new<float>(gridBins, 0.0)

var float gLo    = na
var float gBinW  = na
var float gAtr0  = na
var float gVolMax = 0.0

binMid(int b) => gLo + (b + 0.5) * gBinW
binOf(float px) => f_clampI(int(math.floor((px - gLo) / gBinW)), 0, gridBins - 1)

// --- Grid initialisation ---------------------------------------------
if volEnable and dataReady and na(gLo)
    gBinW := atrRef * binAtr
    gLo   := close - (gridBins / 2.0) * gBinW
    gAtr0 := atrRef

// --- Ego shift: keep price near the centre, slide state by whole bins.
//     Integer shifts are lossless, which is the reason for choosing a
//     following grid over a re-binned window.
if volEnable and dataReady and not na(gLo) and gBinW > 0
    float cbf = (close - gLo) / gBinW
    int   sh  = int(math.round(cbf - gridBins / 2.0))
    if math.abs(cbf - gridBins / 2.0) > gridBins / 4.0 and sh != 0
        array<float> cV = gVol.copy()
        array<float> cD = gDlt.copy()
        array<float> cB = gBars.copy()
        array<float> cF = gFuel.copy()
        array<float> cL = gLast.copy()
        for i = 0 to gridBins - 1
            int  src = i + sh
            bool ok  = src >= 0 and src <= gridBins - 1
            gVol.set(i,  ok ? cV.get(src) : 0.0)
            gDlt.set(i,  ok ? cD.get(src) : 0.0)
            gBars.set(i, ok ? cB.get(src) : 0.0)
            gFuel.set(i, ok ? cF.get(src) : 1.0)
            gLast.set(i, ok ? cL.get(src) : 0.0)
        gLo := gLo + sh * gBinW

// --- Rescale: a large volatility regime change makes the bin height
//     wrong. Resample nearest into new geometry rather than discarding.
if volEnable and dataReady and not na(gLo) and not na(gAtr0) and gAtr0 > 0 and atrRef > 0
    float ratio = atrRef / gAtr0
    if ratio > 2.5 or ratio < 0.4
        float nBinW = atrRef * binAtr
        float nLo   = close - (gridBins / 2.0) * nBinW
        array<float> cV = gVol.copy()
        array<float> cD = gDlt.copy()
        array<float> cB = gBars.copy()
        array<float> cF = gFuel.copy()
        array<float> cL = gLast.copy()
        for i = 0 to gridBins - 1
            float mid = nLo + (i + 0.5) * nBinW
            int   oi  = int(math.floor((mid - gLo) / gBinW))
            bool  ok  = oi >= 0 and oi <= gridBins - 1
            gVol.set(i,  ok ? cV.get(oi) : 0.0)
            gDlt.set(i,  ok ? cD.get(oi) : 0.0)
            gBars.set(i, ok ? cB.get(oi) : 0.0)
            gFuel.set(i, ok ? cF.get(oi) : 1.0)
            gLast.set(i, ok ? cL.get(oi) : 0.0)
        gLo   := nLo
        gBinW := nBinW
        gAtr0 := atrRef

// --- Accumulation -----------------------------------------------------
//  Signed volume uses the Chaikin close-location value as a delta proxy:
//    clv = ((close-low) - (high-close)) / (high-low)   in [-1, 1]
//  Closing at the high of a bar means buyers won the bar; that is the
//  best directional read available without tick data, and it is enough,
//  because what matters here is the SIGN of a large cohort, not its
//  exact size.
if volEnable and dataReady and barOk and not na(gLo) and gBinW > 0
    float rng = high - low
    float clv = rng > 0 ? ((close - low) - (high - close)) / rng : 0.0
    float vBar = nz(volFeedOk ? volume : rng, 0.0)
    int   bLoI = binOf(low)
    int   bHiI = binOf(high)
    int   span = math.max(1, bHiI - bLoI + 1)
    float vPer = vBar / span
    float dPer = vBar * clv / span
    for b = bLoI to bHiI
        float prev = gVol.get(b)
        // Fuel is only burned by a genuine RETURN, not by contiguous
        // accumulation while price is already parked here.
        if prev > 0 and (bar_index - gLast.get(b)) > revisitGap
            gFuel.set(b, gFuel.get(b) * math.exp(-fuelBurn * vPer / math.max(prev, 1e-9)))
        gVol.set(b,  prev + vPer)
        gDlt.set(b,  gDlt.get(b) + dPer)
        gBars.set(b, gBars.get(b) + 1.0)
        gLast.set(b, bar_index)

// --- Global fade: structure has a half-life. Applied in blocks so the
//     per-bar cost stays near zero.
if volEnable and dataReady and barOk and bar_index % 10 == 0 and not na(gLo)
    float k = math.pow(0.5, 10.0 / fieldHalf)
    for b = 0 to gridBins - 1
        gVol.set(b,  gVol.get(b)  * k)
        gDlt.set(b,  gDlt.get(b)  * k)
        gBars.set(b, gBars.get(b) * k)

// --- Field evaluation -------------------------------------------------
//  Four terms, all computable with zero touches:
//
//   shelf     normalised volume at price. Inventory exists here.
//   velocity  volume per bar. Size traded FAST is an aggressive
//             footprint; the same volume accrued slowly is drift. A
//             plain volume profile cannot separate them.
//   trapped   |signed delta| scaled by how far underwater that side now
//             is. The core prior. Buyers stranded above price will sell
//             into a return; sellers stranded below will buy one back.
//   void      a shelf sitting beside a volume vacuum. Price has nothing
//             to lean on in the gap, so it arrives at the shelf fast.
//
//  Everything is multiplied by fuel, so a level that has already been
//  worked off scores near zero even if its raw volume is still large.
if volEnable and dataReady and not na(gLo) and gBinW > 0 and (bar_index % fieldEvery == 0 or barstate.islast)
    array<float> nv  = array.new<float>(gridBins, 0.0)
    array<float> nvl = array.new<float>(gridBins, 0.0)
    array<float> ntr = array.new<float>(gridBins, 0.0)
    float mV  = 0.0
    float mVl = 0.0
    float mTr = 0.0
    for b = 0 to gridBins - 1
        float v   = gVol.get(b)
        float ba  = math.max(1.0, gBars.get(b))
        float vl  = v / ba
        float D   = gDlt.get(b)
        float mid = binMid(b)
        float adv = D > 0 ? math.max(0.0, mid - close) : D < 0 ? math.max(0.0, close - mid) : 0.0
        float tr  = math.abs(D) * f_sat(atrRef > 0 ? adv / atrRef : 0.0, trapK)
        nv.set(b, v)
        nvl.set(b, vl)
        ntr.set(b, tr)
        gTrapD.set(b, D > 0 ? 1.0 : D < 0 ? -1.0 : 0.0)
        mV  := math.max(mV,  v)
        gVolMax := mV
        mVl := math.max(mVl, vl)
        mTr := math.max(mTr, tr)
    for b = 0 to gridBins - 1
        nv.set(b,  mV  > 0 ? nv.get(b)  / mV  : 0.0)
        nvl.set(b, mVl > 0 ? nvl.get(b) / mVl : 0.0)
        ntr.set(b, mTr > 0 ? ntr.get(b) / mTr : 0.0)
    float sumFW = math.max(1e-9, wShelf + wVelW + wTrapW + wVoidW)
    for b = 0 to gridBins - 1
        float emptiest = 0.0
        int   kLo = f_clampI(b - voidSpan, 0, gridBins - 1)
        int   kHi = f_clampI(b + voidSpan, 0, gridBins - 1)
        for k = kLo to kHi
            emptiest := math.max(emptiest, 1.0 - nv.get(k))
        // Void adjacency only counts for a bin that is itself a shelf -
        // the tradable object is the EDGE of the vacuum, not the vacuum.
        float voidTerm = emptiest * nv.get(b)
        float raw = (wShelf * nv.get(b) + wVelW * nvl.get(b) + wTrapW * ntr.get(b) + wVoidW * voidTerm) / sumFW
        gPrior.set(b, f_clampF(raw * gFuel.get(b), 0.0, 1.0))

// --- Field accessors --------------------------------------------------
fieldReady() => volEnable and not na(gLo) and not na(gBinW) and gBinW > 0

// Smoothed shelf score, the direct replacement for the old HVN lookup.
hvnAt(float px) =>
    float outv = 0.0
    if fieldReady() and not na(px) and gVolMax > 0
        int b  = binOf(px)
        int bm = f_clampI(b - 1, 0, gridBins - 1)
        int bp = f_clampI(b + 1, 0, gridBins - 1)
        float v = gVol.get(b) * 0.5 + gVol.get(bm) * 0.25 + gVol.get(bp) * 0.25
        outv := f_clampF(v / gVolMax, 0.0, 1.0)
    outv

vpriorAt(float px) =>
    float outv = 0.0
    if fieldReady() and not na(px)
        int b  = binOf(px)
        int bm = f_clampI(b - 1, 0, gridBins - 1)
        int bp = f_clampI(b + 1, 0, gridBins - 1)
        outv := f_clampF(gPrior.get(b) * 0.5 + gPrior.get(bm) * 0.25 + gPrior.get(bp) * 0.25, 0.0, 1.0)
    outv

fuelAt(float px) => fieldReady() and not na(px) ? gFuel.get(binOf(px)) : 1.0

// Predicted role on return, straight from which side is stranded:
//  +1  buyers trapped above -> they sell into a return -> RESISTANCE
//  -1  sellers trapped below -> they buy a return back  -> SUPPORT
//   0  balanced, no directional prediction
trapDirAt(float px) => fieldReady() and not na(px) ? int(gTrapD.get(binOf(px))) : 0

// Half-width from the shelf's own extent: walk out from the peak while
// the field stays above half its peak value (a full-width-half-maximum
// read). Gives a volumetric zone a measured thickness, exactly as the
// pivot zones get theirs from member dispersion.
shelfHalfW(int b) =>
    float half = 0.0
    if fieldReady()
        float pk = gPrior.get(b)
        int   lo = b
        int   hi = b
        if pk > 0
            for k = 1 to 12
                int li = b - k
                if li >= 0 and gPrior.get(li) >= pk * 0.5
                    lo := li
                else
                    break
            for k = 1 to 12
                int hi2 = b + k
                if hi2 <= gridBins - 1 and gPrior.get(hi2) >= pk * 0.5
                    hi := hi2
                else
                    break
        half := math.max(1.0, (hi - lo + 1) / 2.0) * gBinW
    half


// =====================================================================
//  SECTION 6 - CONTEXT LAYER B: higher-timeframe confluence
// =====================================================================
string autoHtf = tfSec <= 60 ? "15" : tfSec <= 300 ? "60" : tfSec <= 900 ? "240" : tfSec <= 3600 ? "D" : tfSec <= 14400 ? "D" : tfSec <= 86400 ? "W" : "M"
string htfPick = htfInput == "" ? autoHtf : htfInput
string htfTf   = timeframe.in_seconds(htfPick) >= tfSec ? htfPick : autoHtf

[htfPH, htfPL] = request.security(syminfo.tickerid, htfTf,
     [ta.pivothigh(high, htfL, htfR), ta.pivotlow(low, htfL, htfR)],
     lookahead = barmerge.lookahead_off)

var array<float> htfLevels = array.new<float>()

pushHtf(float px) =>
    bool added = false
    if htfEnable and not na(px) and px > 0
        bool dup = false
        if htfLevels.size() > 0
            float tol = nz(atrSlow, 0.0) * 0.25
            for i = 0 to htfLevels.size() - 1
                if math.abs(htfLevels.get(i) - px) <= tol
                    dup := true
                    break
        if not dup
            htfLevels.push(px)
            if htfLevels.size() > 40
                htfLevels.shift()
            added := true
    added

if barstate.isconfirmed
    bool _pH = pushHtf(htfPH)
    bool _pL = pushHtf(htfPL)

// 1.0 on an exact HTF level, decaying linearly to 0 at the tolerance edge.
htfConfAt(float px) =>
    float best = 0.0
    if htfEnable and htfLevels.size() > 0 and not na(px)
        float tol = nz(atrSlow, 0.0) * htfTolAtr
        if tol > 0
            for i = 0 to htfLevels.size() - 1
                float d = math.abs(htfLevels.get(i) - px)
                if d <= tol
                    best := math.max(best, 1.0 - d / tol)
    best


// =====================================================================
//  SECTION 7 - CONTEXT LAYER C: round-number magnetism
// =====================================================================
roundScoreAt(float px) =>
    float outv = 0.0
    if roundEnable and not na(px) and px > 0 and not na(atrSlow) and atrSlow > 0
        float mag  = math.pow(10.0, math.floor(math.log10(px)))
        float step = mag / 4.0
        if step > 0
            float d   = math.abs(px - math.round(px / step) * step)
            float tol = atrSlow * 0.35
            outv := tol > 0 ? f_clampF(1.0 - d / tol, 0.0, 1.0) : 0.0
    outv


// =====================================================================
//  SECTION 8 - PERCEPTION: pivot detection with a feature vector
// ---------------------------------------------------------------------
//  Every detection carries the volatility of its OWN bar. v1 clustered
//  ten-year-old pivots using today's ATR, so a level formed in a quiet
//  regime got re-measured with a wide ruler after a volatility expansion
//  (and vice versa). Scale must travel with the measurement.
// =====================================================================
int pr1 = math.max(1, pivRight)

phPx = ta.pivothigh(high, pivLeft, pivRight)
plPx = ta.pivotlow(low,   pivLeft, pivRight)

float atrAtPiv = nz(atrSlow[pr1], atrSlow)

// Participation over a 3-bar window centred on the pivot, normalised by the
// baseline as it stood THEN. v1 used a single bar's raw volume.
float partWin  = nz(partNow[pr1 + 1], 0.0) + nz(partNow[pr1], 0.0) + nz(partNow[pr1 - 1], 0.0)
float partRef  = nz(partBase[pr1], 0.0) * 3.0
float relVolPv = partRef > 0 ? partWin / partRef : 1.0

float upWickPv = nz(high[pr1] - math.max(open[pr1], close[pr1]), 0.0)
float dnWickPv = nz(math.min(open[pr1], close[pr1]) - low[pr1], 0.0)

// Post-pivot impulse: how hard price left the level over the confirmation
// window, in ATR units. This is the feature that separates a level price
// fled from (real) from a level price drifted past (noise). v1 had nothing
// equivalent - it scored the candle, never the reaction.
float awayLow  = ta.lowest(low,   pr1)
float awayHigh = ta.highest(high, pr1)


// =====================================================================
//  SECTION 9 - TRACK MODEL
// ---------------------------------------------------------------------
//  A level is a persistent object with its own state, not a row that gets
//  wiped and re-derived on every pivot. Role (support vs resistance) is a
//  DERIVED property of where price currently sits, so a broken resistance
//  becomes a tracked support automatically instead of being blacklisted.
// =====================================================================
type Zone
    int   id
    float center
    float halfW
    float m2         // weighted sum of squared deviations (Welford)
    float wsum       // total member weight
    int   hits       // distinct touch events that seeded it
    int   firstBar
    int   confBar
    int   lastPivBar
    int   lastTouch
    float volSum
    float fVol       // weighted mean relative volume
    float fWick      // weighted mean wick / ATR
    float fImp       // weighted mean post-pivot impulse / ATR
    bool  isRes      // derived each bar
    int   tState     // 0 idle, 1 test in progress
    int   tStart
    int   brkRun
    bool  tFromBelow
    bool  tVolOk
    float tProb      // probability predicted at the moment the test began
    int   nHeldRes
    int   nBrokeRes
    int   nHeldSup
    int   nBrokeSup
    int   nUnres
    int   realTouch
    int   lastTestBar
    bool  alive
    int   diedBar
    bool  wasBroken
    int   flips
    int   lastFlipBar
    float score
    float prob
    bool  isZOI
    int   zoiSince
    float hvn
    float htf
    float rnd
    float vprior     // volumetric prior, 0..1, computed with zero touches
    float fuel       // unconsumed stored inventory, 0..1
    int   predDir    // +1 expect resistance on return, -1 expect support
    bool  srcVol     // born from the field, not from a pivot
    bool  armed      // flagged as a pre-touch target
    int   armBar
    int   evState    // 0 idle, 1 awaiting the verdict on a pre-touch call
    int   evStart

var array<Zone> pool   = array.new<Zone>()
var array<int>  idReg  = array.new<int>(1, 0)

// Reliability diagram: five predicted-probability buckets, each counting
// how many tests were logged and how many actually held.
var array<int> calN   = array.new<int>(5, 0)
var array<int> calHit = array.new<int>(5, 0)

// Quality weight of a single detection. Bounded so one freak candle cannot
// dominate a level's entire state.
pivWeight(float relVol, float wickR, float imp) =>
    float w = 0.5 + nz(relVol, 1.0) * 0.5 + f_clampF(nz(wickR, 0.0), 0.0, 3.0) * 0.3 + f_clampF(nz(imp, 0.0), 0.0, 6.0) * 0.3
    f_clampF(w, 0.2, 4.0)

// Recompute the drawn width from the dispersion of the level's own members,
// clamped into a sane ATR band. Tight agreement draws a thin zone; a smeared
// cluster honestly draws a wide one. v1 gave every zone the same 0.5*ATR box.
refreshWidth(Zone z, float atrRef) =>
    float v  = z.wsum > 0 ? math.max(0.0, z.m2 / z.wsum) : 0.0
    float sd = math.sqrt(v)
    float lo = minPadAtr * atrRef
    float hi = math.max(lo, maxPadAtr * atrRef)
    z.halfW := f_clampF(kSigma * sd, lo, hi)
    z.halfW

mkZone(float px, int bar, int cbar, float atrAt, float relVol, float wickR, float imp, float rawVol) =>
    int nid = idReg.get(0) + 1
    idReg.set(0, nid)
    float w = pivWeight(relVol, wickR, imp)
    Zone z = Zone.new(id = nid, center = px, halfW = minPadAtr * atrAt, m2 = 0.0, wsum = w,
         hits = 1, firstBar = bar, confBar = cbar, lastPivBar = bar, lastTouch = na,
         volSum = nz(rawVol, 0.0), fVol = nz(relVol, 1.0), fWick = nz(wickR, 0.0), fImp = nz(imp, 0.0),
         isRes = px > close, tState = 0, tStart = na, brkRun = 0, tFromBelow = false, tVolOk = false, tProb = na,
         nHeldRes = 0, nBrokeRes = 0, nHeldSup = 0, nBrokeSup = 0, nUnres = 0, realTouch = 0, lastTestBar = na,
         alive = true, diedBar = na, wasBroken = false, flips = 0, lastFlipBar = na,
         score = 0.0, prob = 0.5, isZOI = false, zoiSince = na, hvn = 0.0, htf = 0.0, rnd = 0.0,
         vprior = 0.0, fuel = 1.0, predDir = 0, srcVol = false, armed = false, armBar = na,
         evState = 0, evStart = na)
    float _w0 = refreshWidth(z, atrAt)
    z

// Recursive weighted-mean + Welford variance update. O(1) per detection,
// against v1's full O(n^2) re-cluster of the entire pivot buffer.
absorb(Zone z, float px, int bar, float atrRef, float relVol, float wickR, float imp, float rawVol, bool newEvent) =>
    float w     = pivWeight(relVol, wickR, imp)
    float wNew  = z.wsum + w
    float delta = px - z.center
    z.center := z.center + (w / wNew) * delta
    z.m2     := z.m2 + w * delta * (px - z.center)
    z.wsum   := wNew
    z.fVol   := z.fVol + (w / wNew) * (nz(relVol, 1.0) - z.fVol)
    z.fWick  := z.fWick + (w / wNew) * (nz(wickR, 0.0) - z.fWick)
    z.fImp   := z.fImp + (w / wNew) * (nz(imp, 0.0) - z.fImp)
    z.volSum := z.volSum + nz(rawVol, 0.0)
    z.lastPivBar := bar
    if newEvent
        z.hits := z.hits + 1
    float _w1 = refreshWidth(z, atrRef)
    z.center

// Pool insertion with recycling: dead tracks go first, then the weakest
// live one. v1's FIFO shift dropped the OLDEST history regardless of value.
poolAdd(Zone z) =>
    int slot = -1
    if pool.size() < maxTracks
        pool.push(z)
        slot := pool.size() - 1
    else
        int   worst = -1
        float worstV = 1e18
        for i = 0 to pool.size() - 1
            Zone c = pool.get(i)
            float v = c.alive ? (c.prob * 100.0 + c.wsum) : -1.0 * (bar_index - nz(c.diedBar, 0))
            if v < worstV
                worstV := v
                worst := i
        if worst >= 0
            pool.set(worst, z)
            slot := worst
    slot

// Gated nearest-neighbour association. The gate widens with the track's own
// width so a level that legitimately spans a band keeps collecting its
// pivots instead of spawning a duplicate next to itself.
associate(float px, float atrAt) =>
    int   best  = -1
    float bestD = 1e18
    if pool.size() > 0
        for i = 0 to pool.size() - 1
            Zone c = pool.get(i)
            if c.alive
                float gate = math.max(atrAt * clusterTol, c.halfW * 1.5)
                float d    = math.abs(c.center - px)
                if d <= gate and d < bestD
                    bestD := d
                    best  := i
    best

// --- Detection ingest ------------------------------------------------
bool newPivot = false

if dataReady and barOk
    if not na(phPx) and phPx > 0
        float impH = atrAtPiv > 0 ? (phPx - nz(awayLow, phPx)) / atrAtPiv : 0.0
        float wkH  = atrAtPiv > 0 ? upWickPv / atrAtPiv : 0.0
        float rvH  = nz(volFeedOk ? volume[pr1] : (high[pr1] - low[pr1]), 0.0)
        int   idxH = associate(phPx, atrAtPiv)
        if idxH >= 0
            Zone tH = pool.get(idxH)
            bool newEvtH = na(tH.lastPivBar) or (bar_index - pr1 - tH.lastPivBar) >= minSpacing
            float _aH = absorb(tH, phPx, bar_index - pr1, nz(atrSlow, atrAtPiv), relVolPv, wkH, impH, rvH, newEvtH)
        else
            int _sH = poolAdd(mkZone(phPx, bar_index - pr1, bar_index, atrAtPiv, relVolPv, wkH, impH, rvH))
        newPivot := true

    if not na(plPx) and plPx > 0
        float impL = atrAtPiv > 0 ? (nz(awayHigh, plPx) - plPx) / atrAtPiv : 0.0
        float wkL  = atrAtPiv > 0 ? dnWickPv / atrAtPiv : 0.0
        float rvL  = nz(volFeedOk ? volume[pr1] : (high[pr1] - low[pr1]), 0.0)
        int   idxL = associate(plPx, atrAtPiv)
        if idxL >= 0
            Zone tL = pool.get(idxL)
            bool newEvtL = na(tL.lastPivBar) or (bar_index - pr1 - tL.lastPivBar) >= minSpacing
            float _aL = absorb(tL, plPx, bar_index - pr1, nz(atrSlow, atrAtPiv), relVolPv, wkL, impL, rvL, newEvtL)
        else
            int _sL = poolAdd(mkZone(plPx, bar_index - pr1, bar_index, atrAtPiv, relVolPv, wkL, impL, rvL))
        newPivot := true


// =====================================================================
//  SECTION 9b - SEEDING ZONES FROM THE FIELD  (the pre-touch step)
// ---------------------------------------------------------------------
//  A local maximum of the prior field is a level, whether or not a swing
//  high or low ever printed there and whether or not price has ever gone
//  back to it. This is where the indicator stops being reactive: zones
//  are published from volume structure alone, with hits = 0.
//
//  Candidates are suppressed near price - a level you are standing in is
//  not a forward-looking target - and matched against existing tracks
//  first, so a shelf that coincides with a pivot zone reinforces it
//  instead of duplicating it.
// =====================================================================
mkVolZone(float px, float halfIn, float priorIn, float fuelIn, int dirIn) =>
    int nid = idReg.get(0) + 1
    idReg.set(0, nid)
    Zone.new(id = nid, center = px, halfW = halfIn, m2 = 0.0, wsum = 1.0,
         hits = 0, firstBar = bar_index, confBar = bar_index, lastPivBar = bar_index, lastTouch = na,
         volSum = 0.0, fVol = 1.0, fWick = 0.0, fImp = 0.0,
         isRes = px > close, tState = 0, tStart = na, brkRun = 0, tFromBelow = false, tVolOk = false, tProb = na,
         nHeldRes = 0, nBrokeRes = 0, nHeldSup = 0, nBrokeSup = 0, nUnres = 0, realTouch = 0, lastTestBar = na,
         alive = true, diedBar = na, wasBroken = false, flips = 0, lastFlipBar = na,
         score = priorIn, prob = 0.5, isZOI = false, zoiSince = na, hvn = 0.0, htf = 0.0, rnd = 0.0,
         vprior = priorIn, fuel = fuelIn, predDir = dirIn, srcVol = true, armed = false, armBar = na,
         evState = 0, evStart = na)

var int seeded = 0

if volEnable and zoiSeed and dataReady and barOk and fieldReady() and bar_index % fieldEvery == 0
    for b = 2 to gridBins - 3
        float pk = gPrior.get(b)
        if pk >= zoiPriorMin
            // strict local maximum over a 5-bin neighbourhood
            bool isPeak = pk >= gPrior.get(b - 1) and pk >= gPrior.get(b + 1) and pk >= gPrior.get(b - 2) and pk >= gPrior.get(b + 2)
            if isPeak
                float mid = binMid(b)
                if atrRef > 0 and math.abs(mid - close) >= zoiMinDist * atrRef
                    int idx = associate(mid, atrRef)
                    if idx < 0
                        float hw = f_clampF(shelfHalfW(b), minPadAtr * atrRef, maxPadAtr * atrRef * 2.0)
                        int   sl = poolAdd(mkVolZone(mid, hw, pk, gFuel.get(b), trapDirAt(mid)))
                        if sl >= 0
                            seeded := seeded + 1


// =====================================================================
//  SECTION 10 - FUSION: feature prior + outcome evidence -> P(hold)
// ---------------------------------------------------------------------
//  v1's "strength" was a raw weighted sum, and its stars were assigned
//  RELATIVE to the strongest zone currently on screen. A chart containing
//  nothing but weak levels still displayed three stars. Here the score is
//  mapped into log-odds, combined with the level's realised track record
//  through a Laplace-smoothed likelihood ratio, and reported as an
//  absolute probability with fixed star bands.
// =====================================================================
rescore(Zone z) =>
    z.isRes := z.center > close
    z.hvn := hvnAt(z.center)
    z.htf := htfConfAt(z.center)
    z.rnd := roundScoreAt(z.center)
    z.vprior := vpriorAt(z.center)
    z.fuel := fuelAt(z.center)
    int td = trapDirAt(z.center)
    z.predDir := td != 0 ? td : (z.isRes ? 1 : -1)

    float sd     = z.wsum > 0 ? math.sqrt(math.max(0.0, z.m2 / z.wsum)) : 0.0
    float tolAbs = atrRef * clusterTol
    float fTight = tolAbs > 0 ? f_clampF(1.0 - sd / tolAbs, 0.0, 1.0) : 0.5

    int   refBar = int(math.max(nz(z.lastPivBar, z.firstBar), nz(z.lastTouch, nz(z.lastPivBar, z.firstBar))))
    float age    = math.max(0.0, bar_index - refBar)
    float fRec   = 1.0 / (1.0 + age / decayBars)

    // A field-born zone has no pivot geometry to score. Rather than
    // penalising it for evidence that does not apply, the volumetric
    // prior stands in for the three pivot-shape features it replaces.
    bool  hasPiv = z.hits > 0
    float fCount = hasPiv ? f_sat(z.hits - 1, 1.8) : z.vprior
    float fVolS  = volFeedOk ? f_sat(z.fVol, 1.2) : 0.5
    float fWickS = hasPiv ? f_sat(z.fWick, 0.6) : z.vprior
    float fImpS  = hasPiv ? f_sat(z.fImp, 1.5) : z.vprior
    if not hasPiv
        fTight := 0.6
        fVolS  := z.vprior

    float sumW = wCount + wVol + wWick + wImp + wTight + wRecent + wHVN + wHTF + wRound + wPrior
    float acc  = wCount * fCount + wVol * fVolS + wWick * fWickS + wImp * fImpS + wTight * fTight + wRecent * fRec + wHVN * z.hvn + wHTF * z.htf + wRound * z.rnd + wPrior * z.vprior
    z.score := sumW > 0 ? f_clampF(acc / sumW, 0.0, 1.0) : 0.5

    // Evidence for the role the level is currently playing, plus a half
    // weight on the opposite role - a level that never breaks in either
    // direction is genuinely more trustworthy than one that only holds
    // from one side.
    float h = z.isRes ? (z.nHeldRes  + 0.5 * z.nHeldSup)  : (z.nHeldSup  + 0.5 * z.nHeldRes)
    float b = z.isRes ? (z.nBrokeRes + 0.5 * z.nBrokeSup) : (z.nBrokeSup + 0.5 * z.nBrokeRes)
    float evLogit = math.log((h + evAlpha) / (b + evAlpha))

    z.prob := f_sigmoid(logitK * (z.score - logitMid) + evW * evLogit)
    z.prob

// Reliability logging: bucket the prediction that was live when the test
// STARTED, then record what actually happened. This is the whole point -
// a score nobody ever checks is decoration.
calLog(float p, bool hit) =>
    bool done = false
    if not na(p)
        int bIdx = f_clampI(int(p * 5.0), 0, 4)
        calN.set(bIdx, calN.get(bIdx) + 1)
        if hit
            calHit.set(bIdx, calHit.get(bIdx) + 1)
        done := true
    done


// =====================================================================
//  SECTION 11 - DECISION: test / break state machine with hysteresis
// ---------------------------------------------------------------------
//  v1 killed a zone the instant one close printed past its edge. One
//  stop-run wick-and-close destroyed the level permanently, and the level
//  could never come back because it was blacklisted. Here a break needs a
//  buffer, N consecutive confirming closes and (optionally) participation,
//  and a level that does break FLIPS role rather than dying.
// =====================================================================
bool evHeldRes  = false
bool evHeldSup  = false
bool evBrokeRes = false
bool evBrokeSup = false
bool evFlip     = false
bool zoiApproach = false
bool priorHit    = false
bool priorMiss   = false

// Ex-ante ledger for the volumetric prior specifically: how often does a
// zone flagged BEFORE its first touch actually produce a reaction?
var int vpN   = 0
var int vpHit = 0

float relVolNow = nz(partBase, 0.0) > 0 ? nz(partNow, 0.0) / partBase : 1.0
float breakBuf  = atrRef * breakAtr
float holdBuf   = atrRef * holdAtr

if dataReady and barOk and pool.size() > 0
    for i = 0 to pool.size() - 1
        Zone z = pool.get(i)
        if z.alive
            float _p = rescore(z)
            float top = z.center + z.halfW
            float bot = z.center - z.halfW
            bool  inZ = high >= bot and low <= top

            if z.tState == 0
                if inZ and (na(z.lastTestBar) or (bar_index - z.lastTestBar) >= testCooldown)
                    z.tState     := 1
                    z.tStart     := bar_index
                    z.tFromBelow := nz(close[1], close) < z.center
                    z.tProb      := z.prob
                    z.brkRun     := 0
                    z.tVolOk     := breakVolMult <= 0
                if inZ
                    z.lastTouch := bar_index
            else
                if inZ
                    z.lastTouch := bar_index
                if relVolNow >= breakVolMult
                    z.tVolOk := true

                bool beyond = z.tFromBelow ? (close > top + breakBuf) : (close < bot - breakBuf)
                bool back   = z.tFromBelow ? (close < bot - holdBuf)  : (close > top + holdBuf)
                z.brkRun := beyond ? z.brkRun + 1 : 0

                if z.brkRun >= breakConfirm and z.tVolOk
                    // --- BROKEN -------------------------------------
                    z.realTouch := z.realTouch + 1
                    if z.tFromBelow
                        z.nBrokeRes := z.nBrokeRes + 1
                        evBrokeRes  := true
                    else
                        z.nBrokeSup := z.nBrokeSup + 1
                        evBrokeSup  := true
                    bool _cB = calLog(z.tProb, false)
                    z.wasBroken   := true
                    z.flips       := z.flips + 1
                    z.lastFlipBar := bar_index
                    z.lastTestBar := bar_index
                    z.tState      := 0
                    z.brkRun      := 0
                    evFlip        := true
                    // Uncertainty injection: the level survives, but its
                    // history is discounted because its character changed.
                    z.nHeldRes  := int(math.round(z.nHeldRes  * flipDecay))
                    z.nHeldSup  := int(math.round(z.nHeldSup  * flipDecay))
                    z.nBrokeRes := int(math.round(z.nBrokeRes * flipDecay))
                    z.nBrokeSup := int(math.round(z.nBrokeSup * flipDecay))
                    z.wsum      := math.max(0.2, z.wsum * flipDecay)
                    if z.flips > maxFlips
                        z.alive   := false
                        z.diedBar := bar_index
                else if back
                    // --- HELD ---------------------------------------
                    z.realTouch := z.realTouch + 1
                    if z.tFromBelow
                        z.nHeldRes := z.nHeldRes + 1
                        evHeldRes  := true
                    else
                        z.nHeldSup := z.nHeldSup + 1
                        evHeldSup  := true
                    bool _cH = calLog(z.tProb, true)
                    z.lastTestBar := bar_index
                    z.tState      := 0
                    z.brkRun      := 0
                else if (bar_index - z.tStart) > resolveBars
                    // --- UNRESOLVED: price is sitting inside the zone.
                    // Neither outcome happened, so it contributes no
                    // evidence rather than being silently scored as a win.
                    z.nUnres      := z.nUnres + 1
                    z.realTouch   := z.realTouch + 1
                    z.lastTestBar := bar_index
                    z.tState      := 0
                    z.brkRun      := 0

            // --- Pre-touch verdict ---------------------------------
            //  The call was made while price was still away. This scores
            //  it honestly: arrival, then a reaction of the predicted
            //  size in the predicted direction inside a fixed window.
            float dNow = math.abs(z.center - close)
            if z.armed and z.evState == 0 and dNow <= approachAtr * atrRef and dNow < math.abs(z.center - nz(close[1], close))
                zoiApproach := true
            if z.armed and z.evState == 0 and inZ
                z.evState := 1
                z.evStart := bar_index
            else if z.evState == 1
                float disp = z.predDir > 0 ? (z.center - close) : (close - z.center)
                if disp >= reactAtr * atrRef
                    vpN   := vpN + 1
                    vpHit := vpHit + 1
                    z.evState := 0
                    z.armed   := false
                    priorHit  := true
                else if disp <= -reactAtr * atrRef or (bar_index - z.evStart) > reactBars
                    vpN := vpN + 1
                    z.evState := 0
                    z.armed   := false
                    priorMiss := true

            // --- Retirement: no pivot and no interaction for a long time
            int lastEv = int(math.max(nz(z.lastPivBar, z.firstBar), nz(z.lastTouch, nz(z.lastPivBar, z.firstBar))))
            // A field-born level ages out on spent inventory, not on the
            // clock: its whole claim is that nothing has happened there yet.
            bool spent = z.srcVol and (z.fuel < zoiFuelMin * 0.5 or z.vprior < zoiPriorMin * 0.5)
            if (bar_index - lastEv) > staleBars or spent
                z.alive   := false
                z.diedBar := bar_index


// =====================================================================
//  SECTION 12 - NON-MAX SUPPRESSION
// ---------------------------------------------------------------------
//  Duplicate tracks on the same physical level are fused, summing their
//  evidence, using interval IoU as the overlap metric. v1 had no such
//  step: its greedy seed-anchored clustering routinely split one level
//  into two neighbours that then competed for the same top-N slot.
// =====================================================================
mergeInto(Zone a, Zone b) =>
    float aw   = a.wsum
    float bw   = b.wsum
    float w    = aw + bw
    float mean = w > 0 ? (a.center * aw + b.center * bw) / w : a.center
    a.m2     := a.m2 + b.m2 + aw * math.pow(a.center - mean, 2) + bw * math.pow(b.center - mean, 2)
    a.fVol   := w > 0 ? (a.fVol * aw + b.fVol * bw) / w : a.fVol
    a.center := mean
    a.wsum   := w
    a.hits   := a.hits + b.hits
    a.volSum := a.volSum + b.volSum
    a.fWick  := math.max(a.fWick, b.fWick)
    a.fImp   := math.max(a.fImp,  b.fImp)
    a.firstBar   := int(math.min(nz(a.firstBar, bar_index), nz(b.firstBar, bar_index)))
    a.confBar    := int(math.min(nz(a.confBar, bar_index),  nz(b.confBar, bar_index)))
    a.lastPivBar := int(math.max(nz(a.lastPivBar, 0), nz(b.lastPivBar, 0)))
    a.lastTouch  := int(math.max(nz(a.lastTouch, 0), nz(b.lastTouch, 0)))
    a.nHeldRes   := a.nHeldRes  + b.nHeldRes
    a.nHeldSup   := a.nHeldSup  + b.nHeldSup
    a.nBrokeRes  := a.nBrokeRes + b.nBrokeRes
    a.nBrokeSup  := a.nBrokeSup + b.nBrokeSup
    a.realTouch  := a.realTouch + b.realTouch
    a.flips      := int(math.max(a.flips, b.flips))
    a.vprior     := math.max(a.vprior, b.vprior)
    a.srcVol     := a.srcVol or b.srcVol
    a.armed      := a.armed or b.armed
    a.predDir    := a.predDir != 0 ? a.predDir : b.predDir
    float _rw = refreshWidth(a, atrRef)
    b.alive   := false
    b.diedBar := bar_index
    a.center

if newPivot and pool.size() > 1
    for i = 0 to pool.size() - 2
        Zone a = pool.get(i)
        if a.alive
            for j = i + 1 to pool.size() - 1
                Zone b = pool.get(j)
                if b.alive
                    float ov = f_iou(a.center - a.halfW, a.center + a.halfW, b.center - b.halfW, b.center + b.halfW)
                    if ov >= mergeIoU
                        if a.wsum >= b.wsum
                            mergeInto(a, b)
                        else
                            mergeInto(b, a)


// =====================================================================
//  SECTION 13 - ZONE OF INTEREST
// ---------------------------------------------------------------------
//  v1 gated on `touches == minTouches` exactly, which made every zone with
//  more than the minimum number of pivots permanently ineligible. v2 gates
//  on calibrated probability, unspent-ness (resolved tests), quiet time and
//  volume-node participation.
// =====================================================================
bool zoiActivated = false

if pool.size() > 0
    for i = 0 to pool.size() - 1
        Zone z = pool.get(i)
        if z.alive
            bool quiet = na(z.lastTouch) or (bar_index - z.lastTouch) >= zoiQuiet
            bool away  = atrRef > 0 and math.abs(z.center - close) >= zoiMinDist * atrRef
            // Note what is NOT in this gate: probability, pivot count and
            // touch count. Every term is computable before price has ever
            // been here, which is the entire contract.
            bool q = zoiEnable and z.vprior >= zoiPriorMin and z.fuel >= zoiFuelMin and z.realTouch <= zoiMaxTests and quiet and away
            if q and not z.isZOI
                z.isZOI    := true
                z.zoiSince := bar_index
                z.armed    := true
                z.armBar   := bar_index
                zoiActivated := true
            else if not q and z.isZOI
                z.isZOI    := false
                z.zoiSince := na


// =====================================================================
//  SECTION 14 - SELECTION
// ---------------------------------------------------------------------
//  Display gating is now separate from existence. A level falling off the
//  top-N list is simply not drawn; it is NOT archived as "dropped" and its
//  history is not thrown away, which is what made v1's zone set flicker.
// =====================================================================
// Role is derived from where price sits right now, not from a field that
// only refreshes on confirmed bars.
isResNow(Zone z) => z.center > close

isFar(float px) =>
    hideFarAtr <= 0 or atrRef <= 0 ? false : math.abs(px - close) > hideFarAtr * atrRef

// A field-born zone has no pivots by construction, so structural
// sufficiency is "enough pivots OR enough volumetric prior".
hasStructure(Zone z) => z.hits >= minPivots or (z.srcVol and z.vprior >= zoiPriorMin)

drawable(Zone z) =>
    z.alive and hasStructure(z) and z.prob >= minProb and not na(z.center) and z.halfW > 0 and not isFar(z.center)

selectTop(bool wantRes, int keep) =>
    array<int> picked = array.new<int>()
    array<int> cand   = array.new<int>()
    if pool.size() > 0
        for i = 0 to pool.size() - 1
            Zone z = pool.get(i)
            if drawable(z) and isResNow(z) == wantRes
                cand.push(i)
    if cand.size() > 0
        int lim = math.min(keep, cand.size())
        for k = 1 to lim
            int   bi = -1
            float bv = -1.0
            for c = 0 to cand.size() - 1
                Zone zc = pool.get(cand.get(c))
                if zc.prob > bv
                    bv := zc.prob
                    bi := c
            if bi >= 0
                picked.push(cand.get(bi))
                cand.remove(bi)
    picked

nearestOf(bool wantRes) =>
    Zone found = na
    float bestD = 1e18
    if pool.size() > 0
        for i = 0 to pool.size() - 1
            Zone z = pool.get(i)
            if drawable(z) and isResNow(z) == wantRes
                float d = math.abs(z.center - close)
                if d < bestD
                    bestD := d
                    found := z
    found

// Nearest zone that was flagged BEFORE price got there and is still
// waiting for its first touch.
nearestArmed() =>
    Zone found = na
    float bestD = 1e18
    if pool.size() > 0
        for i = 0 to pool.size() - 1
            Zone z = pool.get(i)
            if z.alive and z.isZOI and z.evState == 0
                float d = math.abs(z.center - close)
                if d < bestD
                    bestD := d
                    found := z
    found

countSide(bool wantRes) =>
    int n = 0
    if pool.size() > 0
        for i = 0 to pool.size() - 1
            Zone z = pool.get(i)
            if z.alive and hasStructure(z) and isResNow(z) == wantRes
                n += 1
    n


// =====================================================================
//  SECTION 15 - RENDERING
// =====================================================================
var array<box>   bxBuf  = array.new<box>()
var array<line>  lnBuf  = array.new<line>()
var array<label> lbBuf  = array.new<label>()

clearBuffers() =>
    if bxBuf.size() > 0
        for i = 0 to bxBuf.size() - 1
            box.delete(bxBuf.get(i))
    if lnBuf.size() > 0
        for i = 0 to lnBuf.size() - 1
            line.delete(lnBuf.get(i))
    if lbBuf.size() > 0
        for i = 0 to lbBuf.size() - 1
            label.delete(lbBuf.get(i))
    bxBuf.clear()
    lnBuf.clear()
    lbBuf.clear()
    bxBuf.size()

zoneLabelText(Zone z) =>
    string stars = probStars(z.prob)
    string pTxt  = showProb ? str.tostring(math.round(z.prob * 100)) + "%" : ""
    string vTxt  = showVolText ? (volFeedOk ? formatVolume(z.volSum) : "n/a") : ""
    string tTxt  = str.tostring(z.hits) + "p"
    if z.realTouch > 0
        tTxt := tTxt + "/" + str.tostring(z.realTouch) + "t"
    string tag = ""
    if z.isZOI and zoiLabel
        // The pre-touch readout: charge remaining and what the stranded
        // side is expected to do when price gets back here.
        string dirTxt = z.predDir > 0 ? "R" : z.predDir < 0 ? "S" : "?"
        tag := "  ZOI " + str.tostring(math.round(z.fuel * 100)) + "% " + dirTxt
    string src = z.srcVol and z.hits == 0 ? "  vol" : ""
    string flip = z.flips > 0 ? "  F" + str.tostring(z.flips) : ""
    string row1 = stars + (pTxt == "" ? "" : "  " + pTxt) + "  " + tTxt + src + flip + tag
    string outv = row1
    if showVolText
        outv := singleLine ? row1 + "  -  Vol: " + vTxt : "Vol: " + vTxt + "\n" + row1
    outv

drawZone(Zone z) =>
    color baseCol = isResNow(z) ? resColor : supColor
    int   rightX  = bar_index + 25
    // Honest mode anchors the box to the CONFIRMATION bar, not the pivot
    // bar. The zone did not exist until pivRight bars after the high or
    // low printed, and drawing it earlier back-dates information.
    int   startX  = safeStartBar(noRepaint ? nz(z.confBar, z.firstBar) : nz(z.firstBar, z.confBar))
    // Opacity is driven by calibrated probability, not by raw volume rank.
    int   solid   = int(f_clampF((z.prob - 0.4) / 0.45, 0.0, 1.0) * 30.0)
    int   fillOp  = f_clampI(zoneOpacity - solid, 45, 96)
    color fill    = color.new(baseCol, fillOp)
    color edge    = color.new(baseCol, f_clampI(int(35 - solid * 0.5), 0, 90))
    color border  = z.isZOI ? color.new(zoiGlowCol, 0) : (z.srcVol and z.hits == 0 ? color.new(baseCol, 25) : color.new(baseCol, 100))
    int   bw      = z.isZOI ? zoiBorderW : 1
    bxBuf.push(box.new(startX, z.center + z.halfW, rightX, z.center - z.halfW,
         border_color = border, border_width = bw, bgcolor = fill))
    lnBuf.push(line.new(startX, z.center, rightX, z.center, color = edge, style = z.srcVol and z.hits == 0 ? line.style_dotted : line.style_dashed, width = 1))
    if showLabels
        color lbBg = z.isZOI ? color.new(zoiGlowCol, 65) : color.new(baseCol, 75)
        lbBuf.push(label.new(rightX, z.center, zoneLabelText(z), style = label.style_label_left,
             color = lbBg, textcolor = chart.fg_color, size = size.small))
    if showFlips and z.flips > 0 and not na(z.lastFlipBar)
        lbBuf.push(label.new(safeStartBar(z.lastFlipBar), z.center, "flip",
             style = label.style_label_center, color = color.new(zoiGlowCol, 40),
             textcolor = color.black, size = size.tiny))
    z.center

drawRetired(Zone z) =>
    if not na(z.center) and z.halfW > 0 and not isFar(z.center)
        color useCol = z.isRes ? brokenBear : brokenBull  // frozen at retirement
        int   startX = safeStartBar(nz(z.confBar, z.firstBar))
        int   endX   = safeStartBar(nz(z.diedBar, bar_index))
        if endX > startX
            bxBuf.push(box.new(startX, z.center + z.halfW, endX, z.center - z.halfW,
                 border_color = na, bgcolor = color.new(useCol, brokenOp)))
    z.center

if barstate.islast and dataReady
    clearBuffers()
    array<int> selRes = selectTop(true,  zonesPerSide)
    array<int> selSup = selectTop(false, zonesPerSide)
    if selRes.size() > 0
        for i = 0 to selRes.size() - 1
            float _d1 = drawZone(pool.get(selRes.get(i)))
    if selSup.size() > 0
        for i = 0 to selSup.size() - 1
            float _d2 = drawZone(pool.get(selSup.get(i)))
    if showHistory and pool.size() > 0
        for i = 0 to pool.size() - 1
            Zone z = pool.get(i)
            if not z.alive
                float _d3 = drawRetired(z)

plotshape(showTests and evHeldSup,  "Support held",       shape.circle,  location.belowbar, color.new(supColor, 0), size = size.tiny)
plotshape(showTests and evHeldRes,  "Resistance held",    shape.circle,  location.abovebar, color.new(resColor, 0), size = size.tiny)
plotshape(showTests and evBrokeSup, "Support broken",     shape.xcross,  location.belowbar, color.new(resColor, 0), size = size.tiny)
plotshape(showTests and evBrokeRes, "Resistance broken",  shape.xcross,  location.abovebar, color.new(supColor, 0), size = size.tiny)


// =====================================================================
//  SECTION 16 - VALIDATION PANEL
// ---------------------------------------------------------------------
//  Shadow mode. Every resolved test is filed into the probability bucket
//  it was predicted from; the panel reports predicted vs realised hold
//  rate over the whole chart. If the two diverge, the model is
//  miscalibrated HERE and the stars should be discounted accordingly.
//  This is the check v1 never had - and without it a "strength score" is
//  an opinion, not a measurement.
// =====================================================================
calPredicted() =>
    float num = 0.0
    int   den = 0
    for b = 0 to 4
        int n = calN.get(b)
        num += n * (b * 0.2 + 0.1)
        den += n
    den > 0 ? num / den : na

calRealised() =>
    int hit = 0
    int den = 0
    for b = 0 to 4
        hit += calHit.get(b)
        den += calN.get(b)
    den > 0 ? hit / float(den) : na

calCount() =>
    int den = 0
    for b = 0 to 4
        den += calN.get(b)
    den


priorRate() => vpN > 0 ? vpHit / float(vpN) : na


// =====================================================================
//  SECTION 17 - DASHBOARD
// =====================================================================
var table dashTbl = na

if showDash and barstate.islast and dataReady
    if not na(dashTbl)
        table.delete(dashTbl)
    dashTbl := table.new(strToPos(dashPosStr), 2, 10,
         bgcolor = color.new(C_BG, 82), frame_color = color.new(C_FRAME, 35), frame_width = 1,
         border_color = color.new(C_FRAME, 75), border_width = 1)
    sizeRes = strToSize(dashSizeStr)
    color hdrBg = color.new(C_ACCENT, 60)
    color rowBg = color.new(C_BG, 90)

    table.cell(dashTbl, 0, 0, "SR ZONES", text_color = color.white, bgcolor = hdrBg, text_size = sizeRes, text_font_family = font.family_monospace)
    table.cell(dashTbl, 1, 0, "v2", text_color = color.white, bgcolor = hdrBg, text_halign = text.align_right, text_size = sizeRes, text_font_family = font.family_monospace)

    table.cell(dashTbl, 0, 1, "Regime", text_color = chart.fg_color, bgcolor = rowBg, text_size = sizeRes, text_font_family = font.family_monospace)
    table.cell(dashTbl, 1, 1, regimeTxt + "  " + (na(atrPct) ? "-" : str.tostring(atrPct, "#.##") + "%"),
         text_color = chart.fg_color, bgcolor = rowBg, text_halign = text.align_right, text_size = sizeRes, text_font_family = font.family_monospace)

    table.cell(dashTbl, 0, 2, "Levels R/S", text_color = chart.fg_color, bgcolor = rowBg, text_size = sizeRes, text_font_family = font.family_monospace)
    table.cell(dashTbl, 1, 2, str.tostring(countSide(true)) + " / " + str.tostring(countSide(false)),
         text_color = chart.fg_color, bgcolor = rowBg, text_halign = text.align_right, text_size = sizeRes, text_font_family = font.family_monospace)

    Zone nR = nearestOf(true)
    string nRTxt = "-"
    if not na(nR)
        nRTxt := str.tostring(nR.center, format.mintick) + "  " + str.tostring(math.round(nR.prob * 100)) + "%  " + probStars(nR.prob)
    table.cell(dashTbl, 0, 3, "Next R", text_color = chart.fg_color, bgcolor = rowBg, text_size = sizeRes, text_font_family = font.family_monospace)
    table.cell(dashTbl, 1, 3, nRTxt, text_color = resColor, bgcolor = color.new(resColor, 82), text_halign = text.align_right, text_size = sizeRes, text_font_family = font.family_monospace)

    Zone nS = nearestOf(false)
    string nSTxt = "-"
    if not na(nS)
        nSTxt := str.tostring(nS.center, format.mintick) + "  " + str.tostring(math.round(nS.prob * 100)) + "%  " + probStars(nS.prob)
    table.cell(dashTbl, 0, 4, "Next S", text_color = chart.fg_color, bgcolor = rowBg, text_size = sizeRes, text_font_family = font.family_monospace)
    table.cell(dashTbl, 1, 4, nSTxt, text_color = supColor, bgcolor = color.new(supColor, 82), text_halign = text.align_right, text_size = sizeRes, text_font_family = font.family_monospace)

    string distTxt = "-"
    if not na(nR) and not na(nS)
        float dR = distancePct(nR.center, close)
        float dS = distancePct(nS.center, close)
        distTxt := (na(dS) ? "-" : str.tostring(dS, "#.##")) + "% / " + (na(dR) ? "-" : str.tostring(dR, "#.##")) + "%"
    table.cell(dashTbl, 0, 5, "Dist S/R", text_color = chart.fg_color, bgcolor = rowBg, text_size = sizeRes, text_font_family = font.family_monospace)
    table.cell(dashTbl, 1, 5, distTxt, text_color = chart.fg_color, bgcolor = rowBg, text_halign = text.align_right, text_size = sizeRes, text_font_family = font.family_monospace)

    int zoiN = 0
    if pool.size() > 0
        for i = 0 to pool.size() - 1
            Zone z = pool.get(i)
            if z.alive and z.isZOI
                zoiN += 1
    table.cell(dashTbl, 0, 6, "ZOI", text_color = chart.fg_color, bgcolor = rowBg, text_size = sizeRes, text_font_family = font.family_monospace)
    table.cell(dashTbl, 1, 6, zoiN > 0 ? str.tostring(zoiN) + " active" : "-",
         text_color = zoiGlowCol, bgcolor = color.new(zoiGlowCol, 82), text_halign = text.align_right, text_size = sizeRes, text_font_family = font.family_monospace)

    // -------- Nearest pre-touch target --------
    Zone nZ = nearestArmed()
    string zTxt = "-"
    color  zCol = chart.fg_color
    if not na(nZ)
        float dz = atrRef > 0 ? math.abs(nZ.center - close) / atrRef : na
        string dirTxt = nZ.predDir > 0 ? "R" : nZ.predDir < 0 ? "S" : "?"
        zTxt := str.tostring(nZ.center, format.mintick) + "  " + dirTxt + "  " + str.tostring(math.round(nZ.fuel * 100)) + "%  " + (na(dz) ? "" : str.tostring(dz, "#.#") + " ATR")
        zCol := zoiGlowCol
    table.cell(dashTbl, 0, 7, "Next ZOI", text_color = chart.fg_color, bgcolor = rowBg, text_size = sizeRes, text_font_family = font.family_monospace)
    table.cell(dashTbl, 1, 7, zTxt, text_color = zCol, bgcolor = color.new(zoiGlowCol, 88), text_halign = text.align_right, text_size = sizeRes, text_font_family = font.family_monospace)

    // -------- Ex-ante prior hit rate --------
    string pTxt2 = "n=0"
    color  pCol2 = chart.fg_color
    float  pr    = priorRate()
    if vpN > 0
        pTxt2 := str.tostring(math.round(pr * 100)) + "%  n=" + str.tostring(vpN)
        pCol2 := vpN < 10 ? chart.fg_color : pr >= 0.55 ? supColor : pr >= 0.45 ? C_ACCENT : resColor
    table.cell(dashTbl, 0, 8, "Prior (pre-touch)", text_color = chart.fg_color, bgcolor = rowBg, text_size = sizeRes, text_font_family = font.family_monospace)
    table.cell(dashTbl, 1, 8, pTxt2, text_color = pCol2, bgcolor = rowBg, text_halign = text.align_right, text_size = sizeRes, text_font_family = font.family_monospace)

    string calTxt = "off"
    color  calCol = chart.fg_color
    if showCalib
        int   n = calCount()
        float p = calPredicted()
        float r = calRealised()
        if n < 12 or na(p) or na(r)
            calTxt := "n=" + str.tostring(n) + " (warming up)"
        else
            float gap = math.abs(p - r)
            calTxt := str.tostring(math.round(p * 100)) + "% vs " + str.tostring(math.round(r * 100)) + "%  n=" + str.tostring(n)
            calCol := gap <= 0.07 ? supColor : gap <= 0.15 ? C_ACCENT : resColor
    table.cell(dashTbl, 0, 9, "Reliability", text_color = chart.fg_color, bgcolor = rowBg, text_size = sizeRes, text_font_family = font.family_monospace)
    table.cell(dashTbl, 1, 9, calTxt, text_color = calCol, bgcolor = rowBg, text_halign = text.align_right, text_size = sizeRes, text_font_family = font.family_monospace)


// =====================================================================
//  SECTION 18 - ALERTS
// =====================================================================
Zone aR = nearestOf(true)
Zone aS = nearestOf(false)

bool touchRes = not na(aR) and high >= aR.center - aR.halfW and low <= aR.center + aR.halfW
bool touchSup = not na(aS) and high >= aS.center - aS.halfW and low <= aS.center + aS.halfW
bool nearHiR = not na(aR) and aR.prob >= alertProb and math.abs(aR.center - close) <= atrRef
bool nearHiS = not na(aS) and aS.prob >= alertProb and math.abs(aS.center - close) <= atrRef
bool hiProbNear = nearHiR or nearHiS

alertcondition(touchRes,      "Resistance touched",          "Price reached a tracked resistance zone")
alertcondition(touchSup,      "Support touched",             "Price reached a tracked support zone")
alertcondition(evHeldRes,     "Resistance test held",        "A resistance test resolved as HELD")
alertcondition(evHeldSup,     "Support test held",           "A support test resolved as HELD")
alertcondition(evBrokeRes,    "Resistance break confirmed",  "A resistance broke with buffer and confirmation")
alertcondition(evBrokeSup,    "Support break confirmed",     "A support broke with buffer and confirmation")
alertcondition(evFlip,        "Zone polarity flip",          "A tracked level flipped role after a confirmed break")
alertcondition(zoiActivated,  "ZOI armed (pre-touch)",       "A volumetric zone of interest was flagged before price reached it")
alertcondition(zoiApproach,   "ZOI approach",                "Price is closing on an untouched zone of interest")
alertcondition(priorHit,      "ZOI prior confirmed",         "A pre-touch call produced the predicted reaction")
alertcondition(priorMiss,     "ZOI prior failed",            "A pre-touch call did not produce the predicted reaction")
alertcondition(hiProbNear,    "High-probability zone approached", "Price is within 1 ATR of a high-probability zone")
alertcondition(newPivot,      "New pivot ingested",          "A new pivot was confirmed and the tracker updated")


// =====================================================================
//  END - Smart SR Zones v2
// =====================================================================
