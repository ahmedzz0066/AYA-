//@version=5
// XAUUSD M5 - momentum displacement -> limit pullback -> fixed 3:1
//
// Third implementation of the same idea (Python for research, MQL5 for live,
// this for eyeballs). Use it to LOOK at the setups. Do not use TradingView's
// numbers as your verdict: its intrabar fill assumptions on a 5-minute chart
// are optimistic, which is exactly the direction that gets people hurt. The
// Python backtester resolves stop-before-target pessimistically; this cannot.
strategy("XAUUSD M5 3R Limit Pullback", overlay=true,
     initial_capital=10000, currency=currency.USD,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     commission_type=strategy.commission.cash_per_order, commission_value=0.7,
     slippage=10, calc_on_every_tick=false, process_orders_on_close=true,
     pyramiding=0)

// ---- inputs -------------------------------------------------------------
grpRR = "Reward : Risk"
rr        = input.float(3.0,  "Reward:risk",             group=grpRR, minval=0.5, step=0.1)

grpSig = "Displacement trigger"
lookback  = input.int(20,     "Breakout lookback",       group=grpSig, minval=5)
minLegATR = input.float(1.0,  "Min leg (x ATR)",         group=grpSig, step=0.1)
maxLegATR = input.float(6.0,  "Max leg (x ATR)",         group=grpSig, step=0.5)

grpEntry = "Limit entry"
retrace   = input.float(0.382,"Retrace depth",           group=grpEntry, minval=0.05, maxval=0.95, step=0.01)
emaConf   = input.bool(true,  "EMA confluence",          group=grpEntry)
emaPullLen= input.int(21,     "Pullback EMA",            group=grpEntry)

grpStop = "Stop"
slBufATR  = input.float(0.30, "SL buffer (x ATR)",       group=grpStop, step=0.05)
minRATR   = input.float(0.50, "Min R (x ATR)",           group=grpStop, step=0.05)
maxRATR   = input.float(2.50, "Max R (x ATR)",           group=grpStop, step=0.05)

grpFilt = "Regime filters"
emaFastLen= input.int(21,     "EMA fast",                group=grpFilt)
emaSlowLen= input.int(50,     "EMA slow",                group=grpFilt)
htfEmaLen = input.int(21,     "H1 EMA",                  group=grpFilt)
useHtf    = input.bool(true,  "Require H1 bias",         group=grpFilt)
atrLen    = input.int(14,     "ATR length",              group=grpFilt)
atrWin    = input.int(480,    "ATR percentile window",   group=grpFilt)
atrFloor  = input.float(0.30, "ATR pct floor",           group=grpFilt, minval=0, maxval=1, step=0.05)
atrCap    = input.float(0.97, "ATR pct cap",             group=grpFilt, minval=0, maxval=1, step=0.01)

grpLife = "Order lifecycle"
expireBars= input.int(12,     "Cancel unfilled after N bars", group=grpLife, minval=1)
invalFrac = input.float(0.10, "Invalidation fraction",   group=grpLife, step=0.05)

grpSess = "Sessions (exchange time - set the chart to UTC)"
sessStr   = input.session("0700-1100", "London",         group=grpSess)
sessStr2  = input.session("1230-1630", "NY overlap",      group=grpSess)
flatHour  = input.int(20,     "Force flat at hour (UTC)", group=grpSess, minval=0, maxval=23)

grpRisk = "Risk"
riskPct   = input.float(0.5,  "Risk per trade (%)",      group=grpRisk, step=0.1)
maxPerDay = input.int(4,      "Max trades per day",      group=grpRisk, minval=1)

// ---- series -------------------------------------------------------------
atrV     = ta.atr(atrLen)
emaFast  = ta.ema(close, emaFastLen)
emaSlow  = ta.ema(close, emaSlowLen)
emaPull  = ta.ema(close, emaPullLen)

// H1 bias, explicitly no lookahead - the default is fine but say it out loud
htfClose = request.security(syminfo.tickerid, "60", close[1], lookahead=barmerge.lookahead_off)
htfEma   = request.security(syminfo.tickerid, "60", ta.ema(close, htfEmaLen)[1], lookahead=barmerge.lookahead_off)
htfEmaP  = request.security(syminfo.tickerid, "60", ta.ema(close, htfEmaLen)[2], lookahead=barmerge.lookahead_off)
htfBias  = htfClose > htfEma and htfEma >= htfEmaP ? 1 : htfClose < htfEma and htfEma <= htfEmaP ? -1 : 0

atrLo    = ta.percentile_linear_interpolation(atrV, atrWin, atrFloor * 100)
atrHi    = ta.percentile_linear_interpolation(atrV, atrWin, atrCap * 100)
volOk    = not na(atrLo) and not na(atrHi) and atrV >= atrLo and atrV <= atrHi

inSess   = not na(time(timeframe.period, sessStr)) or not na(time(timeframe.period, sessStr2))
isFriday = dayofweek == dayofweek.friday
noNewRisk= isFriday and hour >= 16
flatTime = hour >= flatHour

// day trade counter
var int tradesToday = 0
newDay = ta.change(time("1D")) != 0
if newDay
    tradesToday := 0

// ---- signal -------------------------------------------------------------
priorHigh = ta.highest(high, lookback)[1]
priorLow  = ta.lowest(low,  lookback)[1]
origLow   = ta.lowest(low,  lookback + 1)
origHigh  = ta.highest(high, lookback + 1)

baseOk  = volOk and inSess and not noNewRisk and not flatTime and tradesToday < maxPerDay
longSig  = baseOk and close > priorHigh and emaFast > emaSlow and (not useHtf or htfBias > 0)
shortSig = baseOk and close < priorLow  and emaFast < emaSlow and (not useHtf or htfBias < 0)

legLong  = close - origLow
legShort = origHigh - close
legOkL   = legLong  >= minLegATR * atrV and legLong  <= maxLegATR * atrV
legOkS   = legShort >= minLegATR * atrV and legShort <= maxLegATR * atrV

// limit price: base retracement, pulled to the EMA when the EMA sits deeper.
// Deeper entry -> smaller R -> 3R becomes a move gold actually makes.
rawLongEntry  = close - retrace * legLong
longEntry     = emaConf and emaPull > origLow and emaPull < rawLongEntry ? emaPull : rawLongEntry
longEntry    := math.max(longEntry, origLow + 0.05 * legLong)
rawShortEntry = close + retrace * legShort
shortEntry    = emaConf and emaPull < origHigh and emaPull > rawShortEntry ? emaPull : rawShortEntry
shortEntry   := math.min(shortEntry, origHigh - 0.05 * legShort)

longSL   = origLow  - slBufATR * atrV
shortSL  = origHigh + slBufATR * atrV
longR    = longEntry - longSL
shortR   = shortSL - shortEntry
rOkL     = longR  > 0 and longR  >= minRATR * atrV and longR  <= maxRATR * atrV
rOkS     = shortR > 0 and shortR >= minRATR * atrV and shortR <= maxRATR * atrV

longTP   = longEntry  + rr * longR
shortTP  = shortEntry - rr * shortR

takeLong  = longSig  and legOkL and rOkL  and longEntry  < close
takeShort = shortSig and legOkS and rOkS  and shortEntry > close

// ---- orders -------------------------------------------------------------
// position size from the stop distance: 1.00 lot of XAUUSD = 100 oz
qtyLong  = takeLong  ? math.max(1, math.floor(strategy.equity * riskPct / 100 / longR))  : 1
qtyShort = takeShort ? math.max(1, math.floor(strategy.equity * riskPct / 100 / shortR)) : 1

var float pendingInval = na
var int   pendingBar   = na
var bool  pendingLong  = false

if takeLong and strategy.position_size == 0
    strategy.entry("L", strategy.long, qty=qtyLong, limit=longEntry)
    strategy.exit("Lx", from_entry="L", stop=longSL, limit=longTP)
    pendingInval := origLow + invalFrac * legLong
    pendingBar   := bar_index
    pendingLong  := true
    tradesToday  += 1
    alert("XAUUSD M5 3R | BUY LIMIT " + str.tostring(longEntry, "#.00") +
          " | SL " + str.tostring(longSL, "#.00") +
          " | TP " + str.tostring(longTP, "#.00") +
          " | R " + str.tostring(longR, "#.00") + " USD/oz" +
          " | cancel unfilled in " + str.tostring(expireBars) + " bars",
          alert.freq_once_per_bar_close)

if takeShort and strategy.position_size == 0
    strategy.entry("S", strategy.short, qty=qtyShort, limit=shortEntry)
    strategy.exit("Sx", from_entry="S", stop=shortSL, limit=shortTP)
    pendingInval := origHigh - invalFrac * legShort
    pendingBar   := bar_index
    pendingLong  := false
    tradesToday  += 1
    alert("XAUUSD M5 3R | SELL LIMIT " + str.tostring(shortEntry, "#.00") +
          " | SL " + str.tostring(shortSL, "#.00") +
          " | TP " + str.tostring(shortTP, "#.00") +
          " | R " + str.tostring(shortR, "#.00") + " USD/oz" +
          " | cancel unfilled in " + str.tostring(expireBars) + " bars",
          alert.freq_once_per_bar_close)

// cancel unfilled limits: stale, invalidated, or out of session.
// Dead money is worse than a loss - it also blocks the next setup.
stale = not na(pendingBar) and bar_index - pendingBar >= expireBars
broke = not na(pendingInval) and (pendingLong ? close < pendingInval : close > pendingInval)
if strategy.position_size == 0 and (stale or broke or not inSess or flatTime)
    strategy.cancel("L")
    strategy.cancel("S")
    pendingInval := na
    pendingBar   := na

if strategy.position_size != 0 and flatTime
    strategy.close_all(comment="flat-time")

// ---- visuals ------------------------------------------------------------
plot(emaFast, "EMA fast", color.new(color.aqua, 40), 1)
plot(emaSlow, "EMA slow", color.new(color.orange, 40), 1)
plot(emaPull, "EMA pullback", color.new(color.gray, 60), 1)

plotshape(takeLong,  "Buy limit",  shape.triangleup,   location.belowbar, color.new(color.lime, 0), size=size.tiny)
plotshape(takeShort, "Sell limit", shape.triangledown, location.abovebar, color.new(color.red, 0),  size=size.tiny)

bgcolor(inSess and volOk ? color.new(color.blue, 94) : na, title="tradeable window")

plot(takeLong ? longEntry : takeShort ? shortEntry : na, "limit", color.yellow, 2, plot.style_linebr)
plot(takeLong ? longSL : takeShort ? shortSL : na,       "stop",  color.red,    2, plot.style_linebr)
plot(takeLong ? longTP : takeShort ? shortTP : na,       "target",color.green,  2, plot.style_linebr)

// The one number that matters, on the chart, at all times.
//
// NOTE: the compiler suggests calc_on_every_tick=true to make barstate.islast
// fire on unconfirmed bars. Do NOT take that suggestion. It makes the strategy
// recalculate intrabar, which changes when orders are evaluated and lets the
// backtest repaint - trading a cosmetic table for the integrity of every fill
// is a catastrophic exchange rate. Widen the guard instead.
var table info = table.new(position.top_right, 2, 4, border_width=1)
if barstate.islast or barstate.islastconfirmedhistory
    table.cell(info, 0, 0, "break-even WR",  text_color=color.white, bgcolor=color.new(color.black, 20))
    table.cell(info, 1, 0, str.tostring(100 / (1 + rr), "#.0") + "%", text_color=color.yellow, bgcolor=color.new(color.black, 20))
    table.cell(info, 0, 1, "actual WR",      text_color=color.white, bgcolor=color.new(color.black, 20))
    wr = strategy.closedtrades > 0 ? strategy.wintrades / strategy.closedtrades * 100 : 0.0
    table.cell(info, 1, 1, str.tostring(wr, "#.0") + "%", text_color=wr > 100 / (1 + rr) ? color.lime : color.red, bgcolor=color.new(color.black, 20))
    table.cell(info, 0, 2, "closed trades",  text_color=color.white, bgcolor=color.new(color.black, 20))
    table.cell(info, 1, 2, str.tostring(strategy.closedtrades), text_color=color.white, bgcolor=color.new(color.black, 20))
    table.cell(info, 0, 3, "ATR (USD)",      text_color=color.white, bgcolor=color.new(color.black, 20))
    table.cell(info, 1, 3, str.tostring(atrV, "#.00"), text_color=color.white, bgcolor=color.new(color.black, 20))

// alertcondition() does nothing inside a strategy - the alerts above fire at
// the moment the limit is placed and carry the actual levels, which is the
// only form of alert that is useful at 5-minute speed. Set the alert to
// "Any alert() function call".
