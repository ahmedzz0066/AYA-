//@version=6
// =====================================================================================
//  VOLUMETRIC SUPPLY & DEMAND ZONES — VERSION 6
//  Logic-driven, math-first Supply/Demand engine grounded in auction market theory.
//
//  First principles:
//    Price is a continuous double-auction. A Supply zone is a price area where a pool
//    of resting/refilled SELL interest previously overwhelmed buyers and reversed an
//    up-move. A Demand zone is the mirror: a pool of BUY interest that reversed a
//    down-move. Volume is the only direct evidence of capital committed at a price.
//    We therefore (1) detect base->impulse structure (consolidation that resolves with
//    a high-volume imbalance candle), (2) profile volume to locate the fair-value POC
//    inside the base, and (3) score each zone 0-10 from orthogonal, normalized factors.
//    Zones decay with age (freshness) and with consumption (touches / break = mitigation).
//
//  Non-repainting: zones are only created on CONFIRMED bars (barstate.isconfirmed) and
//  reference already-closed bars. HTF data uses lookahead_off.
// =====================================================================================
indicator("Volumetric Supply & Demand Zones v6", "VolSD v6", overlay = true,
     max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 5000)

// -------------------------------------------------------------------------------------
// INPUTS
// -------------------------------------------------------------------------------------
// --- Base -> Impulse detection ---
grpD       = "1 · Base → Impulse Detection"
lenBase    = input.int(3,   "Base length (consolidation bars)", minval = 1, maxval = 20, group = grpD,
     tooltip = "Number of consolidation bars preceding the impulse that define the zone body.")
baseMaxATR = input.float(2.0, "Max base range (×ATR)", minval = 0.2, step = 0.1, group = grpD,
     tooltip = "Base must be a tight consolidation: its total range must be below this multiple of ATR.")
impATRmult = input.float(1.6, "Impulse range (×ATR)", minval = 0.5, step = 0.1, group = grpD,
     tooltip = "Departure candle range must exceed this multiple of ATR (proof of imbalance).")
impVolMult = input.float(1.5, "Impulse volume (×avg)", minval = 1.0, step = 0.1, group = grpD,
     tooltip = "Departure candle volume must exceed this multiple of average volume.")
bodyRatio  = input.float(0.55, "Impulse body/range ratio", minval = 0.1, maxval = 1.0, step = 0.05, group = grpD,
     tooltip = "Departure candle must be directional: body must be at least this fraction of its range.")

// --- Volume Profile ---
grpV       = "2 · Volume Profile (rolling)"
vpEnable   = input.bool(true, "Enable rolling volume profile (POC/VAH/VAL)", group = grpV)
vpLookback = input.int(200,  "Profile lookback (bars)", minval = 20, maxval = 1000, group = grpV)
vpBins     = input.int(24,   "Profile resolution (bins)", minval = 8, maxval = 100, group = grpV)
vaPct      = input.float(70, "Value Area %", minval = 50, maxval = 95, step = 1, group = grpV)
vpHist     = input.bool(true, "Draw profile histogram", group = grpV)

// --- Strength scoring (composite 0-10) ---
grpS       = "3 · Strength Scoring (weights)"
wVol       = input.float(2.0, "Weight: volume percentile", minval = 0, step = 0.1, group = grpS)
wImp       = input.float(2.0, "Weight: impulse ratio",     minval = 0, step = 0.1, group = grpS)
wDelta     = input.float(1.5, "Weight: delta imbalance",   minval = 0, step = 0.1, group = grpS)
wWidth     = input.float(1.0, "Weight: width efficiency",  minval = 0, step = 0.1, group = grpS)
wHTF       = input.float(1.5, "Weight: HTF confluence",    minval = 0, step = 0.1, group = grpS)
maxWidthATR= input.float(3.0, "Width normalization (×ATR)", minval = 0.5, step = 0.1, group = grpS,
     tooltip = "Zones wider than this (in ATR) score 0 on width efficiency.")
minStrength= input.float(5.0, "Min strength to display (0-10)", minval = 0, maxval = 10, step = 0.5, group = grpS)

// --- Mitigation / decay ---
grpM       = "4 · Mitigation & Decay"
freshHL    = input.int(150,  "Freshness half-life (bars)", minval = 5, group = grpM,
     tooltip = "Strength is multiplied by 0.5 every this many bars of age (exponential decay).")
touchDecay = input.float(0.80, "Per-touch decay factor", minval = 0.1, maxval = 1.0, step = 0.05, group = grpM,
     tooltip = "Each retest multiplies live strength by this factor (volume absorption).")
mitigType  = input.string("Close through", "Mitigation trigger", options = ["Close through", "Wick through"], group = grpM)
removeMit  = input.bool(true, "Remove mitigated zones", group = grpM)
maxZones   = input.int(12,   "Max active zones per side", minval = 1, maxval = 60, group = grpM)

// --- Multi-timeframe confluence ---
grpH       = "5 · Multi-Timeframe Confluence"
htfEnable  = input.bool(true, "Enable HTF trend confluence", group = grpH)
htfRes     = input.timeframe("240", "HTF resolution", group = grpH)
htfEmaLen  = input.int(50, "HTF trend EMA length", minval = 2, group = grpH)

// --- Regime filter ---
grpR       = "6 · Market Regime Filter"
regimeFilt = input.bool(false, "Only create zones in trending regime", group = grpR)
adxLen     = input.int(14, "ADX length", minval = 2, group = grpR)
adxTrend   = input.float(20, "ADX trend threshold", minval = 5, step = 1, group = grpR)

// --- Visuals ---
grpViz     = "7 · Visuals"
colDem     = input.color(color.new(#26a69a, 0), "Demand color", group = grpViz)
colSup     = input.color(color.new(#ef5350, 0), "Supply color", group = grpViz)
showPOC    = input.bool(true,  "Show zone POC line", group = grpViz)
showLabel  = input.bool(true,  "Show strength label", group = grpViz)
extendRt   = input.int(15, "Extend boxes (bars right)", minval = 0, group = grpViz)
maxTransp  = input.int(90, "Min opacity transparency (weak zones)", minval = 50, maxval = 99, group = grpViz)
minTransp  = input.int(60, "Max opacity transparency (strong zones)", minval = 0, maxval = 90, group = grpViz)

// --- Alerts ---
grpA       = "8 · Alerts"
alertRetest= input.bool(true, "Alert on strong-zone retest + rejection", group = grpA)
alertSpike = input.float(1.5, "Retest volume spike (×avg)", minval = 1.0, step = 0.1, group = grpA)

// -------------------------------------------------------------------------------------
// CORE SERIES (computed once)
// -------------------------------------------------------------------------------------
atr     = ta.atr(14)
avgVol  = ta.sma(volume, 50)
gVolPct = ta.percentrank(volume, 100) / 100.0   // hoisted: ta.* must run every bar
[diP, diM, adx] = ta.dmi(adxLen, adxLen)
trending = adx >= adxTrend

// HTF trend (non-repainting: lookahead off, reference closed value)
htfClose = htfEnable ? request.security(syminfo.tickerid, htfRes, close[1], lookahead = barmerge.lookahead_off) : close
htfEma   = htfEnable ? request.security(syminfo.tickerid, htfRes, ta.ema(close, htfEmaLen)[1], lookahead = barmerge.lookahead_off) : close
htfUp    = htfClose >  htfEma
htfDn    = htfClose <  htfEma

// -------------------------------------------------------------------------------------
// ZONE TYPE
// -------------------------------------------------------------------------------------
type Zone
    float top
    float bot
    float poc
    bool  isDemand
    float baseStrength      // static composite at creation (0-10)
    int   createdBar
    float createdAtr
    int   touches
    bool  inside            // currently inside the zone (touch debounce)
    bool  mitigated
    box   bx
    line  pocLn
    label lbl

var array<Zone> demZones = array.new<Zone>()
var array<Zone> supZones = array.new<Zone>()

// -------------------------------------------------------------------------------------
// VOLUME PROFILE  (rolling, true bin distribution)  -> [poc, vah, val]
// -------------------------------------------------------------------------------------
f_profile(int lb, int nb, float vapct) =>
    float hi  = ta.highest(high, lb)
    float lo  = ta.lowest(low, lb)
    float stp = (hi - lo) / nb
    array<float> bv = array.new_float(nb, 0.0)
    if stp > 0
        for i = 0 to lb - 1
            int loB = math.max(0, math.min(nb - 1, int((low[i]  - lo) / stp)))
            int hiB = math.max(0, math.min(nb - 1, int((high[i] - lo) / stp)))
            float per = volume[i] / (hiB - loB + 1)
            for b = loB to hiB
                array.set(bv, b, array.get(bv, b) + per)
    // POC bin
    int pocIdx = 0
    float pocV = -1.0
    for i = 0 to nb - 1
        if array.get(bv, i) > pocV
            pocV := array.get(bv, i)
            pocIdx := i
    // Value area expansion from POC
    float tot   = array.sum(bv)
    float tgt   = tot * vapct / 100.0
    float accum = array.get(bv, pocIdx)
    int up = pocIdx + 1
    int dn = pocIdx - 1
    int vahI = pocIdx
    int valI = pocIdx
    while accum < tgt and (up < nb or dn >= 0)
        float vU = up < nb ? array.get(bv, up) : -1.0
        float vD = dn >= 0 ? array.get(bv, dn) : -1.0
        if vU >= vD
            accum += vU
            vahI := up
            up   += 1
        else
            accum += vD
            valI := dn
            dn   -= 1
    float poc = lo + (pocIdx + 0.5) * stp
    float vah = lo + (vahI + 1) * stp
    float val = lo + valI * stp
    [poc, vah, val, bv, lo, stp, pocV]

// -------------------------------------------------------------------------------------
// STRENGTH FACTORS  (each normalized to 0..1)
// -------------------------------------------------------------------------------------
// Volume percentile of the impulse vs recent distribution (impulse bar = offset 1).
f_volScore() => gVolPct[1]

// Impulse ratio: range vs ATR, normalized by the configured threshold (capped at 1).
f_impScore(float rng) => math.min(1.0, (rng / atr) / (impATRmult * 1.5))

// Delta imbalance proxy from close-location of the impulse candle.
f_deltaScore(bool dem, float o, float h, float l, float c) =>
    float rng = math.max(h - l, syminfo.mintick)
    dem ? (c - l) / rng : (h - c) / rng

// Width efficiency: narrower (relative to ATR) = stronger.
f_widthScore(float top, float bot) => math.max(0.0, 1.0 - (top - bot) / (atr * maxWidthATR))

// HTF confluence: 1 if HTF trend agrees with zone side.
f_htfScore(bool dem) => not htfEnable ? 0.0 : (dem ? (htfUp ? 1.0 : 0.0) : (htfDn ? 1.0 : 0.0))

// Composite static strength 0..10
f_strength(bool dem, float o, float h, float l, float c, float top, float bot, float rng) =>
    float sV = f_volScore()
    float sI = f_impScore(rng)
    float sD = f_deltaScore(dem, o, h, l, c)
    float sW = f_widthScore(top, bot)
    float sH = f_htfScore(dem)
    float sumW = wVol + wImp + wDelta + wWidth + (htfEnable ? wHTF : 0.0)
    float raw  = sumW > 0 ? (wVol * sV + wImp * sI + wDelta * sD + wWidth * sW + (htfEnable ? wHTF * sH : 0.0)) / sumW : 0.0
    raw * 10.0

// Live strength after freshness + touch decay
f_liveStrength(Zone z) =>
    float age   = math.max(0, bar_index - z.createdBar)
    float fresh = math.pow(0.5, age / freshHL)
    float tch   = math.pow(touchDecay, z.touches)
    z.baseStrength * fresh * tch

// Transparency mapped from live strength (strong -> opaque)
f_transp(float s) =>
    float k = math.min(1.0, math.max(0.0, s / 10.0))
    int(maxTransp - (maxTransp - minTransp) * k)

// -------------------------------------------------------------------------------------
// ZONE BASE VWAP (local POC proxy = volume-weighted fair value of the base)
// -------------------------------------------------------------------------------------
f_baseVwap(int startOff, int n) =>
    float pv = 0.0
    float vv = 0.0
    for i = startOff to startOff + n - 1
        pv += hlc3[i] * volume[i]
        vv += volume[i]
    vv > 0 ? pv / vv : hlc3[startOff]

// -------------------------------------------------------------------------------------
// DETECTION  (confirmed bars only -> non-repainting)
// -------------------------------------------------------------------------------------
// Impulse is evaluated on the last CLOSED bar (offset 1). Base = bars [2 .. lenBase+1].
impOff   = 1
baseOff  = impOff + 1

rng1   = high[impOff] - low[impOff]
body1  = math.abs(close[impOff] - open[impOff])
direc  = body1 / math.max(rng1, syminfo.mintick)

isImp  = rng1 > impATRmult * atr and volume[impOff] > impVolMult * avgVol and direc >= bodyRatio
impUp  = isImp and close[impOff] > open[impOff]
impDn  = isImp and close[impOff] < open[impOff]

baseHi = ta.highest(high, lenBase)[baseOff]
baseLo = ta.lowest(low,  lenBase)[baseOff]
baseTight = (baseHi - baseLo) < baseMaxATR * atr

regimeOK = not regimeFilt or trending

f_addZone(bool dem) =>
    // Zone body = the consolidation base that produced the imbalance.
    float top = baseHi
    float bot = baseLo
    float strength = f_strength(dem, open[impOff], high[impOff], low[impOff], close[impOff], top, bot, rng1)
    if strength >= minStrength
        float poc = f_baseVwap(baseOff, lenBase)
        color c   = dem ? colDem : colSup
        int tr    = f_transp(strength)
        box bx    = box.new(bar_index[baseOff + lenBase - 1], top, bar_index + extendRt, bot,
             border_color = color.new(c, 30), bgcolor = color.new(c, tr), border_width = 1)
        line ln   = showPOC ? line.new(bar_index[baseOff], poc, bar_index + extendRt, poc,
             color = color.new(c, 10), style = line.style_dotted, width = 1) : na
        label lb  = showLabel ? label.new(bar_index + extendRt, dem ? bot : top,
             (dem ? "DEMAND " : "SUPPLY ") + str.tostring(strength, "#.0") + "/10",
             style = dem ? label.style_label_up : label.style_label_down,
             color = color.new(c, 20), textcolor = color.white, size = size.small) : na
        Zone z = Zone.new(top, bot, poc, dem, strength, bar_index, atr, 0, false, false, bx, ln, lb)
        array<Zone> arr = dem ? demZones : supZones
        array.push(arr, z)
        // cap per side: drop oldest
        if array.size(arr) > maxZones
            Zone old = array.shift(arr)
            box.delete(old.bx)
            line.delete(old.pocLn)
            label.delete(old.lbl)

if barstate.isconfirmed and isImp and baseTight and regimeOK
    if impUp
        f_addZone(true)
    if impDn
        f_addZone(false)

// -------------------------------------------------------------------------------------
// MITIGATION, DECAY, RETEST  (update every confirmed bar)
// -------------------------------------------------------------------------------------
// Returns true if a strong-zone retest+rejection alert fired this bar.
f_update(array<Zone> arr) =>
    bool fired = false
    if array.size(arr) > 0
        for i = array.size(arr) - 1 to 0
            Zone z = array.get(arr, i)
            if not z.mitigated
                bool through = mitigType == "Close through" ?
                     (z.isDemand ? close < z.bot : close > z.top) :
                     (z.isDemand ? low   < z.bot : high  > z.top)
                if through
                    z.mitigated := true
                    if removeMit
                        box.delete(z.bx)
                        line.delete(z.pocLn)
                        label.delete(z.lbl)
                        array.remove(arr, i)
                        continue
                    else
                        box.set_bgcolor(z.bx, color.new(color.gray, 92))
                        box.set_border_color(z.bx, color.new(color.gray, 60))
                else
                    // touch detection with debounce
                    bool touchingNow = low <= z.top and high >= z.bot
                    if touchingNow and not z.inside
                        z.touches += 1
                        z.inside := true
                        // retest of strong zone + rejection + volume spike
                        float liveT  = f_liveStrength(z)
                        bool  reject = z.isDemand ? close > open : close < open
                        bool  spike  = volume > alertSpike * avgVol
                        if alertRetest and liveT >= minStrength and reject and spike
                            fired := true
                    if not touchingNow
                        z.inside := false
                    // refresh visuals: extend right + opacity from live strength
                    float live = f_liveStrength(z)
                    box.set_right(z.bx, bar_index + extendRt)
                    box.set_bgcolor(z.bx, color.new(z.isDemand ? colDem : colSup, f_transp(live)))
                    if not na(z.pocLn)
                        line.set_x2(z.pocLn, bar_index + extendRt)
                    if not na(z.lbl)
                        label.set_x(z.lbl, bar_index + extendRt)
                        label.set_text(z.lbl, (z.isDemand ? "DEMAND " : "SUPPLY ") + str.tostring(live, "#.0") + "/10"
                             + (z.touches > 0 ? "  ·" + str.tostring(z.touches) + "T" : ""))
    fired

bool alertRetestFlag = false
if barstate.isconfirmed
    bool fD = f_update(demZones)
    bool fS = f_update(supZones)
    alertRetestFlag := fD or fS

// -------------------------------------------------------------------------------------
// ROLLING VOLUME PROFILE  (POC / VAH / VAL + optional histogram)
// -------------------------------------------------------------------------------------
var line pocLine = na
var line vahLine = na
var line valLine = na
var array<box> histBoxes = array.new<box>()

if vpEnable and barstate.islast
    [vpPoc, vpVah, vpVal, bv, vpLo, vpStp, vpMaxV] = f_profile(vpLookback, vpBins, vaPct)
    int xr = bar_index + extendRt
    int xl = bar_index - vpLookback
    line.delete(pocLine)
    line.delete(vahLine)
    line.delete(valLine)
    pocLine := line.new(xl, vpPoc, xr, vpPoc, color = color.new(color.orange, 0),  width = 2)
    vahLine := line.new(xl, vpVah, xr, vpVah, color = color.new(color.blue, 0), style = line.style_dashed)
    valLine := line.new(xl, vpVal, xr, vpVal, color = color.new(color.blue, 0), style = line.style_dashed)
    if vpHist
        if array.size(histBoxes) > 0
            for i = 0 to array.size(histBoxes) - 1
                box.delete(array.get(histBoxes, i))
            array.clear(histBoxes)
        float maxLen = vpLookback * 0.4
        for b = 0 to vpBins - 1
            float v = array.get(bv, b)
            if v > 0 and vpMaxV > 0
                int len = int(maxLen * v / vpMaxV)
                float yTop = vpLo + (b + 1) * vpStp
                float yBot = vpLo + b * vpStp
                bool inVA = yBot >= vpVal and yTop <= vpVah
                box hb = box.new(bar_index - len, yTop, bar_index, yBot,
                     border_color = na, bgcolor = color.new(inVA ? color.blue : color.gray, 75))
                array.push(histBoxes, hb)

// -------------------------------------------------------------------------------------
// ALERTS
// -------------------------------------------------------------------------------------
alertcondition(alertRetestFlag, "Strong zone retest + rejection", "VolSD: strong zone retest with rejection & volume spike")
if alertRetestFlag
    alert("VolSD v6: strong supply/demand zone retest with rejection candle + volume spike on " + syminfo.ticker, alert.freq_once_per_bar_close)

// New-zone alerts
newDem = barstate.isconfirmed and isImp and impUp and baseTight and regimeOK
newSup = barstate.isconfirmed and isImp and impDn and baseTight and regimeOK
alertcondition(newDem, "New demand zone", "VolSD: new demand zone formed")
alertcondition(newSup, "New supply zone", "VolSD: new supply zone formed")

// -------------------------------------------------------------------------------------
// REGIME TABLE (top-right)
// -------------------------------------------------------------------------------------
var table info = table.new(position.top_right, 1, 3, frame_color = color.gray, frame_width = 1)
if barstate.islast
    table.cell(info, 0, 0, "VolSD v6", text_color = color.white, bgcolor = color.new(color.black, 0), text_size = size.small)
    table.cell(info, 0, 1, (trending ? "TRENDING" : "RANGING") + "  ADX " + str.tostring(adx, "#.0"),
         text_color = color.white, bgcolor = color.new(trending ? color.teal : color.maroon, 20), text_size = size.small)
    table.cell(info, 0, 2, "Dem " + str.tostring(array.size(demZones)) + " · Sup " + str.tostring(array.size(supZones)),
         text_color = color.white, bgcolor = color.new(color.black, 20), text_size = size.small)
