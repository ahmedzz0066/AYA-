//@version=6
indicator("Order Block Detector [LuxAlgo] Enhanced"
  , overlay          = true
  , max_boxes_count  = 500
  , max_labels_count = 500
  , max_lines_count  = 500)

//──────────────────────────────────────────────────────────────────────────────
// SETTINGS
//──────────────────────────────────────────────────────────────────────────────
grp_core = "Core Settings"
grp_bull = "Bullish OB"
grp_bear = "Bearish OB"
grp_filt = "Accuracy Filters"
grp_mit  = "Mitigation"
grp_brk  = "Breaker Blocks"
grp_fvg  = "Fair Value Gaps"
grp_styl = "Style"

// ── Core ────────────────────────────────────────────────────────────────────
length        = input.int   (5,    'Pivot Length',                         minval = 1,                 group = grp_core)

// ── Bullish OB ───────────────────────────────────────────────────────────────
bull_ext_last = input.int   (3,    'Bullish OB Count',    minval = 1,      inline = 'bull',            group = grp_bull)
bg_bull_css   = input.color (color.new(#169400, 80), '',                   inline = 'bull',            group = grp_bull)
bull_css      = input.color (#169400, '',                                  inline = 'bull',            group = grp_bull)
bull_avg_css  = input.color (color.new(#9598a1, 37), '',                   inline = 'bull',            group = grp_bull)

// ── Bearish OB ───────────────────────────────────────────────────────────────
bear_ext_last = input.int   (3,    'Bearish OB Count',    minval = 1,      inline = 'bear',            group = grp_bear)
bg_bear_css   = input.color (color.new(#ff1100, 80), '',                   inline = 'bear',            group = grp_bear)
bear_css      = input.color (#ff1100, '',                                  inline = 'bear',            group = grp_bear)
bear_avg_css  = input.color (color.new(#9598a1, 37), '',                   inline = 'bear',            group = grp_bear)

// ── Accuracy Filters ─────────────────────────────────────────────────────────
use_body      = input.bool  (true,  'Body-Based OB Zone (more precise entry)',                         group = grp_filt)
vol_filter    = input.bool  (true,  'Volume Filter — above-average volume only',                       group = grp_filt)
vol_ma_len    = input.int   (20,    'Volume MA Length',        minval = 5,                             group = grp_filt)
disp_filter   = input.bool  (true,  'Displacement Filter — confirm impulsive move after OB',           group = grp_filt)
disp_mult     = input.float (0.75,  'Min Displacement (x ATR)',minval = 0.1, step = 0.05,              group = grp_filt)
atr_size_filt = input.bool  (true,  'OB Size Filter — OB candle must be significant',                  group = grp_filt)
atr_min_mult  = input.float (0.3,   'Min OB Candle Size (x ATR)', minval = 0.05, step = 0.05,         group = grp_filt)
show_strength = input.bool  (true,  'Show Strength Labels',                                            group = grp_filt)

// ── Mitigation ───────────────────────────────────────────────────────────────
mitigation    = input.string('50% Body', 'Mitigation Method',
  options = ['Wick', 'Close', '50% Body'],                                                             group = grp_mit)

// ── Breaker Blocks ───────────────────────────────────────────────────────────
show_breakers = input.bool  (true,  'Show Breaker Blocks',                                             group = grp_brk)
brk_ext_last  = input.int   (2,     'Max Breakers per Side', minval = 1, maxval = 5,                   group = grp_brk)
brk_bull_css  = input.color (color.new(#ff9800, 75), 'Bullish Breaker',                               group = grp_brk)
brk_bear_css  = input.color (color.new(#9c27b0, 75), 'Bearish Breaker',                               group = grp_brk)

// ── Fair Value Gaps ──────────────────────────────────────────────────────────
show_fvg      = input.bool  (true,  'Show Fair Value Gaps (Imbalances)',                               group = grp_fvg)
fvg_max       = input.int   (3,     'Max FVGs per Side',   minval = 1, maxval = 10,                    group = grp_fvg)
fvg_bull_css  = input.color (color.new(#00bcd4, 88), 'Bullish FVG',                                   group = grp_fvg)
fvg_bear_css  = input.color (color.new(#ff5722, 88), 'Bearish FVG',                                   group = grp_fvg)

// ── Style ────────────────────────────────────────────────────────────────────
line_style    = input.string('⎯⎯⎯', 'Midline Style', options = ['⎯⎯⎯', '----', '····'],              group = grp_styl)
line_width    = input.int   (1,    'Midline Width',          minval = 1,                               group = grp_styl)

//──────────────────────────────────────────────────────────────────────────────
// FUNCTIONS
//──────────────────────────────────────────────────────────────────────────────

f_line_style(s) =>
    switch s
        '⎯⎯⎯' => line.style_solid
        '----' => line.style_dashed
        '····' => line.style_dotted

// Strength score 0–100:
//   · Volume ratio vs MA  (0–50 pts)
//   · Body size vs ATR    (0–50 pts)
f_strength(vol, vol_avg, body, atr) =>
    vol_score  = math.min(vol / math.max(vol_avg, 1) * 50, 50)
    body_score = math.min(body / math.max(atr, syminfo.mintick) * 50, 50)
    int(math.round(vol_score + body_score))

// Accumulate OB coordinates. Each call-site keeps its own var arrays.
f_get_ob(cond, top_val, btm_val, entry_val, str_val) =>
    var ob_top = array.new<float>(0)
    var ob_btm = array.new<float>(0)
    var ob_avg = array.new<float>(0)
    var ob_lft = array.new<int>  (0)
    var ob_str = array.new<int>  (0)
    float ob   = na
    if cond
        array.unshift(ob_top, top_val)
        array.unshift(ob_btm, btm_val)
        array.unshift(ob_avg, math.avg(top_val, btm_val))
        array.unshift(ob_lft, time[length])
        array.unshift(ob_str, str_val)
        ob := entry_val
    [ob_top, ob_btm, ob_avg, ob_lft, ob_str, ob]

// Remove mitigated OBs. Iterates backwards to avoid index-shift bugs.
// Records mitigated zones for breaker block display.
f_remove_mit(ob_top, ob_btm, ob_avg, ob_lft, ob_str, target, is_bull) =>
    var mit_top = array.new<float>(0)
    var mit_btm = array.new<float>(0)
    var mit_lft = array.new<int>  (0)
    mitigated   = false
    if array.size(ob_top) > 0
        for i = array.size(ob_top) - 1 to 0
            t   = array.get(ob_top, i)
            b   = array.get(ob_btm, i)
            mid = math.avg(t, b)
            ref = is_bull ? b : t
            hit = switch mitigation
                'Close'    => is_bull ? close < ref  : close > ref
                '50% Body' => is_bull ? target < mid : target > mid
                =>            is_bull ? target < ref : target > ref
            if hit
                mitigated := true
                if show_breakers
                    array.unshift(mit_top, t)
                    array.unshift(mit_btm, b)
                    array.unshift(mit_lft, array.get(ob_lft, i))
                    if array.size(mit_top) > brk_ext_last
                        array.pop(mit_top)
                        array.pop(mit_btm)
                        array.pop(mit_lft)
                array.remove(ob_top, i)
                array.remove(ob_btm, i)
                array.remove(ob_avg, i)
                array.remove(ob_lft, i)
                array.remove(ob_str, i)
    [mitigated, mit_top, mit_btm, mit_lft]

// Draw OB boxes, midlines, and strength labels (pre-allocated pattern).
f_draw_ob(ob_top, ob_btm, ob_avg, ob_lft, ob_str, n_max, bg_css, bdr_css, avg_css, is_bull) =>
    var boxes  = array.new<box>  (0)
    var lines  = array.new<line> (0)
    var labels = array.new<label>(0)
    if barstate.isfirst
        for i = 0 to n_max - 1
            array.unshift(boxes, box.new(na, na, na, na
              , xloc         = xloc.bar_time
              , extend       = extend.right
              , bgcolor      = bg_css
              , border_color = color.new(bdr_css, 70)))
            array.unshift(lines, line.new(na, na, na, na
              , xloc   = xloc.bar_time
              , extend = extend.right
              , color  = avg_css
              , style  = f_line_style(line_style)
              , width  = line_width))
            array.unshift(labels, label.new(na, na, ''
              , xloc      = xloc.bar_time
              , style     = is_bull ? label.style_label_up : label.style_label_down
              , color     = color.new(bdr_css, 50)
              , textcolor = color.white
              , size      = size.tiny))
    if barstate.islast
        n_ob = array.size(ob_top)
        if n_ob > 0
            for i = 0 to math.min(n_max - 1, n_ob - 1)
                t = array.get(ob_top, i)
                b = array.get(ob_btm, i)
                a = array.get(ob_avg, i)
                l = array.get(ob_lft, i)
                s = array.get(ob_str, i)
                box.set_lefttop    (array.get(boxes, i), l, t)
                box.set_rightbottom(array.get(boxes, i), l, b)
                line.set_xy1(array.get(lines, i), l,     a)
                line.set_xy2(array.get(lines, i), l + 1, a)
                if show_strength
                    // v6: use switch instead of chained multiline ternary
                    tag = switch
                        s >= 75 => '■ Strong ' + str.tostring(s) + '%'
                        s >= 50 => '▪ Medium ' + str.tostring(s) + '%'
                        =>         '· Weak '   + str.tostring(s) + '%'
                    label.set_xy  (array.get(labels, i), l, is_bull ? b : t)
                    label.set_text(array.get(labels, i), tag)

// Draw breaker blocks (pre-allocated).
f_draw_brk(mit_top, mit_btm, mit_lft, n_max, css) =>
    var brk_boxes = array.new<box>(0)
    if barstate.isfirst and show_breakers
        for i = 0 to n_max - 1
            array.unshift(brk_boxes, box.new(na, na, na, na
              , xloc         = xloc.bar_time
              , extend       = extend.right
              , bgcolor      = css
              , border_color = color.new(css, 20)
              , border_style = line.style_dashed))
    if barstate.islast and show_breakers
        n = array.size(mit_top)
        if n > 0
            for i = 0 to math.min(n_max - 1, n - 1)
                box.set_lefttop    (array.get(brk_boxes, i), array.get(mit_lft, i), array.get(mit_top, i))
                box.set_rightbottom(array.get(brk_boxes, i), array.get(mit_lft, i), array.get(mit_btm, i))

// Draw Fair Value Gap boxes (pre-allocated).
f_draw_fvg(fvg_top, fvg_btm, fvg_lft, n_max, css) =>
    var fvg_boxes = array.new<box>(0)
    if barstate.isfirst and show_fvg
        for i = 0 to n_max - 1
            array.unshift(fvg_boxes, box.new(na, na, na, na
              , xloc         = xloc.bar_time
              , extend       = extend.right
              , bgcolor      = css
              , border_color = color.new(css, 40)))
    if barstate.islast and show_fvg
        n = array.size(fvg_top)
        if n > 0
            for i = 0 to math.min(n_max - 1, n - 1)
                box.set_lefttop    (array.get(fvg_boxes, i), array.get(fvg_lft, i), array.get(fvg_top, i))
                box.set_rightbottom(array.get(fvg_boxes, i), array.get(fvg_lft, i), array.get(fvg_btm, i))

//──────────────────────────────────────────────────────────────────────────────
// CORE CALCULATIONS
//──────────────────────────────────────────────────────────────────────────────

atr    = ta.atr(14)
vol_ma = ta.sma(volume, vol_ma_len)

var os          = 0
var target_bull = 0.
var target_bear = 0.

upper = ta.highest(length)
lower = ta.lowest(length)

os := high[length] > upper ? 0 : low[length] < lower ? 1 : os[1]

phv = ta.pivothigh(volume, length, length)

target_bull := mitigation == 'Close' ? ta.lowest(close, length)  : lower
target_bear := mitigation == 'Close' ? ta.highest(close, length) : upper

vol_ok = not vol_filter    or volume[length] > vol_ma
atr_ok = not atr_size_filt or (high[length] - low[length]) >= atr_min_mult * atr

bull_disp_ok = not disp_filter or (close > open and (high - low) >= disp_mult * atr)
bear_disp_ok = not disp_filter or (close < open and (high - low) >= disp_mult * atr)

// Bullish OB: last down-close candle before an up impulse
bull_ob_top = use_body ? math.max(open[length], close[length]) : hl2[length]
bull_ob_btm = use_body ? math.min(open[length], close[length]) : low[length]

// Bearish OB: last up-close candle before a down impulse
bear_ob_top = use_body ? math.max(open[length], close[length]) : high[length]
bear_ob_btm = use_body ? math.min(open[length], close[length]) : hl2[length]

ob_body = math.abs(close[length] - open[length])
str_val = f_strength(volume[length], vol_ma, ob_body, atr)

bull_cond = not na(phv) and os == 1 and vol_ok and atr_ok and bull_disp_ok
bear_cond = not na(phv) and os == 0 and vol_ok and atr_ok and bear_disp_ok

//──────────────────────────────────────────────────────────────────────────────
// FAIR VALUE GAPS
//──────────────────────────────────────────────────────────────────────────────
var fvg_bull_top = array.new<float>(0)
var fvg_bull_btm = array.new<float>(0)
var fvg_bull_lft = array.new<int>  (0)
var fvg_bear_top = array.new<float>(0)
var fvg_bear_btm = array.new<float>(0)
var fvg_bear_lft = array.new<int>  (0)

if show_fvg
    if low > high[2]
        array.unshift(fvg_bull_top, low)
        array.unshift(fvg_bull_btm, high[2])
        array.unshift(fvg_bull_lft, time[2])
        if array.size(fvg_bull_top) > fvg_max
            array.pop(fvg_bull_top)
            array.pop(fvg_bull_btm)
            array.pop(fvg_bull_lft)
    if high < low[2]
        array.unshift(fvg_bear_top, low[2])
        array.unshift(fvg_bear_btm, high)
        array.unshift(fvg_bear_lft, time[2])
        if array.size(fvg_bear_top) > fvg_max
            array.pop(fvg_bear_top)
            array.pop(fvg_bear_btm)
            array.pop(fvg_bear_lft)
    // Remove filled FVGs
    if array.size(fvg_bull_top) > 0
        for i = array.size(fvg_bull_top) - 1 to 0
            if low <= array.get(fvg_bull_btm, i)
                array.remove(fvg_bull_top, i)
                array.remove(fvg_bull_btm, i)
                array.remove(fvg_bull_lft, i)
    if array.size(fvg_bear_top) > 0
        for i = array.size(fvg_bear_top) - 1 to 0
            if high >= array.get(fvg_bear_top, i)
                array.remove(fvg_bear_top, i)
                array.remove(fvg_bear_btm, i)
                array.remove(fvg_bear_lft, i)

//──────────────────────────────────────────────────────────────────────────────
// GET OB ARRAYS
//──────────────────────────────────────────────────────────────────────────────

[bull_top, bull_btm, bull_avg, bull_lft, bull_str, bull_ob] = f_get_ob(bull_cond, bull_ob_top, bull_ob_btm, low[length], str_val)

[bear_top, bear_btm, bear_avg, bear_lft, bear_str, bear_ob] = f_get_ob(bear_cond, bear_ob_top, bear_ob_btm, high[length], str_val)

//──────────────────────────────────────────────────────────────────────────────
// REMOVE MITIGATED OBs
//──────────────────────────────────────────────────────────────────────────────

[mitigated_bull, mit_bull_top, mit_bull_btm, mit_bull_lft] = f_remove_mit(bull_top, bull_btm, bull_avg, bull_lft, bull_str, target_bull, true)

[mitigated_bear, mit_bear_top, mit_bear_btm, mit_bear_lft] = f_remove_mit(bear_top, bear_btm, bear_avg, bear_lft, bear_str, target_bear, false)

//──────────────────────────────────────────────────────────────────────────────
// DISPLAY
//──────────────────────────────────────────────────────────────────────────────

f_draw_ob(bull_top, bull_btm, bull_avg, bull_lft, bull_str, bull_ext_last, bg_bull_css, bull_css, bull_avg_css, true)
f_draw_ob(bear_top, bear_btm, bear_avg, bear_lft, bear_str, bear_ext_last, bg_bear_css, bear_css, bear_avg_css, false)

// Mitigated bull OB → bearish breaker; mitigated bear OB → bullish breaker
f_draw_brk(mit_bull_top, mit_bull_btm, mit_bull_lft, brk_ext_last, brk_bear_css)
f_draw_brk(mit_bear_top, mit_bear_btm, mit_bear_lft, brk_ext_last, brk_bull_css)

f_draw_fvg(fvg_bull_top, fvg_bull_btm, fvg_bull_lft, fvg_max, fvg_bull_css)
f_draw_fvg(fvg_bear_top, fvg_bear_btm, fvg_bear_lft, fvg_max, fvg_bear_css)

plot(bull_ob, 'Bull OB', bull_css, 2, plot.style_linebr
  , offset = -length, display = display.none)
plot(bear_ob, 'Bear OB', bear_css, 2, plot.style_linebr
  , offset = -length, display = display.none)

//──────────────────────────────────────────────────────────────────────────────
// ALERTS
//──────────────────────────────────────────────────────────────────────────────
alertcondition(bull_ob,        'Bullish OB Formed',    'Bullish order block detected')
alertcondition(bear_ob,        'Bearish OB Formed',    'Bearish order block detected')
alertcondition(mitigated_bull, 'Bullish OB Mitigated', 'Bullish order block mitigated')
alertcondition(mitigated_bear, 'Bearish OB Mitigated', 'Bearish order block mitigated')
