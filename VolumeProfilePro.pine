// This Source Code Form is subject to the terms of the Mozilla Public License, v. 2.0.
// © AYA — Volume Profile Pro | Rebuilt on First Principles
//@version=6
indicator("Volume Profile Pro [AYA]",
     overlay          = true,
     max_boxes_count  = 500,
     max_lines_count  = 200,
     max_labels_count = 50)

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 1 — INPUTS
// ══════════════════════════════════════════════════════════════════════════════
var string G_PROF = "── Profile Engine ───────────────────────────────"
i_lookback  = input.int(200,  "Lookback Bars",       minval=50,  maxval=500,  group=G_PROF,
    tooltip="Bars to include in the profile. 200 bars ≈ 1 full RTH session on a 5m /ES chart.")
i_rows      = input.int(60,   "Price Rows",          minval=20,  maxval=120,  group=G_PROF,
    tooltip="Vertical resolution. 60 rows gives a clean signal-to-noise ratio on 5m futures.")
i_src       = input.source(hlc3, "Price Source",                              group=G_PROF,
    tooltip="HLC3 places each bar's volume at its mid-range — best proxy for true traded price.")
i_va_pct    = input.float(70.0, "Value Area %",      minval=50,  maxval=95,   group=G_PROF,
    tooltip="CME/CBOT standard: the price area containing this % of total session volume.")
i_width     = input.int(80,   "Profile Width (bars)", minval=20, maxval=300,  group=G_PROF)

var string G_SESS = "── Session ──────────────────────────────────────"
i_use_sess  = input.bool(true, "Filter by Session",  group=G_SESS,
    tooltip="ON = only include bars that fall inside the session window. OFF = all bars in lookback.")
i_session   = input.session("0930-1600", "Session String", group=G_SESS,
    tooltip="RTH: 0930-1600 | Full futures: 1800-1700 | Pre+RTH: 0400-1600")

var string G_IMB = "── Stacked Imbalance ────────────────────────────"
i_imb_ratio = input.float(3.0, "Imbalance Ratio",     minval=1.5, maxval=15.0, step=0.5, group=G_IMB,
    tooltip="Minimum buy/sell ratio required to flag a row as imbalanced. 3.0 = buyers are 3× sellers.")
i_imb_min   = input.int(3,    "Min Consecutive Rows", minval=2,   maxval=8,                group=G_IMB,
    tooltip="Consecutive imbalanced rows needed to trigger a stacked imbalance highlight.")

var string G_COL = "── Colors ───────────────────────────────────────"
i_col_bull  = input.color(color.new(#2196F3, 35), "Bull Volume",    group=G_COL)
i_col_bear  = input.color(color.new(#FF5722, 35), "Bear Volume",    group=G_COL)
i_col_poc   = input.color(#FFD700,                "POC",            group=G_COL)
i_col_vah   = input.color(color.new(#00E676, 10), "VAH",            group=G_COL)
i_col_val   = input.color(color.new(#FF1744, 10), "VAL",            group=G_COL)
i_col_ypoc  = input.color(color.new(#FFD700, 65), "Prev POC",       group=G_COL)
i_col_yprev = input.color(color.new(#00E676, 65), "Prev VAH/VAL",   group=G_COL)
i_col_gap   = input.color(color.new(#0D1B6E, 60), "Zero-Vol Gap",   group=G_COL)
i_col_imb_b = input.color(color.new(#00E676, 72), "Bull Imbalance", group=G_COL)
i_col_imb_s = input.color(color.new(#FF1744, 72), "Bear Imbalance", group=G_COL)

var string G_TBL = "── Info Table ───────────────────────────────────"
i_show_tbl  = input.bool(true, "Show Table", group=G_TBL)
i_tbl_pos   = input.string("Bottom Right", "Position",
    options=["Top Right", "Bottom Right", "Top Left", "Bottom Left"], group=G_TBL)

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 2 — STATE (var = persists across bars)
// ══════════════════════════════════════════════════════════════════════════════
// Current session key levels — updated in the barstate.islast block
var float poc_price    = na
var float vah_price    = na
var float val_price    = na

// Previous session key levels — snapshotted on session start
var float prev_poc     = na
var float prev_vah     = na
var float prev_val     = na

// Session-scoped CVD (resets every session start)
var float session_cvd  = 0.0

// Profile balance metric (% of session volume that was bullish)
var float prof_bull_pct = na

// Profile arrays — cleared and rebuilt at barstate.islast
var float[] _lvls  = array.new_float(0)
var float[] _bvols = array.new_float(0)  // buy volume per row
var float[] _svols = array.new_float(0)  // sell volume per row

// Info table — created once, cells updated every bar
var table _tbl = na

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 3 — PER-BAR LOGIC  (runs on every bar, lightweight)
// ══════════════════════════════════════════════════════════════════════════════

// Session membership for the current bar
bool in_session = not i_use_sess or not na(time(timeframe.period, i_session))

// Session-start: new RTH/ETH open, or new calendar day when unfiltered.
// Friday→Saturday weekend gap is explicitly excluded.
bool is_sess_start = i_use_sess ?
     (in_session and not in_session[1]) :
     ta.change(dayofweek) != 0
       and not (dayofweek[1] == dayofweek.friday and dayofweek == dayofweek.saturday)

// CVD: directional proxy.  close>open = aggressive buy; else = aggressive sell.
float bar_delta = close > open ? volume : close < open ? -volume : 0.0

if is_sess_start
    // Snapshot current session levels as "previous" before the reset
    if not na(poc_price)
        prev_poc := poc_price
        prev_vah := vah_price
        prev_val := val_price
    session_cvd := bar_delta
else if in_session or not i_use_sess
    session_cvd += bar_delta

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 4 — PROFILE REBUILD  (barstate.islast only — correct, not repainting)
// ══════════════════════════════════════════════════════════════════════════════
if barstate.islast

    // ── 4a. Purge all drawn objects from the previous render ─────────────────
    for bx in box.all
        box.delete(bx)
    for ln in line.all
        line.delete(ln)
    for lbl in label.all
        label.delete(lbl)

    // ── 4b. Price range for the lookback window ───────────────────────────────
    int   lookback = math.min(i_lookback, bar_index)
    float hi       = ta.highest(high, lookback)
    float lo       = ta.lowest(low,   lookback)

    // Degenerate-range guard (illiquid symbols, pre-market flats, holidays)
    if hi - lo < syminfo.mintick * 4
        hi += syminfo.mintick * 20
        lo -= syminfo.mintick * 20

    float step = (hi - lo) / i_rows

    // ── 4c. Rebuild level boundaries and volume arrays ────────────────────────
    array.clear(_lvls)
    array.clear(_bvols)
    array.clear(_svols)

    for i = 0 to i_rows          // i_rows + 1 boundary prices
        array.push(_lvls, lo + i * step)

    for i = 0 to i_rows - 1
        array.push(_bvols, 0.0)
        array.push(_svols, 0.0)

    // ── 4d. Volume assignment — O(lookback), O(1) per bar via direct indexing ─
    // Direct bin formula eliminates the O(rows) inner-loop from the original.
    for offset = 0 to lookback - 1
        // Session filter: time(tf, session) is a series; [offset] reads history.
        if i_use_sess and na(time(timeframe.period, i_session)[offset])
            continue

        float price = i_src[offset]
        float vol   = volume[offset]
        if na(price) or na(vol) or vol <= 0 or price < lo or price > hi
            continue

        // Direct O(1) bin lookup — no inner loop needed
        int row = int(math.floor((price - lo) / step))
        row    := math.max(0, math.min(row, i_rows - 1))

        if close[offset] > open[offset]
            array.set(_bvols, row, array.get(_bvols, row) + vol)
        else
            array.set(_svols, row, array.get(_svols, row) + vol)

    // ── 4e. Aggregate: totals, POC, mean ─────────────────────────────────────
    float maxVol    = 0.0
    float totalVol  = 0.0
    float totalBull = 0.0
    float totalBear = 0.0
    int   poc_idx   = 0
    float[] tvols   = array.new_float(i_rows, 0.0)

    for i = 0 to i_rows - 1
        float bv = array.get(_bvols, i)
        float sv = array.get(_svols, i)
        float tv = bv + sv
        array.set(tvols, i, tv)
        totalVol  += tv
        totalBull += bv
        totalBear += sv
        if tv > maxVol
            maxVol  := tv
            poc_idx := i

    float mean_vol = totalVol > 0 ? totalVol / i_rows : 0.0

    // Publish key metrics to var state so the table can read them every bar
    poc_price     := array.get(_lvls, poc_idx) + step * 0.5   // midpoint of POC bin
    prof_bull_pct := totalVol > 0 ? totalBull / totalVol * 100.0 : na

    // ── 4f. Value Area — CME standard: expand from POC, always prefer the
    //        side with the next-highest single row, until VA% target is met ───
    float va_vol = array.get(tvols, poc_idx)
    int   va_hi  = poc_idx
    int   va_lo  = poc_idx
    float target = totalVol * (i_va_pct / 100.0)
    int   safety = 0                     // overflow guard

    while va_vol < target and safety < i_rows * 2
        float up_v   = va_hi < i_rows - 1 ? array.get(tvols, va_hi + 1) : -1.0
        float down_v = va_lo > 0          ? array.get(tvols, va_lo - 1) : -1.0
        if up_v < 0 and down_v < 0
            break
        if up_v >= down_v
            va_hi  += 1
            va_vol += up_v
        else
            va_lo  -= 1
            va_vol += down_v
        safety += 1

    vah_price := array.get(_lvls, va_hi + 1)
    val_price := array.get(_lvls, va_lo)

    // ── 4g. Stacked Imbalance Detection ──────────────────────────────────────
    // Inferred buy/sell delta per row is a proxy (close>open heuristic).
    // Stacking ≥ i_imb_min consecutive rows above i_imb_ratio reveals
    // structural absorption zones that show up reliably on /ES and /NQ.
    // Packed as float triples: [start_row, end_row, direction(+1/-1)]
    float[] imb = array.new_float(0)
    int b_stack = 0
    int s_stack = 0
    int b_start = 0
    int s_start = 0

    for i = 0 to i_rows - 1
        float bv = array.get(_bvols, i)
        float sv = array.get(_svols, i)
        bool bull_imb = sv > 0 and bv / sv >= i_imb_ratio
        bool bear_imb = bv > 0 and sv / bv >= i_imb_ratio

        // Bull stack tracking
        if bull_imb
            if b_stack == 0
                b_start := i
            b_stack += 1
        else
            if b_stack >= i_imb_min
                array.push(imb, float(b_start))
                array.push(imb, float(i - 1))
                array.push(imb, 1.0)
            b_stack := 0

        // Bear stack tracking
        if bear_imb
            if s_stack == 0
                s_start := i
            s_stack += 1
        else
            if s_stack >= i_imb_min
                array.push(imb, float(s_start))
                array.push(imb, float(i - 1))
                array.push(imb, -1.0)
            s_stack := 0

    // Flush trailing stacks at loop end
    if b_stack >= i_imb_min
        array.push(imb, float(b_start))
        array.push(imb, float(i_rows - 1))
        array.push(imb, 1.0)
    if s_stack >= i_imb_min
        array.push(imb, float(s_start))
        array.push(imb, float(i_rows - 1))
        array.push(imb, -1.0)

    // ── 4h. Draw ──────────────────────────────────────────────────────────────
    int   b     = bar_index
    int   lbl_x = b + i_width + 3

    // Subtle profile boundary guide
    box.new(b - lookback, hi, b + i_width, lo,
            border_color = color.new(chart.fg_color, 82),
            border_style = line.style_dotted,
            bgcolor      = color(na))

    // Profile rows — draw order: gaps → bars → imbalances → lines
    for i = 0 to i_rows - 1
        float bv     = array.get(_bvols, i)
        float sv     = array.get(_svols, i)
        float tv     = bv + sv
        float lvl_lo = array.get(_lvls, i)
        float lvl_hi = array.get(_lvls, i + 1)

        if tv == 0.0
            // Zero-volume gap — no traded interest; price will react here
            box.new(b - lookback, lvl_hi, b, lvl_lo, border_color=na, bgcolor=i_col_gap)
            continue

        int norm_v = maxVol > 0 ? int(math.round(tv / maxVol * i_width)) : 0
        if norm_v == 0
            continue

        int norm_bull = bv > 0 ? int(math.round(bv / tv * norm_v)) : 0
        int norm_bear = norm_v - norm_bull
        int lft       = b + i_width - norm_v

        // HVN: fully opaque (institutional interest; acts as magnet/support)
        // LVN: heavily faded (thin air; price tends to accelerate through)
        // Normal: standard opacity
        bool is_hvn = mean_vol > 0 and tv >= mean_vol * 1.5
        bool is_lvn = mean_vol > 0 and tv > 0 and tv <= mean_vol * 0.5

        color bc = is_hvn ? color.new(i_col_bull, 0)  : is_lvn ? color.new(i_col_bull, 70) : i_col_bull
        color sc = is_hvn ? color.new(i_col_bear, 0)  : is_lvn ? color.new(i_col_bear, 70) : i_col_bear

        if norm_bull > 0
            box.new(lft, lvl_hi, lft + norm_bull, lvl_lo,
                    border_color=color.new(chart.fg_color, 96), bgcolor=bc)
        if norm_bear > 0
            box.new(lft + norm_bull, lvl_hi, b + i_width, lvl_lo,
                    border_color=color.new(chart.fg_color, 96), bgcolor=sc)

    // Stacked imbalance overlays
    int zone_count = array.size(imb) / 3
    for z = 0 to zone_count - 1
        int   z0  = int(array.get(imb, z * 3))
        int   z1  = int(array.get(imb, z * 3 + 1))
        float dir = array.get(imb, z * 3 + 2)
        float z_lo = array.get(_lvls, z0)
        float z_hi = array.get(_lvls, z1 + 1)
        color zc  = dir > 0 ? i_col_imb_b : i_col_imb_s
        box.new(b - lookback, z_hi, b, z_lo,
                border_color=color.new(zc, 15), border_width=1, bgcolor=zc)

    // POC line + label
    line.new(b - lookback, poc_price, b + i_width, poc_price,
             color=i_col_poc, width=2, style=line.style_solid)
    label.new(lbl_x, poc_price, "POC  " + str.tostring(poc_price, format.mintick),
              color=color(na), textcolor=i_col_poc,
              style=label.style_label_left, size=size.small)

    // VAH line + label
    line.new(b - lookback, vah_price, b + i_width, vah_price,
             color=i_col_vah, width=1, style=line.style_dashed)
    label.new(lbl_x, vah_price, "VAH  " + str.tostring(vah_price, format.mintick),
              color=color(na), textcolor=i_col_vah,
              style=label.style_label_left, size=size.small)

    // VAL line + label
    line.new(b - lookback, val_price, b + i_width, val_price,
             color=i_col_val, width=1, style=line.style_dashed)
    label.new(lbl_x, val_price, "VAL  " + str.tostring(val_price, format.mintick),
              color=color(na), textcolor=i_col_val,
              style=label.style_label_left, size=size.small)

    // Previous-session naked levels — dotted, faded, clearly distinct
    if not na(prev_poc)
        line.new(b - lookback, prev_poc, b + i_width, prev_poc,
                 color=i_col_ypoc, width=1, style=line.style_dotted)
        label.new(lbl_x, prev_poc, "yPOC " + str.tostring(prev_poc, format.mintick),
                  color=color(na), textcolor=i_col_ypoc,
                  style=label.style_label_left, size=size.tiny)

    if not na(prev_vah) and prev_vah != prev_poc
        line.new(b - lookback, prev_vah, b + i_width, prev_vah,
                 color=color.new(i_col_yprev, 20), width=1, style=line.style_dotted)
        label.new(lbl_x, prev_vah, "yVAH " + str.tostring(prev_vah, format.mintick),
                  color=color(na), textcolor=color.new(i_col_yprev, 30),
                  style=label.style_label_left, size=size.tiny)

    if not na(prev_val) and prev_val != prev_poc
        line.new(b - lookback, prev_val, b + i_width, prev_val,
                 color=color.new(i_col_yprev, 20), width=1, style=line.style_dotted)
        label.new(lbl_x, prev_val, "yVAL " + str.tostring(prev_val, format.mintick),
                  color=color(na), textcolor=color.new(i_col_yprev, 30),
                  style=label.style_label_left, size=size.tiny)

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 5 — INFO TABLE  (created once, updated every bar for live CVD)
// ══════════════════════════════════════════════════════════════════════════════
if i_show_tbl
    tbl_pos = switch i_tbl_pos
        "Top Right"   => position.top_right
        "Top Left"    => position.top_left
        "Bottom Left" => position.bottom_left
        =>               position.bottom_right

    if na(_tbl)
        _tbl := table.new(tbl_pos, 2, 8,
                          bgcolor       = color.new(#0A0A0A, 45),
                          border_color  = color.new(#424242, 50),
                          border_width  = 1,
                          frame_color   = color.new(#424242, 30),
                          frame_width   = 1)

    // Header
    table.cell(_tbl, 0, 0, "VOL PROFILE", text_color=#B0BEC5, text_size=size.tiny,
               bgcolor=color.new(#1565C0, 35), text_halign=text.align_center)
    table.cell(_tbl, 1, 0, timeframe.period + "m",  text_color=#B0BEC5, text_size=size.tiny,
               bgcolor=color.new(#1565C0, 35), text_halign=text.align_center)

    // POC
    table.cell(_tbl, 0, 1, "POC", text_color=i_col_poc, text_size=size.tiny)
    table.cell(_tbl, 1, 1, not na(poc_price) ? str.tostring(poc_price, format.mintick) : "-",
               text_color=i_col_poc, text_size=size.tiny)

    // VAH
    table.cell(_tbl, 0, 2, "VAH", text_color=i_col_vah, text_size=size.tiny)
    table.cell(_tbl, 1, 2, not na(vah_price) ? str.tostring(vah_price, format.mintick) : "-",
               text_color=i_col_vah, text_size=size.tiny)

    // VAL
    table.cell(_tbl, 0, 3, "VAL", text_color=i_col_val, text_size=size.tiny)
    table.cell(_tbl, 1, 3, not na(val_price) ? str.tostring(val_price, format.mintick) : "-",
               text_color=i_col_val, text_size=size.tiny)

    // POC distance in ticks (direction-colored: above = green, below = red)
    float poc_dist  = not na(poc_price) and syminfo.mintick > 0 ?
                      math.abs(close - poc_price) / syminfo.mintick : na
    color dist_col  = not na(poc_dist) ?
                      (close >= poc_price ? i_col_vah : i_col_val) : #9E9E9E
    table.cell(_tbl, 0, 4, "POC dist", text_color=#9E9E9E, text_size=size.tiny)
    table.cell(_tbl, 1, 4, not na(poc_dist) ? str.tostring(int(poc_dist)) + " t" : "-",
               text_color=dist_col, text_size=size.tiny)

    // Cumulative Volume Delta — live, resets on session start
    color cvd_col = session_cvd > 0 ? #00E676 : session_cvd < 0 ? #FF1744 : #9E9E9E
    table.cell(_tbl, 0, 5, "CVD", text_color=#9E9E9E, text_size=size.tiny)
    table.cell(_tbl, 1, 5, str.tostring(int(session_cvd), "#,###"),
               text_color=cvd_col, text_size=size.tiny)

    // Profile balance: bull% of session volume (>55% bull=buyers in control)
    color bal_col = not na(prof_bull_pct) ?
                    (prof_bull_pct > 55 ? #00E676 : prof_bull_pct < 45 ? #FF1744 : #FFD700) :
                    #9E9E9E
    table.cell(_tbl, 0, 6, "Bull vol%", text_color=#9E9E9E, text_size=size.tiny)
    table.cell(_tbl, 1, 6, not na(prof_bull_pct) ?
               str.tostring(prof_bull_pct, "#.0") + "%" : "-",
               text_color=bal_col, text_size=size.tiny)

    // VA position: where is price relative to Value Area (0% = at VAL, 100% = at VAH)
    float va_range = not na(vah_price) and not na(val_price) ? vah_price - val_price : na
    float va_pos   = va_range > 0 ? (close - val_price) / va_range * 100.0 : na
    bool  in_va    = not na(va_pos) and va_pos >= 0 and va_pos <= 100
    color vap_col  = not na(va_pos) ?
                     (va_pos > 75 ? #00E676 : va_pos < 25 ? #FF1744 : #FFD700) : #9E9E9E
    string vap_str = not na(va_pos) ? str.tostring(math.round(va_pos)) + "% " + (in_va ? "IN" : "OUT") : "-"
    table.cell(_tbl, 0, 7, "VA pos", text_color=#9E9E9E, text_size=size.tiny)
    table.cell(_tbl, 1, 7, vap_str, text_color=vap_col, text_size=size.tiny)
