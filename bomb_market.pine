//@version=5
// ═══════════════════════════════════════════════════════════════════════════
//  BOMB MARKET — Reverse-Engineered High-R:R Liquidity Strategy
// ═══════════════════════════════════════════════════════════════════════════
//
//  CORE THESIS
//  Premium "1:15 – 1:50 R:R" systems do not predict better — they enter
//  tighter. The engine is always the same three-step sequence:
//
//    1. LIQUIDITY SWEEP   — price wicks through a swing high/low (stop hunt)
//                           and closes back inside the range.
//    2. DISPLACEMENT      — an impulsive candle away from the sweep, large
//                           relative to ATR, ideally leaving a Fair Value Gap
//                           and shifting short-term structure (CHoCH).
//    3. LIMIT ENTRY       — a resting LIMIT order at the extreme of the
//                           origin zone (Order Block / FVG midpoint). Stop
//                           sits a fraction of ATR beyond the sweep wick.
//
//  Because the entry is at the zone EXTREME and the stop hides just past the
//  hunt wick, the stop distance collapses to a handful of ticks — so a target
//  at the opposing liquidity pool is mechanically 15R–50R away.
//
//  ENTRIES ARE LIMIT ORDERS ONLY. No market orders are ever sent for entry.
//  Unfilled orders expire after N bars or when the setup invalidates.
//
//  Works on 15m / 1H / 4H / 1D — all thresholds are ATR- and pivot-relative,
//  so the logic self-scales across XAUUSD, EURUSD, and equity indices.
//
// ═══════════════════════════════════════════════════════════════════════════
strategy("Bomb Market [Reverse-Engineered]", shorttitle="Bomb Market",
     overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.fixed, default_qty_value=1,
     pyramiding=0,
     calc_on_every_tick=false,
     process_orders_on_close=false,
     commission_type=strategy.commission.percent, commission_value=0.0,
     max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ─────────────────────────────────────────────────────────────── INPUTS ────
grpS  = "1 · Structure & Sweep"
swingLen    = input.int(5,   "Swing pivot length", minval=2, group=grpS,
     tooltip="Bars on each side of a pivot. 15m: 5 · 1H: 5 · 4H: 4 · 1D: 3")
dispWindow  = input.int(8,   "Sweep → displacement window (bars)", minval=1, group=grpS,
     tooltip="Displacement must appear within this many bars of the sweep.")

grpD  = "2 · Displacement"
atrLen      = input.int(14,  "ATR length", minval=1, group=grpD)
dispMult    = input.float(1.2, "Min body size (× ATR)", minval=0.1, step=0.1, group=grpD,
     tooltip="Candle body must exceed ATR × this multiple to count as displacement.")
requireFVG  = input.bool(true,  "Require Fair Value Gap", group=grpD,
     tooltip="Displacement bar must leave a 3-candle imbalance.")
requireShift= input.bool(true,  "Require structure shift (CHoCH proxy)", group=grpD)
shiftLen    = input.int(10,  "Structure-shift lookback", minval=2, group=grpD)

grpE  = "3 · Limit Entry / Exit"
entryMode   = input.string("OB Extreme", "Limit entry level", group=grpE,
     options=["OB Extreme", "OB Midpoint", "FVG Midpoint"],
     tooltip="OB Extreme = deepest price of the origin candle → tightest stop → highest R:R.")
obLookback  = input.int(6,   "Order-block search lookback", minval=1, group=grpE)
slBufAtr    = input.float(0.15, "Stop buffer beyond sweep wick (× ATR)", minval=0.0, step=0.05, group=grpE)
rrTarget    = input.float(15.0, "Risk-to-Reward target (R)", minval=1.0, step=0.5, group=grpE,
     tooltip="Fixed-R target. The 'Bomb' presets: 15 / 25 / 50.")
expiryBars  = input.int(20,  "Cancel unfilled limit after (bars)", minval=1, group=grpE,
     tooltip="15m: 20 · 1H: 15 · 4H: 10 · 1D: 7")
replaceNew  = input.bool(true, "Newer setup replaces pending order", group=grpE)

grpR  = "4 · Risk"
useRiskPct  = input.bool(true,  "Position size by % equity risk", group=grpR)
riskPct     = input.float(0.5, "Risk per trade (% of equity)", minval=0.01, step=0.1, group=grpR,
     tooltip="At 15R–50R targets, win rate is LOW. Keep risk small.")
fixedQty    = input.float(1.0, "Fixed qty (if % risk is off)", minval=0.0, group=grpR)

grpF  = "5 · Filters"
useKZ       = input.bool(false, "Killzone session filter", group=grpF,
     tooltip="Only accept sweeps inside the sessions below. Recommended ON for 15m/1H FX & metals.")
kzTZ        = input.string("UTC", "Killzone timezone", group=grpF)
kz1         = input.session("0700-1000", "Killzone 1 (London)", group=grpF)
kz2         = input.session("1330-1600", "Killzone 2 (New York)", group=grpF)
useBias     = input.bool(false, "Higher-timeframe EMA bias filter", group=grpF,
     tooltip="Longs only above the HTF EMA, shorts only below.")
biasTF      = input.timeframe("D", "Bias timeframe", group=grpF)
biasLen     = input.int(50, "Bias EMA length", minval=1, group=grpF)

grpV  = "6 · Visuals"
showZones   = input.bool(true, "Draw OB / FVG zones", group=grpV)
showLines   = input.bool(true, "Draw entry / SL / TP lines", group=grpV)
showStats   = input.bool(true, "Show performance panel", group=grpV)

// ──────────────────────────────────────────────────────────── UTILITIES ────
atr = ta.atr(atrLen)

inKZ = not useKZ or not na(time(timeframe.period, kz1, kzTZ)) or not na(time(timeframe.period, kz2, kzTZ))

htfEma = request.security(syminfo.tickerid, biasTF, ta.ema(close, biasLen)[1],
     lookahead=barmerge.lookahead_on)
biasLongOK  = not useBias or close > htfEma
biasShortOK = not useBias or close < htfEma

// Last bullish / bearish candle before the displacement = the Order Block.
f_lastBullOB(int lookback) =>
    float top = na, float bot = na, int idx = na
    for i = 1 to lookback
        if close[i] > open[i]
            top := high[i], bot := low[i], idx := i
            break
    [top, bot, idx]

f_lastBearOB(int lookback) =>
    float top = na, float bot = na, int idx = na
    for i = 1 to lookback
        if close[i] < open[i]
            top := high[i], bot := low[i], idx := i
            break
    [top, bot, idx]

// ─────────────────────────────────────────── 1 · SWING / SWEEP TRACKING ────
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)

var float lastPH = na
var float lastPL = na
if not na(ph)
    lastPH := ph
if not na(pl)
    lastPL := pl

// A confirmed CLOSE through the level is a breakout, not a hunt — retire it.
if not na(lastPH) and close > lastPH
    lastPH := na
if not na(lastPL) and close < lastPL
    lastPL := na

// Sweep = wick through the pivot, close back inside.
sweptHigh = not na(lastPH) and high > lastPH and close < lastPH and inKZ
sweptLow  = not na(lastPL) and low  < lastPL and close > lastPL and inKZ

// Hunt state: after a sweep we have `dispWindow` bars to see displacement.
var int   shortHunt = 0
var int   longHunt  = 0
var float shortExtreme = na   // highest wick of the hunt (SL anchor for shorts)
var float longExtreme  = na   // lowest  wick of the hunt (SL anchor for longs)

if sweptHigh
    shortHunt := dispWindow, shortExtreme := high, lastPH := na
else if shortHunt > 0
    shortHunt := shortHunt - 1, shortExtreme := math.max(shortExtreme, high)

if sweptLow
    longHunt := dispWindow, longExtreme := low, lastPL := na
else if longHunt > 0
    longHunt := longHunt - 1, longExtreme := math.min(longExtreme, low)

if sweptHigh
    label.new(bar_index, high, "💣 SSL raid", style=label.style_label_down,
         color=color.new(color.red, 20), textcolor=color.white, size=size.tiny)
if sweptLow
    label.new(bar_index, low, "💣 BSL raid", style=label.style_label_up,
         color=color.new(color.teal, 20), textcolor=color.white, size=size.tiny)

// ───────────────────────────────────────────────── 2 · DISPLACEMENT ────────
body     = math.abs(close - open)
bigBody  = body >= dispMult * atr

bearFVG  = high < low[2]                       // 3-candle gap down
bullFVG  = low  > high[2]                      // 3-candle gap up

bearShift = close < ta.lowest(low, shiftLen)[1]
bullShift = close > ta.highest(high, shiftLen)[1]

dispShort = shortHunt > 0 and close < open and bigBody and
     (not requireFVG or bearFVG) and (not requireShift or bearShift) and biasShortOK
dispLong  = longHunt > 0 and close > open and bigBody and
     (not requireFVG or bullFVG) and (not requireShift or bullShift) and biasLongOK

// ─────────────────────────────────── 3 · BUILD & PLACE THE LIMIT ORDER ─────
var int   pendDir   = 0                        // 0 = none · 1 = long · -1 = short
var float pendEntry = na
var float pendSL    = na
var float pendTP    = na
var int   pendBar   = na

f_qty(float entryPx, float slPx) =>
    if useRiskPct
        riskCash    = strategy.equity * riskPct / 100.0
        perUnitLoss = math.abs(entryPx - slPx) * syminfo.pointvalue
        perUnitLoss > 0 ? riskCash / perUnitLoss : 0.0
    else
        fixedQty

f_drawSetup(float entryPx, float slPx, float tpPx, float obT, float obB, int obIdx, bool isLong) =>
    if showZones and not na(obT)
        box.new(bar_index - obIdx, obT, bar_index + expiryBars, obB,
             bgcolor=color.new(isLong ? color.teal : color.red, 82),
             border_color=color.new(isLong ? color.teal : color.red, 40))
    if showLines
        line.new(bar_index, entryPx, bar_index + expiryBars, entryPx, color=color.blue,  width=2)
        line.new(bar_index, slPx,    bar_index + expiryBars, slPx,    color=color.red,   width=1)
        line.new(bar_index, tpPx,    bar_index + expiryBars, tpPx,    color=color.green, width=1)
        label.new(bar_index + expiryBars, entryPx,
             str.tostring(rrTarget, "#.#") + "R limit", style=label.style_label_left,
             color=color.new(color.blue, 30), textcolor=color.white, size=size.tiny)

// ---- SHORT setup ----
if dispShort and (strategy.position_size == 0) and (pendDir == 0 or replaceNew)
    [obT, obB, obIdx] = f_lastBullOB(obLookback)
    float fvgMid = bearFVG ? (low[2] + high) / 2.0 : na
    float entryPx = switch entryMode
        "OB Extreme"   => obT
        "OB Midpoint"  => not na(obT) ? (obT + obB) / 2.0 : na
        "FVG Midpoint" => not na(fvgMid) ? fvgMid : not na(obT) ? (obT + obB) / 2.0 : na
    float slPx = shortExtreme + slBufAtr * atr
    // Limit sell must rest ABOVE market and BELOW the stop.
    if not na(entryPx) and entryPx > close and entryPx < slPx
        risk = slPx - entryPx
        tpPx = entryPx - rrTarget * risk
        qty  = f_qty(entryPx, slPx)
        if qty > 0
            strategy.cancel("BM Long")
            strategy.cancel("BM Short")
            strategy.entry("BM Short", strategy.short, qty=qty, limit=entryPx)
            strategy.exit("BM Short X", from_entry="BM Short", stop=slPx, limit=tpPx)
            pendDir := -1, pendEntry := entryPx, pendSL := slPx, pendTP := tpPx, pendBar := bar_index
            shortHunt := 0
            f_drawSetup(entryPx, slPx, tpPx, obT, obB, obIdx, false)
            alert("BOMB MARKET SHORT | " + syminfo.ticker +
                 " | limit=" + str.tostring(entryPx) +
                 " | sl="    + str.tostring(slPx) +
                 " | tp="    + str.tostring(tpPx) +
                 " | rr="    + str.tostring(rrTarget), alert.freq_once_per_bar_close)

// ---- LONG setup ----
if dispLong and (strategy.position_size == 0) and (pendDir == 0 or replaceNew)
    [obT, obB, obIdx] = f_lastBearOB(obLookback)
    float fvgMid = bullFVG ? (high[2] + low) / 2.0 : na
    float entryPx = switch entryMode
        "OB Extreme"   => obB
        "OB Midpoint"  => not na(obT) ? (obT + obB) / 2.0 : na
        "FVG Midpoint" => not na(fvgMid) ? fvgMid : not na(obT) ? (obT + obB) / 2.0 : na
    float slPx = longExtreme - slBufAtr * atr
    // Limit buy must rest BELOW market and ABOVE the stop.
    if not na(entryPx) and entryPx < close and entryPx > slPx
        risk = entryPx - slPx
        tpPx = entryPx + rrTarget * risk
        qty  = f_qty(entryPx, slPx)
        if qty > 0
            strategy.cancel("BM Long")
            strategy.cancel("BM Short")
            strategy.entry("BM Long", strategy.long, qty=qty, limit=entryPx)
            strategy.exit("BM Long X", from_entry="BM Long", stop=slPx, limit=tpPx)
            pendDir := 1, pendEntry := entryPx, pendSL := slPx, pendTP := tpPx, pendBar := bar_index
            longHunt := 0
            f_drawSetup(entryPx, slPx, tpPx, obT, obB, obIdx, true)
            alert("BOMB MARKET LONG | " + syminfo.ticker +
                 " | limit=" + str.tostring(entryPx) +
                 " | sl="    + str.tostring(slPx) +
                 " | tp="    + str.tostring(tpPx) +
                 " | rr="    + str.tostring(rrTarget), alert.freq_once_per_bar_close)

// ─────────────────────────────── PENDING-ORDER LIFECYCLE (limit only) ──────
filled = strategy.position_size != 0
if filled
    pendDir := 0

if pendDir != 0 and not filled
    expired      = bar_index - pendBar >= expiryBars
    // Setup death: price closed through the stop zone before filling us,
    // or ran to target without us — stand down either way.
    blownShort   = pendDir == -1 and (close > pendSL or low  <= pendTP)
    blownLong    = pendDir ==  1 and (close < pendSL or high >= pendTP)
    if expired or blownShort or blownLong
        strategy.cancel("BM Short")
        strategy.cancel("BM Long")
        pendDir := 0
        label.new(bar_index, close, "✕ cancelled", style=label.style_label_left,
             color=color.new(color.gray, 40), textcolor=color.white, size=size.tiny)

// ───────────────────────────────────────────────── PERFORMANCE PANEL ───────
var table stats = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 20),
     border_color=color.new(color.gray, 60), border_width=1)
if showStats and barstate.islast
    wins   = strategy.wintrades
    losses = strategy.losstrades
    total  = strategy.closedtrades
    winPct = total > 0 ? 100.0 * wins / total : 0.0
    avgW   = wins   > 0 ? strategy.grossprofit / wins  : 0.0
    avgL   = losses > 0 ? strategy.grossloss  / losses : 0.0
    rlzRR  = avgL > 0 ? avgW / avgL : 0.0
    txt(c, r, s, hl) =>
        table.cell(stats, c, r, s, text_color=hl ? color.yellow : color.white, text_size=size.small)
    txt(0, 0, "💣 BOMB MARKET", true),            txt(1, 0, str.tostring(rrTarget, "#.#") + "R target", true)
    txt(0, 1, "Trades", false),                   txt(1, 1, str.tostring(total), false)
    txt(0, 2, "Win rate", false),                 txt(1, 2, str.tostring(winPct, "#.#") + "%", false)
    txt(0, 3, "Realized R:R", false),             txt(1, 3, "1 : " + str.tostring(rlzRR, "#.#"), false)
    txt(0, 4, "Net profit", false),               txt(1, 4, str.tostring(strategy.netprofit, "#.##"), false)
    txt(0, 5, "Max drawdown", false),             txt(1, 5, str.tostring(strategy.max_drawdown, "#.##"), false)

plot(useBias ? htfEma : na, "HTF bias EMA", color=color.new(color.orange, 40), linewidth=2)
